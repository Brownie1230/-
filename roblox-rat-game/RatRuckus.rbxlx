<Item class="ServerScriptService" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">GameManager</string><ProtectedString name="Source"><![CDATA[-- GameManager (Script) — ServerScriptService
-- Главный скрипт: лобби, отсчёт, раунды, роли, награды, голод, сыр, норки, писк, победа.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

Players.CharacterAutoLoads = false -- персонажей создаём сами (крыса или человек)
local streamingOn = false
pcall(function()
	streamingOn = workspace.StreamingEnabled
end)
if streamingOn then
	warn("[Rat Ruckus] В Workspace включён StreamingEnabled. Лучше выключить: Workspace → Properties → StreamingEnabled ☐")
end
StarterPlayer.EnableMouseLockOption = false -- Shift нужен для бега

-- ===== Сетевые события (до загрузки модулей!) =====
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function makeRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local notifyEvent = makeRemote("Notify")
local volunteerEvent = makeRemote("ChefVolunteer")
local fxEvent = makeRemote("FX")
local squeakEvent = makeRemote("Squeak")
local languageEvent = makeRemote("SetLanguage")
local abilityEvent = makeRemote("Ability")
local voteEvent = makeRemote("VoteMap")
makeRemote("RedeemCode")
makeRemote("SetPendingItem")
makeRemote("Emote")
makeRemote("ShopAction")
makeRemote("MiniGame")

-- Понятная ошибка, если какого-то скрипта не хватает или он назван неправильно
local function needModule(name)
	local m = script.Parent:WaitForChild(name, 8)
	if not m then
		error(("❌ НЕ НАЙДЕН скрипт «%s» в ServerScriptService! Проверь, что он есть, это ModuleScript и имя написано точно так: %s"):format(name, name))
	end
	if not m:IsA("ModuleScript") then
		error(("❌ «%s» должен быть ModuleScript (фиолетовая иконка), а сейчас это %s. Удали его и создай заново как ModuleScript."):format(name, m.ClassName))
	end
	return require(m)
end
local RatBuilder = needModule("RatBuilder")
local DataService = needModule("DataService")
local SabotageService = needModule("SabotageService")
local ChefService = needModule("ChefService")
local ChefAI = needModule("ChefAI")
local TestMapBuilder = needModule("TestMapBuilder")
local MonetizationService = needModule("MonetizationService")
local PetService = needModule("PetService")
local ExtrasService = needModule("ExtrasService")
print("✅ Все скрипты найдены, игра запускается! Версия " .. tostring(Config.Version))

-- Общее состояние игры видно всем игрокам через атрибуты
ReplicatedStorage:SetAttribute("State", "Lobby")
ReplicatedStorage:SetAttribute("TimeLeft", 0)
ReplicatedStorage:SetAttribute("Chaos", 0)

-- Нет своей карты? Построим ресторан и пиццерию
if not workspace:FindFirstChild("Map") then
	TestMapBuilder.build()
end

-- Какие карты есть (для голосования)
local function availableMaps()
	local list = {}
	for _, m in ipairs(Config.Maps) do
		if workspace:FindFirstChild(m.Folder) then
			table.insert(list, m)
		end
	end
	return list
end
do
	local ids = {}
	for _, m in ipairs(availableMaps()) do
		table.insert(ids, m.Id)
	end
	ReplicatedStorage:SetAttribute("MapList", table.concat(ids, ","))
	local first = availableMaps()[1]
	ReplicatedStorage:SetAttribute("ActiveMap", first and first.Folder or "Map")
	ReplicatedStorage:SetAttribute("ActiveMapId", first and first.Id or "")
end

local state = "Lobby"
local winner, winReason = nil, nil
local alarmOn = false
local roundCoins = {}
local lastSqueak = {}
local goldenCheese = nil
local nextGolden = 0
local currentEvent = nil
local lastAbility = {}
local votes = {}

local function setState(s)
	state = s
	ReplicatedStorage:SetAttribute("State", s)
end

-- Сообщение каждому игроку на его языке (ключ из Locale + аргументы)
local function notifyPlayer(player, kind, key, ...)
	notifyEvent:FireClient(player, Locale.forPlayer(player, key, ...), kind or "info")
end

local function notifyAll(kind, key, ...)
	for _, p in ipairs(Players:GetPlayers()) do
		notifyPlayer(p, kind, key, ...)
	end
end

local function fxAll(kind, a, b)
	fxEvent:FireAllClients(kind, a, b)
end

local function getRoot(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function getSpawn(tag)
	local list
	if tag == "LobbySpawn" then
		list = CollectionService:GetTagged(tag)
	else
		list = Config.taggedInMap(tag) -- только на карте этого раунда
	end
	if #list == 0 then
		return nil
	end
	return list[math.random(#list)]
end

local function spawnPoint(tag)
	local s = getSpawn(tag)
	if not s then
		warn("[GameManager] Нет детали с тегом", tag)
		return CFrame.new(0, 10, 0)
	end
	return CFrame.new(s.Position + Vector3.new(math.random(-20, 20) / 10, 3, math.random(-20, 20) / 10))
end

local function ratsList()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Role") == "Rat" then
			table.insert(list, p)
		end
	end
	return list
end

local function inRound()
	return state == "Intro" or state == "Playing"
end

-- ===== Скорость: одна функция для всех случаев =====
local function refreshSpeed(player)
	local role = player:GetAttribute("Role")
	local speed = 16
	if state == "Intro" and role ~= "Lobby" then
		speed = 0
	elseif role == "Rat" then
		if player:GetAttribute("Caught") or player:GetAttribute("Stunned") then
			speed = 0
		elseif (player:GetAttribute("Hunger") or Config.HungerMax) <= 0 then
			speed = Config.HungryWalkSpeed
		else
			speed = Config.RatWalkSpeed
		end
		local cls = DataService.getClass(player)
		speed = speed * (cls.SpeedMult or 1)
		if player:GetAttribute("Dashing") then
			speed = speed * Config.DashMultiplier
		end
	elseif role == "Chef" then
		speed = Config.ChefWalkSpeed
		if alarmOn then
			speed = speed + Config.ChefRageBonus
		end
	end
	if currentEvent == "Turbo" and (role == "Rat" or role == "Chef") then
		speed = speed * Config.TurboMult
	end
	player:SetAttribute("BaseSpeed", speed)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = speed
	end
end

-- задания дня, которые засчитываются за награды
local QUEST_KIND = { Sabotage = "Sabotage", Rescue = "Rescue", Catch = "Catch", Repair = "Repair", Golden = "Golden", Participation = "Play", RatWin = "Win", ChefWin = "Win" }

-- во сколько раз больше сыра: пропуски + питомец + друг на сервере
local function cheeseFactor(player)
	local f = MonetizationService.coinMultiplier(player) + PetService.bonus(player)
	if player:GetAttribute("FriendBonus") then
		f = f + Config.FriendBonus
	end
	return f
end

local function reward(player, kind)
	local amount = Config.Rewards[kind] or 0
	if amount <= 0 or not player.Parent then
		return
	end
	local mult = cheeseFactor(player)
	amount = math.floor(amount * mult + 0.5)
	DataService.addCoins(player, amount)
	roundCoins[player] = (roundCoins[player] or 0) + amount
	local label = Locale.forPlayer(player, "reward_" .. kind)
	if mult > 1 then
		label = label .. " (×" .. mult .. ")"
	end
	fxEvent:FireClient(player, "coins", amount, label)
	DataService.addXP(player, Config.XP[kind])
	ExtrasService.progress(player, QUEST_KIND[kind])
end

local function endRound(who, reason)
	if state ~= "Playing" or winner then
		return
	end
	winner, winReason = who, reason
end

local function addChaos(amount)
	if state ~= "Playing" then
		return
	end
	if currentEvent == "ChaosNight" and amount > 0 then
		amount = amount * Config.ChaosNightMult
	end
	local chaos = math.clamp((ReplicatedStorage:GetAttribute("Chaos") or 0) + amount, 0, Config.ChaosToWin)
	ReplicatedStorage:SetAttribute("Chaos", chaos)
	if chaos >= Config.AlarmChaos and not alarmOn then
		alarmOn = true
		notifyAll("banner", "alarm")
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("Role") == "Chef" then
				refreshSpeed(p)
			end
		end
	end
	if chaos >= Config.ChaosToWin then
		endRound("Rats", "reason_chaos")
	end
end

local function checkAllCaught()
	local rats = ratsList()
	if #rats == 0 then
		return
	end
	for _, r in ipairs(rats) do
		if not r:GetAttribute("Caught") or r:GetAttribute("LuckPending") then
			return -- 🍀 у кого-то сработает «Второй шанс», ждём
		end
	end
	endRound("Chef", "reason_caught")
end

local function refreshHat(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local role = player:GetAttribute("Role")
	local hatId = DataService.getHat(player)
	if role == "Rat" then
		RatBuilder.attachHat(character, head, hatId, 0.8, CFrame.new(0, 0.42, 0.05))
	elseif role ~= "Chef" then
		RatBuilder.attachHat(character, head, hatId, 1.15, CFrame.new(0, head.Size.Y / 2, 0))
	end
	if role ~= "Chef" then
		RatBuilder.attachTrail(character, DataService.getTrail(player))
	end
end

local function fxPlayer(player, kind, a, b)
	fxEvent:FireClient(player, kind, a, b)
end

-- 🍀 пропуск «Второй шанс»: первый раз за раунд клетка открывается сама
local function trySecondChance(player)
	if not MonetizationService.hasPass(player, "SecondChance") or player:GetAttribute("LuckUsed") then
		return
	end
	player:SetAttribute("LuckUsed", true)
	player:SetAttribute("LuckPending", true)
	notifyPlayer(player, "good", "luck_soon", Config.SecondChanceDelay)
	task.delay(Config.SecondChanceDelay, function()
		player:SetAttribute("LuckPending", nil)
		if state == "Playing" and player.Parent and player:GetAttribute("Role") == "Rat" and player:GetAttribute("Caught") then
			ChefService.release(player)
			local root = getRoot(player.Character)
			if root then
				fxAll("rescue", root.Position)
			end
			notifyAll("good", "luck_done", player.DisplayName)
		elseif state == "Playing" then
			checkAllCaught()
		end
	end)
end

local ctx = {
	fxPlayer = fxPlayer,
	notifyAll = notifyAll,
	notifyPlayer = notifyPlayer,
	fxAll = fxAll,
	getSpawn = getSpawn,
	addChaos = addChaos,
	checkAllCaught = checkAllCaught,
	refreshSpeed = refreshSpeed,
	refreshHat = refreshHat,
	reward = reward,
	isPlaying = function()
		return state == "Playing"
	end,
	alertNoise = function(position, range)
		ChefAI.alert(position, range)
	end,
	onCaught = function(player)
		SabotageService.cancelFor(player)
		trySecondChance(player)
	end,
	refreshClass = function(player)
		refreshSpeed(player)
	end,
	refreshPet = function(player)
		PetService.refresh(player)
	end,
	canEscape = function(player)
		return state == "Playing" and player:GetAttribute("Role") == "Rat" and player:GetAttribute("Caught") == true
	end,
	escape = function(player)
		ChefService.release(player)
		local root = getRoot(player.Character)
		if root then
			fxAll("rescue", root.Position)
		end
		notifyAll("good", "escape_done", player.DisplayName)
	end,
}
DataService.init(ctx)
MonetizationService.init(ctx, DataService)
PetService.init(DataService)
ExtrasService.init(ctx, DataService)
SabotageService.init(ctx)
ChefService.init(ctx)
ChefAI.init(ctx, SabotageService, ChefService)

-- ===== Появление персонажей =====
local spawnPlayer

local function watchDeath(player, character)
	local hum = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not hum then
		return
	end
	hum.Died:Connect(function()
		task.wait(Config.RespawnTime)
		if player.Parent and player.Character == character then
			spawnPlayer(player)
		end
	end)
end

-- 📡 Если в Workspace включён StreamingEnabled, сначала просим Roblox загрузить
-- место появления у игрока, иначе на телефоне крыса может «потеряться» (камера остаётся в лобби)
local function streamAround(player, position)
	pcall(function()
		player:RequestStreamAroundAsync(position, 2)
	end)
end

local spawnToken = {}
spawnPlayer = function(player)
	local role = player:GetAttribute("Role") or "Lobby"
	local spawnTag = "LobbySpawn"
	if role == "Rat" then
		spawnTag = "RatSpawn"
	elseif role == "Chef" then
		spawnTag = "ChefSpawn"
	end
	local target = spawnPoint(spawnTag)
	local token = (spawnToken[player] or 0) + 1
	spawnToken[player] = token
	streamAround(player, target.Position)
	if not player.Parent or spawnToken[player] ~= token then
		return -- игрок вышел или его уже появляют заново
	end
	if player.Character then
		player.Character:Destroy()
	end

	if role == "Rat" then
		player:SetAttribute("Caught", false)
		player:SetAttribute("Stunned", false)
		player:SetAttribute("Dashing", false)
		player:SetAttribute("Armored", false)
		player:SetAttribute("Invisible", false)
		player:SetAttribute("Hunger", Config.HungerMax)
		local rat = RatBuilder.build(player, target)
		pcall(function()
			rat.ModelStreamingMode = Enum.ModelStreamingMode.Persistent -- крыса всегда видна всем
		end)
		player.Character = rat
		rat.Parent = workspace
		rat.HumanoidRootPart:SetNetworkOwner(player)
		refreshSpeed(player)
		PetService.refresh(player)
		watchDeath(player, rat)
	else
		player:LoadCharacter()
		local character = player.Character
		if not character then
			return
		end
		character:PivotTo(target)
		character:WaitForChild("Humanoid")
		if role == "Chef" then
			ChefService.dressChef(character)
			ChefService.giveTool(player)
			ChefService.giveTrapTool(player)
			if currentEvent == "GiantChef" then
				pcall(function()
					character:ScaleTo(Config.GiantScale)
				end)
			end
		else
			character:WaitForChild("Head", 5)
			refreshHat(player)
		end
		refreshSpeed(player)
		PetService.refresh(player)
		watchDeath(player, character)
	end
end

-- ===== Голод, сыр, норки, писк =====
local function hungerTick()
	for _, p in ipairs(ratsList()) do
		if not p:GetAttribute("Caught") then
			local hunger = math.max(0, (p:GetAttribute("Hunger") or Config.HungerMax) - Config.HungerDrain)
			p:SetAttribute("Hunger", hunger)
			refreshSpeed(p)
		end
	end
end

local function setupCrumb(crumb)
	crumb.Touched:Connect(function(hit)
		if crumb:GetAttribute("Eaten") then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or player:GetAttribute("Role") ~= "Rat" then
			return
		end
		crumb:SetAttribute("Eaten", true)
		crumb.Transparency = 1
		local hunger = math.min(Config.HungerMax, (player:GetAttribute("Hunger") or 0) + Config.CrumbFood)
		player:SetAttribute("Hunger", hunger)
		refreshSpeed(player)
		fxEvent:FireClient(player, "eat", crumb.Position)
		ExtrasService.progress(player, "Eat")
		task.delay(Config.CrumbRespawn, function()
			crumb:SetAttribute("Eaten", false)
			crumb.Transparency = 0
		end)
	end)
end

local holeCooldown = {}
local function setupHole(hole)
	hole.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = Players:GetPlayerFromCharacter(character)
		if not player or player:GetAttribute("Role") ~= "Rat" or player:GetAttribute("Caught") then
			return
		end
		if (holeCooldown[player] or 0) > os.clock() then
			return
		end
		local pair = hole:GetAttribute("Pair")
		for _, other in ipairs(CollectionService:GetTagged("RatHole")) do
			if other ~= hole and other:GetAttribute("Pair") == pair then
				holeCooldown[player] = os.clock() + Config.HoleCooldown
				character:PivotTo(other.CFrame * CFrame.new(0, 0.3, -2.5))
				fxEvent:FireClient(player, "hole", other.Position)
				return
			end
		end
	end)
end

local function forEachTagged(tag, fn)
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		fn(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(fn)
end
forEachTagged("Crumb", setupCrumb)
forEachTagged("RatHole", setupHole)

squeakEvent.OnServerEvent:Connect(function(player)
	if player:GetAttribute("Role") ~= "Rat" or not inRound() then
		return
	end
	if (lastSqueak[player] or 0) + Config.SqueakCooldown > os.clock() then
		return
	end
	lastSqueak[player] = os.clock()
	local root = getRoot(player.Character)
	if root then
		fxAll("squeak", player.Character)
		ChefAI.alert(root.Position, 45)
	end
end)

-- ===== Способности классов (клавиша F) =====
local ABILITY_FLAG = { Dash = "Dashing", Armor = "Armored", Invisible = "Invisible" }
abilityEvent.OnServerEvent:Connect(function(player)
	if state ~= "Playing" or player:GetAttribute("Role") ~= "Rat" or player:GetAttribute("Caught") then
		return
	end
	local cls = DataService.getClass(player)
	local flag = cls.Ability and ABILITY_FLAG[cls.Ability]
	if not flag then
		return
	end
	local now = os.clock()
	if (lastAbility[player] or -1000) + cls.Cooldown > now then
		return
	end
	lastAbility[player] = now
	local character = player.Character
	player:SetAttribute(flag, true)
	player:SetAttribute("AbilityUses", (player:GetAttribute("AbilityUses") or 0) + 1)
	if cls.Ability == "Invisible" then
		RatBuilder.setInvisible(character, true)
	end
	refreshSpeed(player)
	if character then
		fxAll("ability", character, cls.Ability)
	end
	notifyPlayer(player, "good", "ability_" .. cls.Ability)
	ExtrasService.progress(player, "Ability")
	task.delay(cls.Duration, function()
		if not player.Parent then
			return
		end
		player:SetAttribute(flag, false)
		if cls.Ability == "Invisible" and player.Character == character then
			RatBuilder.setInvisible(character, false)
		end
		refreshSpeed(player)
	end)
end)

-- ===== Голосование за карту =====
local function publishVotes()
	local counts = {}
	for _, m in ipairs(availableMaps()) do
		counts[m.Id] = 0
	end
	for p, id in pairs(votes) do
		if p.Parent and counts[id] then
			counts[id] = counts[id] + 1
		end
	end
	for id, c in pairs(counts) do
		ReplicatedStorage:SetAttribute("Votes_" .. id, c)
	end
end
publishVotes()

voteEvent.OnServerEvent:Connect(function(player, mapId)
	if state ~= "Lobby" or type(mapId) ~= "string" then
		return
	end
	for _, m in ipairs(availableMaps()) do
		if m.Id == mapId then
			votes[player] = mapId
			player:SetAttribute("Vote", mapId)
			publishVotes()
			return
		end
	end
end)

local function chooseMap()
	local maps = availableMaps()
	if #maps == 0 then
		return
	end
	local counts = {}
	for p, id in pairs(votes) do
		if p.Parent then
			counts[id] = (counts[id] or 0) + 1
		end
	end
	local best, bestCount = {}, -1
	for _, m in ipairs(maps) do
		local c = counts[m.Id] or 0
		if c > bestCount then
			best, bestCount = { m }, c
		elseif c == bestCount then
			table.insert(best, m)
		end
	end
	local chosen = best[math.random(#best)]
	ReplicatedStorage:SetAttribute("ActiveMap", chosen.Folder)
	ReplicatedStorage:SetAttribute("ActiveMapId", chosen.Id)
	votes = {}
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("Vote", nil)
	end
	publishVotes()
	return chosen
end

-- ===== Случайное событие раунда =====
local function pickEvent()
	local forced = ReplicatedStorage:GetAttribute("ForceEvent") -- для проверки: поставь атрибут вручную
	if forced == "none" then
		currentEvent = nil
	elseif type(forced) == "string" and forced ~= "" then
		currentEvent = forced
	elseif math.random() < Config.EventChance then
		currentEvent = Config.Events[math.random(#Config.Events)]
	else
		currentEvent = nil
	end
	ReplicatedStorage:SetAttribute("Event", currentEvent or "")
end

-- ===== Игроки =====
volunteerEvent.OnServerEvent:Connect(function(player, wants)
	player:SetAttribute("WantsChef", wants == true)
end)

languageEvent.OnServerEvent:Connect(function(player, lang)
	if lang == "ru" or lang == "en" then
		player:SetAttribute("Lang", lang)
	end
end)

local function onPlayerAdded(player)
	if inRound() then
		player:SetAttribute("Role", "Rat")
	else
		player:SetAttribute("Role", "Lobby")
	end
	player:SetAttribute("Score", 0)
	local bonus, streak = DataService.load(player)
	if player.Parent then
		MonetizationService.load(player)
		ExtrasService.onJoin(player)
	end
	if not player.Parent then
		return
	end
	if inRound() then
		notifyAll("info", "join_rats", player.DisplayName)
	end
	spawnPlayer(player)
	if bonus and bonus > 0 then
		notifyPlayer(player, "good", "daily", bonus, streak)
		fxPlayer(player, "coins", bonus, "🎁")
	end
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	spawnToken[player] = nil
	holeCooldown[player] = nil
	lastSqueak[player] = nil
	roundCoins[player] = nil
	ChefService.forget(player)
	SabotageService.forget(player)
	MonetizationService.forget(player)
	lastAbility[player] = nil
	votes[player] = nil
	PetService.forget(player)
	ExtrasService.onLeave(player)
	publishVotes()
	task.delay(0.5, function()
		if state == "Playing" then
			checkAllCaught()
		end
	end)
end)

local function assignRoles()
	local players = Players:GetPlayers()
	local chef = nil
	if #players >= Config.HumanChefMinPlayers then
		local volunteers, paid, passVolunteers = {}, {}, {}
		for _, p in ipairs(players) do
			if DataService.isChefNext(p) then
				table.insert(paid, p)
			elseif p:GetAttribute("WantsChef") then
				table.insert(volunteers, p)
				if MonetizationService.hasPass(p, "ChefPass") then
					table.insert(passVolunteers, p) -- 🍳 пропуск повара: выбирают первым
				end
			end
		end
		local pool = players
		if #paid > 0 then
			pool = paid
		elseif #passVolunteers > 0 then
			pool = passVolunteers
		elseif #volunteers > 0 then
			pool = volunteers
		end
		chef = pool[math.random(#pool)]
		DataService.clearChefNext(chef)
	end
	for _, p in ipairs(players) do
		if p == chef then
			p:SetAttribute("Role", "Chef")
		else
			p:SetAttribute("Role", "Rat")
		end
		p:SetAttribute("Score", 0)
		p:SetAttribute("LuckUsed", nil) -- 🍀 «Второй шанс» снова доступен
		p:SetAttribute("LuckPending", nil)
	end
	return chef
end

local function everyoneToLobby()
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("Role", "Lobby")
		p:SetAttribute("Caught", false)
		p:SetAttribute("Stunned", false)
		task.spawn(spawnPlayer, p)
	end
end

local function giveResults()
	local ratsWon = winner == "Rats"
	local best, bestScore = nil, 0
	for _, p in ipairs(Players:GetPlayers()) do
		local s = p:GetAttribute("Score") or 0
		if s > bestScore and p:GetAttribute("Role") ~= "Lobby" then
			best, bestScore = p, s
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local role = p:GetAttribute("Role")
		if role == "Rat" or role == "Chef" then
			local won = (role == "Rat" and ratsWon) or (role == "Chef" and not ratsWon)
			reward(p, "Participation")
			DataService.markTutorial(p)
			if won then
				if role == "Rat" then
					reward(p, "RatWin")
				else
					reward(p, "ChefWin")
				end
				DataService.addWin(p)
			end
			local mvpName = ""
			if best then
				mvpName = best.DisplayName
			end
			fxEvent:FireClient(p, "results", {
				winner = winner,
				reason = Locale.forPlayer(p, winReason),
				won = won,
				mvp = mvpName,
				mvpScore = bestScore,
				coins = roundCoins[p] or 0,
			})
		end
	end
end

-- ===== Золотой сыр: редкий бонус, появляется в труднодоступных местах =====
local function removeGolden()
	if goldenCheese then
		goldenCheese:Destroy()
		goldenCheese = nil
	end
end

local function spawnGolden()
	removeGolden()
	local spot = getSpawn("GoldenSpot")
	if not spot then
		return
	end
	local p = Instance.new("Part")
	p.Name = "GoldenCheese"
	p.Size = Vector3.new(1.3, 0.9, 1.3)
	p.CFrame = CFrame.new(spot.Position)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 200, 40)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 80)
	light.Range = 14
	light.Brightness = 2
	light.Parent = p
	local sp = Instance.new("Sparkles")
	sp.SparkleColor = Color3.fromRGB(255, 230, 120)
	sp.Parent = p
	p:AddTag("GoldenCheese")
	p.Parent = workspace
	goldenCheese = p
	local taken = false
	p.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if taken or not player or player:GetAttribute("Role") ~= "Rat" or player:GetAttribute("Caught") or state ~= "Playing" then
			return
		end
		taken = true
		local pos = p.Position
		removeGolden()
		player:SetAttribute("Hunger", Config.HungerMax)
		refreshSpeed(player)
		reward(player, "Golden")
		fxAll("rescue", pos)
		notifyAll("good", "golden_found", player.DisplayName, Config.Rewards.Golden * MonetizationService.coinMultiplier(player))
	end)
	notifyAll("banner", "golden_spawn")
	task.delay(Config.GoldenCheeseLifetime, function()
		if goldenCheese == p then
			removeGolden()
		end
	end)
end

-- ===== 🪂 Упал с карты? Возвращаем назад =====
task.spawn(function()
	while true do
		task.wait(1)
		for _, p in ipairs(Players:GetPlayers()) do
			local root = getRoot(p.Character)
			if root and root.Position.Y < Config.FallRescueY then
				local role = p:GetAttribute("Role")
				local tag = "LobbySpawn"
				if role == "Rat" then
					tag = "RatSpawn"
				elseif role == "Chef" then
					tag = "ChefSpawn"
				end
				local target = spawnPoint(tag)
				root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				p.Character:PivotTo(target)
				task.spawn(streamAround, p, target.Position)
			end
		end
	end
end)

-- ===== Главный цикл =====
while true do
	-- ЛОББИ
	setState("Lobby")
	ReplicatedStorage:SetAttribute("Chaos", 0)
	ReplicatedStorage:SetAttribute("TimeLeft", 0)
	while #Players:GetPlayers() < Config.MinPlayers do
		task.wait(1)
	end
	local enough = true
	for t = Config.LobbyTime, 1, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		task.wait(1)
		if #Players:GetPlayers() < Config.MinPlayers then
			enough = false
			break
		end
	end

	if enough then
		-- ОТСЧЁТ
		winner, winReason = nil, nil
		alarmOn = false
		roundCoins = {}
		lastAbility = {}
		chooseMap()
		pickEvent()
		SabotageService.reset()
		ChefService.reset()
		setState("Intro")
		local chef = assignRoles()
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(spawnPlayer, p)
		end
		for t = Config.IntroTime, 1, -1 do
			ReplicatedStorage:SetAttribute("TimeLeft", t)
			task.wait(1)
		end

		-- РАУНД
		setState("Playing")
		if currentEvent == "GoldenHour" then
			nextGolden = os.clock() + 5
		else
			nextGolden = os.clock() + 25
		end
		for _, p in ipairs(Players:GetPlayers()) do
			refreshSpeed(p)
		end
		if currentEvent then
			notifyAll("banner", "event_" .. currentEvent)
		end
		if chef and chef.Parent then
			notifyAll("info", "chef_is", chef.DisplayName)
		else
			chef = nil
			ChefAI.start(spawnPoint("ChefSpawn"))
			notifyAll("info", "chef_bot")
		end

		local timeLeft = Config.RoundTime
		while timeLeft > 0 and not winner do
			ReplicatedStorage:SetAttribute("TimeLeft", timeLeft)
			task.wait(1)
			timeLeft = timeLeft - 1
			hungerTick()
			SabotageService.dripTick()
			if os.clock() >= nextGolden then
				if currentEvent == "GoldenHour" then
					nextGolden = os.clock() + Config.GoldenHourInterval
				else
					nextGolden = os.clock() + Config.GoldenCheeseInterval
				end
				spawnGolden()
			end
			if chef and not chef.Parent then
				chef = nil
				ChefAI.start(spawnPoint("ChefSpawn"))
				notifyAll("info", "chef_left")
			end
			if #ratsList() == 0 then
				endRound("Chef", "reason_norats")
			end
		end
		if not winner then
			winner, winReason = "Chef", "reason_time"
		end

		-- КОНЕЦ РАУНДА
		setState("Ended")
		ReplicatedStorage:SetAttribute("TimeLeft", Config.EndTime)
		ReplicatedStorage:SetAttribute("Winner", winner)
		ChefAI.stop()
		removeGolden()
		currentEvent = nil
		ReplicatedStorage:SetAttribute("Event", "")
		SabotageService.reset()
		giveResults()
		task.spawn(ExtrasService.updateLeaderboard)
		for t = Config.EndTime, 1, -1 do
			ReplicatedStorage:SetAttribute("TimeLeft", t)
			task.wait(1)
		end
		everyoneToLobby()
	end
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">RatBuilder</string><ProtectedString name="Source"><![CDATA[-- RatBuilder (ModuleScript) — ServerScriptService
-- Собирает из деталей живую крысу (хвост, лапки и голова двигаются — см. Effects)
-- и делает шапки из магазина.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local RatBuilder = {}

local PINK = Color3.fromRGB(255, 160, 180)
local BLACK = Color3.fromRGB(20, 20, 20)
local WHITE = Color3.fromRGB(250, 250, 250)
local VERT = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр стоит вертикально

local function makePart(name, size, color, shape, ellipsoid, material)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

local function weldTo(base, part, cframe)
	part.CFrame = cframe
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
end

local function addMotor(name, part0, part1, c0, c1)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1 or CFrame.new()
	m.Parent = part0
	part1.CFrame = part0.CFrame * m.C0 * m.C1:Inverse()
	return m
end

-- ===== Шапки =====
-- Каждая шапка: функция add(размер, позиция, цвет, форма, материал).
-- V и AT уже учитывают размер головы.
local HATS = {}

HATS.cap = function(add, V, AT)
	local red = Color3.fromRGB(220, 50, 50)
	add(V(0.5, 1.0, 1.0), AT(0, 0.25, 0) * VERT, red, Enum.PartType.Cylinder)
	add(V(0.9, 0.08, 0.6), AT(0, 0.05, -0.6), red)
	add(V(0.15, 0.15, 0.15), AT(0, 0.52, 0), WHITE, Enum.PartType.Ball)
end

HATS.bow = function(add, V, AT)
	local pink = Color3.fromRGB(255, 105, 180)
	add(V(0.3, 0.3, 0.3), AT(0, 0.15, 0), pink, Enum.PartType.Ball)
	add(V(0.45, 0.3, 0.15), AT(0.3, 0.15, 0) * CFrame.Angles(0, 0, 0.4), pink)
	add(V(0.45, 0.3, 0.15), AT(-0.3, 0.15, 0) * CFrame.Angles(0, 0, -0.4), pink)
end

HATS.party = function(add, V, AT)
	local colors = { Color3.fromRGB(80, 180, 255), Color3.fromRGB(255, 220, 60) }
	for i = 0, 4 do
		local d = 0.9 - i * 0.17
		add(V(0.25, d, d), AT(0, 0.125 + i * 0.25, 0) * VERT, colors[(i % 2) + 1], Enum.PartType.Cylinder)
	end
	add(V(0.28, 0.28, 0.28), AT(0, 1.35, 0), Color3.fromRGB(255, 80, 160), Enum.PartType.Ball)
end

HATS.cowboy = function(add, V, AT)
	local brown = Color3.fromRGB(140, 90, 50)
	add(V(0.1, 2.0, 2.0), AT(0, 0.05, 0) * VERT, brown, Enum.PartType.Cylinder)
	add(V(0.7, 1.05, 1.05), AT(0, 0.4, 0) * VERT, brown, Enum.PartType.Cylinder)
	add(V(0.15, 1.08, 1.08), AT(0, 0.17, 0) * VERT, Color3.fromRGB(60, 35, 20), Enum.PartType.Cylinder)
end

HATS.pumpkin = function(add, V, AT)
	add(V(1.2, 1.2, 1.2), AT(0, 0.5, 0), Color3.fromRGB(255, 140, 30), Enum.PartType.Ball)
	add(V(0.3, 0.15, 0.15), AT(0, 1.15, 0) * VERT, Color3.fromRGB(60, 140, 50), Enum.PartType.Cylinder)
	local glow = Color3.fromRGB(255, 220, 80)
	add(V(0.2, 0.2, 0.06), AT(0.22, 0.62, -0.57), glow, nil, Enum.Material.Neon)
	add(V(0.2, 0.2, 0.06), AT(-0.22, 0.62, -0.57), glow, nil, Enum.Material.Neon)
	add(V(0.5, 0.12, 0.06), AT(0, 0.32, -0.56), glow, nil, Enum.Material.Neon)
end

HATS.tophat = function(add, V, AT)
	local black = Color3.fromRGB(25, 25, 30)
	add(V(0.08, 1.5, 1.5), AT(0, 0.04, 0) * VERT, black, Enum.PartType.Cylinder)
	add(V(1.0, 0.95, 0.95), AT(0, 0.55, 0) * VERT, black, Enum.PartType.Cylinder)
	add(V(0.18, 0.97, 0.97), AT(0, 0.2, 0) * VERT, Color3.fromRGB(200, 30, 40), Enum.PartType.Cylinder)
end

HATS.chef = function(add, V, AT)
	add(V(0.4, 1.0, 1.0), AT(0, 0.2, 0) * VERT, WHITE, Enum.PartType.Cylinder)
	add(V(1.2, 1.2, 1.2), AT(0, 0.75, 0), WHITE, Enum.PartType.Ball)
end

HATS.pirate = function(add, V, AT)
	local black = Color3.fromRGB(25, 25, 30)
	add(V(0.1, 1.6, 1.6), AT(0, 0.05, 0) * VERT, black, Enum.PartType.Cylinder)
	add(V(0.5, 1.0, 1.0), AT(0, 0.3, 0) * VERT, black, Enum.PartType.Cylinder)
	add(V(1.4, 0.6, 0.1), AT(0, 0.4, -0.7) * CFrame.Angles(math.rad(-20), 0, 0), black)
	add(V(0.3, 0.3, 0.3), AT(0, 0.45, -0.78), WHITE, Enum.PartType.Ball)
end

HATS.crown = function(add, V, AT)
	local gold = Color3.fromRGB(255, 200, 40)
	add(V(0.3, 1.0, 1.0), AT(0, 0.15, 0) * VERT, gold, Enum.PartType.Cylinder, Enum.Material.Metal)
	for i = 0, 5 do
		local a = i * math.pi / 3
		add(V(0.15, 0.4, 0.15), CFrame.Angles(0, a, 0) * AT(0, 0.45, -0.42), gold, nil, Enum.Material.Metal)
	end
	add(V(0.16, 0.16, 0.16), AT(0, 0.17, -0.5), Color3.fromRGB(230, 30, 60), Enum.PartType.Ball, Enum.Material.Neon)
end

HATS.vipcrown = function(add, V, AT)
	local gold = Color3.fromRGB(255, 205, 50)
	add(V(0.35, 1.15, 1.15), AT(0, 0.17, 0) * VERT, gold, Enum.PartType.Cylinder, Enum.Material.Metal)
	for i = 0, 7 do
		local a = i * math.pi / 4
		add(V(0.18, 0.55, 0.18), CFrame.Angles(0, a, 0) * AT(0, 0.55, -0.5), gold, nil, Enum.Material.Metal)
		add(V(0.14, 0.14, 0.14), CFrame.Angles(0, a, 0) * AT(0, 0.88, -0.5), Color3.fromRGB(255, 255, 255), Enum.PartType.Ball, Enum.Material.Neon)
	end
	add(V(0.24, 0.24, 0.24), AT(0, 0.2, -0.58), Color3.fromRGB(60, 140, 255), Enum.PartType.Ball, Enum.Material.Neon)
end

HATS.viking = function(add, V, AT)
	local steel = Color3.fromRGB(170, 175, 185)
	add(V(1.1, 1.1, 1.1), AT(0, 0.25, 0), steel, Enum.PartType.Ball, Enum.Material.Metal)
	add(V(0.2, 1.15, 1.15), AT(0, 0.02, 0) * VERT, Color3.fromRGB(150, 100, 50), Enum.PartType.Cylinder, Enum.Material.Wood)
	for _, side in ipairs({ -1, 1 }) do
		add(V(0.22, 0.75, 0.22), AT(0.62 * side, 0.55, 0) * CFrame.Angles(0, 0, -0.6 * side), Color3.fromRGB(245, 235, 210))
		add(V(0.16, 0.16, 0.16), AT(0.85 * side, 0.85, 0), Color3.fromRGB(245, 235, 210), Enum.PartType.Ball)
	end
end

HATS.headphones = function(add, V, AT)
	local dark = Color3.fromRGB(30, 30, 38)
	add(V(1.5, 0.15, 0.25), AT(0, 0.35, 0), dark)
	for _, side in ipairs({ -1, 1 }) do
		add(V(0.18, 0.55, 0.18), AT(0.72 * side, 0.12, 0), dark)
		add(V(0.25, 0.55, 0.55), AT(0.8 * side, -0.2, 0) * CFrame.Angles(0, 0, 0), Color3.fromRGB(80, 200, 255), Enum.PartType.Cylinder, Enum.Material.Neon)
	end
end

HATS.wizard = function(add, V, AT)
	local purple = Color3.fromRGB(90, 50, 170)
	add(V(0.1, 1.7, 1.7), AT(0, 0.05, 0) * VERT, purple, Enum.PartType.Cylinder)
	for i = 0, 5 do
		local d = 0.95 - i * 0.15
		add(V(0.3, d, d), AT(0.04 * i, 0.2 + i * 0.28, 0) * VERT, purple, Enum.PartType.Cylinder)
	end
	add(V(0.2, 0.2, 0.2), AT(0.24, 1.9, 0), Color3.fromRGB(255, 230, 90), Enum.PartType.Ball, Enum.Material.Neon)
	add(V(0.16, 0.16, 0.16), AT(0.3, 0.6, -0.52), Color3.fromRGB(255, 230, 90), Enum.PartType.Ball, Enum.Material.Neon)
end

HATS.halo = function(add, V, AT)
	local glow = Color3.fromRGB(255, 240, 120)
	for i = 0, 9 do
		local a = i * math.pi / 5
		add(V(0.16, 0.16, 0.16), CFrame.Angles(0, a, 0) * AT(0, 0.7, -0.5), glow, Enum.PartType.Ball, Enum.Material.Neon)
	end
end

-- Надеть шапку на голову персонажа (крысы или человека в лобби)
function RatBuilder.attachHat(character, head, hatId, scale, topOffset)
	local old = character:FindFirstChild("Hat")
	if old then
		old:Destroy()
	end
	local builder = HATS[hatId or "none"]
	if not builder or not head then
		return
	end
	local hatModel = Instance.new("Model")
	hatModel.Name = "Hat"
	local anchor = head.CFrame * topOffset
	local function V(x, y, z)
		return Vector3.new(x * scale, y * scale, z * scale)
	end
	local function AT(x, y, z)
		return CFrame.new(x * scale, y * scale, z * scale)
	end
	local function add(size, rel, color, shape, material)
		local p = makePart("HatPart", size, color, shape, false, material)
		weldTo(head, p, anchor * rel)
		p.Parent = hatModel
		return p
	end
	builder(add, V, AT)
	hatModel.Parent = character
end

-- ===== След за крысой =====
function RatBuilder.attachTrail(character, trailId)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local old = root:FindFirstChild("RatTrail")
	if old then
		old:Destroy()
	end
	for _, n in ipairs({ "TrailA", "TrailB" }) do
		local a = root:FindFirstChild(n)
		if a then
			a:Destroy()
		end
	end
	local info = Config.getTrail(trailId or "none")
	if not info or not info.Colors then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(0, 0.5, 1.2)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(0, -0.4, 1.2)
	a1.Parent = root
	local keys = {}
	for i, c in ipairs(info.Colors) do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #info.Colors - 1), c))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, info.Colors[1]))
	end
	local trail = Instance.new("Trail")
	trail.Name = "RatTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(keys)
	trail.Lifetime = 0.7
	trail.LightEmission = 0.8
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	trail.Parent = root
end

-- ===== Невидимость (класс «Невидимка») =====
function RatBuilder.setInvisible(character, on)
	if not character then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			if on then
				if d:GetAttribute("BaseT") == nil then
					d:SetAttribute("BaseT", d.Transparency)
				end
				d.Transparency = 0.88
			elseif d:GetAttribute("BaseT") ~= nil then
				d.Transparency = d:GetAttribute("BaseT")
			end
		elseif d:IsA("Trail") or d:IsA("Sparkles") then
			d.Enabled = not on
		end
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		if on then
			hum.NameDisplayDistance = 0
		else
			hum.NameDisplayDistance = 40
		end
	end
end

-- ===== Крыса =====
function RatBuilder.build(player, cframe)
	local model = Instance.new("Model")
	model.Name = player.Name

	local color = Config.RatColors[math.random(#Config.RatColors)]
	local earColor = color:Lerp(PINK, 0.55)

	-- Невидимое "ядро": по нему крыса ходит и сталкивается со стенами
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1.4, 1, 2.4)
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = cframe
	root.Parent = model
	model.PrimaryPart = root

	-- Тело и голова на моторах (их покачивает скрипт Effects). Перед крысы смотрит по -Z.
	local body = makePart("Body", Vector3.new(1.5, 1.2, 2.6), color, nil, true)
	addMotor("BodyMotor", root, body, CFrame.new(0, 0.1, 0.1))
	body.Parent = model
	local belly = makePart("Belly", Vector3.new(1.1, 0.7, 1.9), color:Lerp(WHITE, 0.45), nil, true)
	weldTo(body, belly, body.CFrame * CFrame.new(0, -0.3, -0.1))
	belly.Parent = model

	local head = makePart("Head", Vector3.new(1.1, 1, 1.4), color, nil, true)
	addMotor("HeadMotor", root, head, CFrame.new(0, 0.35, -1.45))
	head.Parent = model

	local function onHead(name, size, offset, c, shape, material)
		local p = makePart(name, size, c, shape, false, material)
		weldTo(head, p, head.CFrame * offset)
		p.Parent = model
		return p
	end
	onHead("Nose", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, -0.05, -0.7), PINK, Enum.PartType.Ball)
	for _, side in ipairs({ -1, 1 }) do
		onHead("Eye", Vector3.new(0.24, 0.24, 0.24), CFrame.new(0.32 * side, 0.25, -0.4), BLACK, Enum.PartType.Ball)
		onHead("EyeShine", Vector3.new(0.08, 0.08, 0.08), CFrame.new(0.32 * side + 0.04, 0.31, -0.5), WHITE, Enum.PartType.Ball, Enum.Material.Neon)
		onHead("Ear", Vector3.new(0.12, 0.65, 0.65), CFrame.new(0.42 * side, 0.6, 0.25), earColor, Enum.PartType.Cylinder)
		onHead("Tooth", Vector3.new(0.1, 0.16, 0.05), CFrame.new(0.06 * side, -0.32, -0.6), WHITE)
		for _, tilt in ipairs({ -0.15, 0.15 }) do
			onHead(
				"Whisker",
				Vector3.new(0.7, 0.03, 0.03),
				CFrame.new(0.42 * side, -0.05, -0.55) * CFrame.Angles(0, 0.25 * side, tilt),
				Color3.fromRGB(230, 230, 230)
			)
		end
	end

	-- Хвост из двух частей, лапки
	local tail1 = makePart("Tail1", Vector3.new(0.2, 0.2, 1.3), PINK)
	addMotor("Tail1Motor", root, tail1, CFrame.new(0, -0.05, 1.3) * CFrame.Angles(math.rad(12), 0, 0), CFrame.new(0, 0, -0.65))
	tail1.Parent = model
	local tail2 = makePart("Tail2", Vector3.new(0.15, 0.15, 1.3), PINK)
	addMotor("Tail2Motor", tail1, tail2, CFrame.new(0, 0, 0.6) * CFrame.Angles(math.rad(-18), 0, 0), CFrame.new(0, 0, -0.6))
	tail2.Parent = model
	for _, side in ipairs({ -1, 1 }) do
		for _, front in ipairs({ -1, 1 }) do
			local foot = makePart("Foot", Vector3.new(0.42, 0.42, 0.42), PINK, Enum.PartType.Ball)
			local m = addMotor("FootMotor", root, foot, CFrame.new(0.5 * side, -0.75, 0.75 * front))
			if side * front > 0 then
				m:SetAttribute("Phase", 0)
			else
				m:SetAttribute("Phase", math.pi)
			end
			foot.Parent = model
		end
	end

	RatBuilder.attachHat(model, head, player:GetAttribute("Hat"), 0.8, CFrame.new(0, 0.42, 0.05))

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15 -- R15 использует HipHeight, ноги не нужны
	hum.RequiresNeck = false -- у крысы нет "шеи", иначе она сразу умрёт
	hum.BreakJointsOnDeath = false
	hum.HipHeight = 0.5
	hum.WalkSpeed = Config.RatWalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = Config.RatJumpPower
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.DisplayName = player.DisplayName
	local cls = Config.getClass(player:GetAttribute("Class") or "normal")
	if cls and cls.Id ~= "normal" then
		hum.DisplayName = cls.Icon .. " " .. hum.DisplayName
	end
	if player:GetAttribute("VIP") then
		hum.DisplayName = "👑 " .. hum.DisplayName
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 215, 80)
		sp.Parent = body
	end
	hum.NameDisplayDistance = 40
	hum.Parent = model
	RatBuilder.attachTrail(model, player:GetAttribute("Trail"))

	model:AddTag("Rat")
	return model
end

return RatBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService (ModuleScript) — ServerScriptService
-- Сыр-монетки 🧀, победы, уровень, шапки, следы, классы. Сохраняется между играми (DataStore).
-- В Studio сохранение работает, только если включить:
--   Home → Game Settings → Security → Enable Studio Access to API Services

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

local DataService = {}
local ctx
local store = nil
local cache = {} -- [player] = данные

-- таблицу игроков видят все, поэтому названия понятны на любом языке
local COINS_NAME = "🧀 Cheese"
local WINS_NAME = "🏆 Wins"
local LEVEL_NAME = "⭐ Level"

local function defaultData()
	return {
		Coins = 0,
		Wins = 0,
		Level = 1,
		XP = 0,
		Owned = { none = true, cap = true },
		Hat = "cap",
		OwnedTrails = { none = true },
		Trail = "none",
		OwnedClasses = { normal = true },
		Class = "normal",
		OwnedPets = { none = true },
		Pet = "none",
		Quests = { Day = 0, List = {} },
		UsedCodes = {},
		LastObby = 0,
		LastDaily = 0,
		Streak = 0,
		Tutorial = false,
		ChefNext = false,
		Purchases = {},
	}
end

local function setString(set)
	local list = {}
	for id, on in pairs(set) do
		if on then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return table.concat(list, ",")
end

local function publish(player)
	local data = cache[player]
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Wins", data.Wins)
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPNeed", Config.xpForLevel(data.Level))
	player:SetAttribute("Hat", data.Hat)
	player:SetAttribute("OwnedHats", setString(data.Owned))
	player:SetAttribute("Trail", data.Trail)
	player:SetAttribute("OwnedTrails", setString(data.OwnedTrails))
	player:SetAttribute("Class", data.Class)
	player:SetAttribute("OwnedClasses", setString(data.OwnedClasses))
	player:SetAttribute("TutorialDone", data.Tutorial)
	player:SetAttribute("Pet", data.Pet)
	player:SetAttribute("OwnedPets", setString(data.OwnedPets))
	-- задания одной строкой: вид:прогресс:цель:награда:готово;...
	local q = {}
	for _, quest in ipairs(data.Quests.List) do
		table.insert(q, ("%s:%d:%d:%d:%d"):format(quest.Kind, quest.Progress, quest.Goal, quest.Reward, quest.Done and 1 or 0))
	end
	player:SetAttribute("Quests", table.concat(q, ";"))
	player:SetAttribute("ChefNext", data.ChefNext)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local map = { [COINS_NAME] = data.Coins, [WINS_NAME] = data.Wins, [LEVEL_NAME] = data.Level }
		for name, value in pairs(map) do
			local v = stats:FindFirstChild(name)
			if v then
				v.Value = value
			end
		end
	end
end

-- шапки за уровень выдаются сами
local function unlockLevelHats(player, data, announce)
	for _, hat in ipairs(Config.Hats) do
		if hat.Level and data.Level >= hat.Level and not data.Owned[hat.Id] then
			data.Owned[hat.Id] = true
			if announce and ctx then
				ctx.notifyPlayer(player, "good", "level_hat", hat.Icon, function(lang)
					return Locale.itemName(lang, hat)
				end)
			end
		end
	end
end

local function deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local t = {}
	for k, val in pairs(v) do
		t[k] = deepCopy(val)
	end
	return t
end

local function copySet(src, dst, valid)
	if type(src) == "table" then
		for id, on in pairs(src) do
			if on and valid(id) then
				dst[id] = true
			end
		end
	end
end

function DataService.load(player)
	local data = defaultData()
	if store then
		local ok, saved = pcall(function()
			return store:GetAsync("player_" .. player.UserId)
		end)
		if ok and type(saved) == "table" then
			data.Coins = tonumber(saved.Coins) or 0
			data.Wins = tonumber(saved.Wins) or 0
			data.Level = math.max(1, tonumber(saved.Level) or 1)
			data.XP = math.max(0, tonumber(saved.XP) or 0)
			copySet(saved.Owned, data.Owned, function(id)
				return Config.getHat(id) ~= nil
			end)
			copySet(saved.OwnedTrails, data.OwnedTrails, function(id)
				return Config.getTrail(id) ~= nil
			end)
			copySet(saved.OwnedClasses, data.OwnedClasses, function(id)
				return Config.getClass(id) ~= nil
			end)
			copySet(saved.OwnedPets, data.OwnedPets, function(id)
				return Config.getPet(id) ~= nil
			end)
			if type(saved.Pet) == "string" and data.OwnedPets[saved.Pet] then
				data.Pet = saved.Pet
			end
			if type(saved.UsedCodes) == "table" then
				for code, used in pairs(saved.UsedCodes) do
					if used then
						data.UsedCodes[tostring(code)] = true
					end
				end
			end
			data.LastObby = tonumber(saved.LastObby) or 0
			if type(saved.Quests) == "table" and type(saved.Quests.List) == "table" then
				data.Quests.Day = tonumber(saved.Quests.Day) or 0
				for _, q in ipairs(saved.Quests.List) do
					if type(q) == "table" and type(q.Kind) == "string" and tonumber(q.Goal) then
						table.insert(data.Quests.List, {
							Id = tostring(q.Id),
							Kind = q.Kind,
							Goal = tonumber(q.Goal),
							Reward = tonumber(q.Reward) or 0,
							Progress = tonumber(q.Progress) or 0,
							Done = q.Done == true,
						})
					end
				end
			end
			if type(saved.Hat) == "string" and data.Owned[saved.Hat] then
				data.Hat = saved.Hat
			end
			if type(saved.Trail) == "string" and data.OwnedTrails[saved.Trail] then
				data.Trail = saved.Trail
			end
			if type(saved.Class) == "string" and data.OwnedClasses[saved.Class] then
				data.Class = saved.Class
			end
			data.LastDaily = tonumber(saved.LastDaily) or 0
			data.Streak = tonumber(saved.Streak) or 0
			data.Tutorial = saved.Tutorial == true
			data.ChefNext = saved.ChefNext == true
			if type(saved.Purchases) == "table" then
				for id, v in pairs(saved.Purchases) do
					if v then
						data.Purchases[tostring(id)] = true
					end
				end
			end
		elseif not ok then
			warn("[Data] Не удалось загрузить данные (в Studio включи доступ к API):", saved)
		end
	end
	if not player.Parent then
		return 0, 0
	end
	cache[player] = data
	unlockLevelHats(player, data, false)

	-- ежедневный бонус (дни подряд дают больше)
	local today = math.floor(os.time() / 86400)
	local bonus = 0
	if today > data.LastDaily then
		if today == data.LastDaily + 1 then
			data.Streak = math.min(data.Streak + 1, Config.DailyBonusMaxDays)
		else
			data.Streak = 1
		end
		data.LastDaily = today
		bonus = Config.DailyBonusBase + (data.Streak - 1) * Config.DailyBonusStep
		data.Coins = data.Coins + bonus
	end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ LEVEL_NAME, COINS_NAME, WINS_NAME }) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player

	publish(player)
	return bonus, data.Streak
end

function DataService.save(player)
	local data = cache[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("player_" .. player.UserId, data)
	end)
	if not ok then
		warn("[Data] Не удалось сохранить:", err)
	end
end

function DataService.addCoins(player, amount)
	local data = cache[player]
	if not data or amount == 0 then
		return
	end
	data.Coins = math.max(0, data.Coins + amount)
	publish(player)
end

function DataService.addWin(player)
	local data = cache[player]
	if data then
		data.Wins = data.Wins + 1
		publish(player)
	end
end

-- Опыт. Возвращает, сколько уровней получено.
function DataService.addXP(player, amount)
	local data = cache[player]
	if not data or not amount or amount <= 0 then
		return 0
	end
	if player:GetAttribute("DoubleXP") then
		amount = amount * 2 -- ⭐ пропуск «×2 Опыт»
	end
	data.XP = data.XP + amount
	local gained = 0
	while data.XP >= Config.xpForLevel(data.Level) do
		data.XP = data.XP - Config.xpForLevel(data.Level)
		data.Level = data.Level + 1
		data.Coins = data.Coins + Config.LevelUpCheese
		gained = gained + 1
		ctx.notifyPlayer(player, "banner", "level_up", data.Level, Config.LevelUpCheese)
		ctx.fxPlayer(player, "levelup", data.Level)
	end
	if gained > 0 then
		unlockLevelHats(player, data, true)
	end
	publish(player)
	return gained
end

-- Выдать шапку (например, VIP-корону за покупку пропуска)
function DataService.grantHat(player, hatId)
	local data = cache[player]
	if data and not data.Owned[hatId] then
		data.Owned[hatId] = true
		publish(player)
	end
end

function DataService.grantTrail(player, trailId)
	local data = cache[player]
	if data and not data.OwnedTrails[trailId] then
		data.OwnedTrails[trailId] = true
		publish(player)
	end
end

function DataService.grantAllClasses(player)
	local data = cache[player]
	if not data then
		return
	end
	for _, cls in ipairs(Config.Classes) do
		data.OwnedClasses[cls.Id] = true
	end
	publish(player)
end

-- Покупка за Robux: один чек засчитывается один раз. mutate(data) меняет данные игрока.
-- Сначала сохраняем, и только потом подтверждаем Roblox (иначе Robux пропали бы зря).
function DataService.processPurchase(player, purchaseId, mutate)
	local data = cache[player]
	if not data then
		return false
	end
	purchaseId = tostring(purchaseId)
	if data.Purchases[purchaseId] then
		return true, true
	end
	local before = deepCopy(data)
	data.Purchases[purchaseId] = true
	mutate(data)
	if store then
		local ok = pcall(function()
			store:SetAsync("player_" .. player.UserId, data)
		end)
		if not ok then
			cache[player] = before -- откатываем всё как было
			publish(player)
			return false
		end
	end
	publish(player)
	return true, false
end

-- старое имя (покупка сыра)
function DataService.grantPurchase(player, purchaseId, coins)
	local ok = DataService.processPurchase(player, purchaseId, function(data)
		data.Coins = data.Coins + coins
	end)
	return ok
end

function DataService.getHat(player)
	local data = cache[player]
	if data then
		return data.Hat
	end
	return player:GetAttribute("Hat")
end

function DataService.getTrail(player)
	local data = cache[player]
	return data and data.Trail or "none"
end

function DataService.getClass(player)
	local data = cache[player]
	return Config.getClass(data and data.Class or "normal") or Config.Classes[1]
end

function DataService.isChefNext(player)
	local data = cache[player]
	return data ~= nil and data.ChefNext == true
end

function DataService.clearChefNext(player)
	local data = cache[player]
	if data then
		data.ChefNext = false
		publish(player)
	end
end

function DataService.markTutorial(player)
	local data = cache[player]
	if data and not data.Tutorial then
		data.Tutorial = true
		publish(player)
	end
end

-- Доступ к данным для других сервисов (задания, коды, питомцы)
function DataService.getData(player)
	return cache[player]
end

function DataService.publish(player)
	publish(player)
end

function DataService.grantPet(player, petId)
	local data = cache[player]
	if data and not data.OwnedPets[petId] then
		data.OwnedPets[petId] = true
		publish(player)
	end
end

function DataService.getPet(player)
	local data = cache[player]
	return Config.getPet(data and data.Pet or "none") or Config.Pets[1]
end

-- ===== Магазин за сыр: шапки, следы, классы, питомцы =====
local CATEGORIES = {
	hat = { list = "Hats", owned = "Owned", field = "Hat", get = Config.getHat },
	trail = { list = "Trails", owned = "OwnedTrails", field = "Trail", get = Config.getTrail },
	class = { list = "Classes", owned = "OwnedClasses", field = "Class", get = Config.getClass },
	pet = { list = "Pets", owned = "OwnedPets", field = "Pet", get = Config.getPet },
}

-- Игрок нажал «R$» на предмете: запоминаем, что он хочет купить
function DataService.setPending(player, category, itemId)
	local data = cache[player]
	local cat = type(category) == "string" and CATEGORIES[category]
	if not data or not cat or type(itemId) ~= "string" then
		return false
	end
	local item = cat.get(itemId)
	if not item or not Config.robuxTier(item) or data[cat.owned][itemId] then
		return false
	end
	data.PendingItem = { Cat = category, Id = itemId }
	return true
end

-- Выдать предмет, который игрок выбрал, если уровень цены совпадает с оплаченным
function DataService.grantPendingItem(data, tier)
	local pend = data.PendingItem
	data.PendingItem = nil
	if type(pend) ~= "table" then
		return nil
	end
	local cat = CATEGORIES[pend.Cat]
	local item = cat and cat.get(pend.Id)
	if not item or Config.robuxTier(item) ~= tier or data[cat.owned][item.Id] then
		return nil
	end
	data[cat.owned][item.Id] = true
	data[cat.field] = item.Id
	return item, pend.Cat
end

local function onShop(player, action, itemId, category)
	local data = cache[player]
	if not data or type(action) ~= "string" or type(itemId) ~= "string" then
		return
	end
	local cat = CATEGORIES[category or "hat"]
	if not cat then
		return
	end
	local item = cat.get(itemId)
	if not item then
		return
	end
	local owned = data[cat.owned]

	if not owned[itemId] then
		if action ~= "buy" then
			return
		end
		if item.VipOnly then
			ctx.notifyPlayer(player, "info", "vip_only")
			return
		end
		if item.Level and data.Level < item.Level then
			ctx.notifyPlayer(player, "info", "level_lock", item.Level)
			return
		end
		if data.Coins < item.Price then
			ctx.notifyPlayer(player, "bad", "no_cheese")
			return
		end
		data.Coins = data.Coins - item.Price
		owned[itemId] = true
		ctx.notifyPlayer(player, "good", "bought", item.Icon, function(lang)
			return Locale.itemName(lang, item)
		end)
		task.spawn(DataService.save, player)
	end
	data[cat.field] = itemId
	publish(player)
	if category == "class" then
		ctx.refreshClass(player)
	elseif category == "pet" then
		ctx.refreshPet(player)
	else
		ctx.refreshHat(player)
	end
end

function DataService.init(context)
	ctx = context
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore("KrysinyPerepoloh_v1")
	end)
	if not ok then
		store = nil
		warn("[Data] Сохранение выключено:", err)
	end

	ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ShopAction").OnServerEvent:Connect(onShop)

	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		cache[player] = nil
	end)

	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			DataService.save(player)
		end
	end)

	-- автосохранение раз в 2 минуты
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in ipairs(Players:GetPlayers()) do
				DataService.save(player)
			end
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">SabotageService</string><ProtectedString name="Source"><![CDATA[-- SabotageService (ModuleScript) — ServerScriptService
-- Предметы, которые крысы ломают, а повар чинит.
-- Любая деталь с тегом "Sabotage" становится заданием.
-- Атрибуты детали (необязательные):
--   TaskName (string)  — название задания, например "Засорить унитаз"
--   Points   (number)  — сколько хаоса даёт поломка
--   MiniGame (string)  — "Wires", "Mash", "Code" или "Timing" (иначе просто держать E)
--   HoldTime (number)  — сколько секунд держать E (если нет мини-игры)
--   Drip     (number)  — хаос в секунду, пока предмет сломан
--   Effect   (string)  — "Lights" = выключает свет во всём ресторане
-- Дети детали: Fire / Smoke / ParticleEmitter / Sparkles / Sound включаются при поломке,
-- а детали с именем "BrokenVisual" становятся видимыми (лужа, пятно, красный экран...).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

local SabotageService = {}
local ctx
local miniGameEvent
local active = {} -- [игрок] = { station, started, code }

-- имя задания на языке каждого игрока
local function taskName(station)
	return function(lang)
		return Locale.taskName(lang, station)
	end
end

local function isFreeRat(player)
	return player:GetAttribute("Role") == "Rat" and not player:GetAttribute("Caught")
end

local function setLights(on, onlyMap)
	for _, lamp in ipairs(CollectionService:GetTagged("RoomLight")) do
		if not onlyMap or lamp:IsDescendantOf(onlyMap) then
			for _, l in ipairs(lamp:GetDescendants()) do
				if l:IsA("Light") then
					l.Enabled = on
				end
			end
			if lamp:IsA("BasePart") then
				if on then
					lamp.Material = Enum.Material.Neon
				else
					lamp.Material = Enum.Material.SmoothPlastic
				end
			end
		end
	end
end

local function setEffects(station, broken)
	for _, d in ipairs(station:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
			d.Enabled = broken
		elseif d:IsA("Sound") then
			if broken then
				d:Play()
			else
				d:Stop()
			end
		elseif d:IsA("BasePart") and d.Name == "BrokenVisual" then
			if broken then
				d.Transparency = d:GetAttribute("VisibleTransparency") or 0
			else
				d.Transparency = 1
			end
		end
	end

	if station:GetAttribute("Effect") == "Lights" then
		local mapFolder = Config.activeMap()
		if mapFolder and not station:IsDescendantOf(mapFolder) then
			mapFolder = nil
		end
		if broken then
			-- свет мигает и гаснет
			task.spawn(function()
				for i = 1, 6 do
					setLights(i % 2 == 0, mapFolder)
					task.wait(0.12)
				end
				setLights(not station:GetAttribute("Broken"), mapFolder)
			end)
		else
			setLights(true, mapFolder)
		end
	end
end

local function closeMiniGamesFor(station)
	for player, info in pairs(active) do
		if info.station == station then
			active[player] = nil
			miniGameEvent:FireClient(player, "close")
		end
	end
end

function SabotageService.sabotage(station, player)
	if not ctx.isPlaying() or not isFreeRat(player) or not Config.inActiveMap(station) then
		return
	end
	if station:GetAttribute("Broken") then
		return
	end

	station:SetAttribute("Broken", true)
	setEffects(station, true)
	closeMiniGamesFor(station)
	player:SetAttribute("Score", (player:GetAttribute("Score") or 0) + 1)
	ctx.reward(player, "Sabotage")
	ctx.fxAll("sabotage", station.Position)
	ctx.notifyAll("good", "sabotaged", player.DisplayName, taskName(station))
	ctx.alertNoise(station.Position)
	ctx.addChaos(station:GetAttribute("Points") or Config.DefaultTaskPoints)
end

function SabotageService.repair(station, whoName, chefPlayer)
	if not ctx.isPlaying() or not station:GetAttribute("Broken") then
		return
	end
	station:SetAttribute("Broken", false)
	setEffects(station, false)
	if chefPlayer then
		ctx.reward(chefPlayer, "Repair")
	end
	ctx.fxAll("repair", station.Position)
	ctx.notifyAll("bad", "repaired", whoName or "?", taskName(station))
end

-- ===== Мини-игры =====
local function startMiniGame(station, player)
	if not ctx.isPlaying() or not isFreeRat(player) or station:GetAttribute("Broken") then
		return
	end
	local mine = active[player]
	if mine and mine.station == station then
		return -- уже играет в эту мини-игру
	end
	for other, info in pairs(active) do
		if other ~= player and info.station == station then
			ctx.notifyPlayer(player, "info", "busy")
			return
		end
	end
	local kind = station:GetAttribute("MiniGame")
	local data = {}
	local code = nil
	if kind == "Code" then
		code = tostring(math.random(1000, 9999))
		data.code = code
	end
	active[player] = { station = station, started = os.clock(), code = code }
	miniGameEvent:FireClient(player, "open", station, kind, data)
end

local function onMiniGameEvent(player, action, station, answer)
	local info = active[player]
	if action == "cancel" then
		active[player] = nil
		return
	end
	if action ~= "done" or not info or info.station ~= station then
		return
	end
	active[player] = nil
	local kind = station:GetAttribute("MiniGame")
	local minTime = Config.MiniGameMinTime[kind] or 1
	if os.clock() - info.started < minTime then
		return
	end
	if info.code and tostring(answer) ~= info.code then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - station.Position).Magnitude > 14 then
		return
	end
	SabotageService.sabotage(station, player)
end

function SabotageService.cancelFor(player)
	if active[player] then
		active[player] = nil
		miniGameEvent:FireClient(player, "close")
	end
end

function SabotageService.forget(player)
	active[player] = nil
end

-- ===== Служебное =====
function SabotageService.getBroken()
	local list = {}
	for _, station in ipairs(Config.taggedInMap("Sabotage")) do
		if station:GetAttribute("Broken") then
			table.insert(list, station)
		end
	end
	return list
end

-- Вызывается раз в секунду: сломанные предметы постепенно добавляют хаос
function SabotageService.dripTick()
	local total = 0
	for _, station in ipairs(SabotageService.getBroken()) do
		total = total + (station:GetAttribute("Drip") or Config.DefaultTaskDrip)
	end
	if total > 0 then
		ctx.addChaos(total)
	end
end

function SabotageService.reset()
	for player in pairs(active) do
		miniGameEvent:FireClient(player, "close")
	end
	active = {}
	for _, station in ipairs(CollectionService:GetTagged("Sabotage")) do
		station:SetAttribute("Broken", false)
		setEffects(station, false)
	end
	setLights(true)
end

local function setupStation(station)
	if not station:IsA("BasePart") then
		warn("[Sabotage] Тег Sabotage нужно ставить на деталь (Part), а не на", station:GetFullName())
		return
	end
	station:SetAttribute("Broken", false)
	setEffects(station, false)
	local kind = station:GetAttribute("MiniGame")

	local sab = Instance.new("ProximityPrompt")
	sab.Name = "SabotagePrompt"
	-- тексты на языке игрока подставляет RatHUD
	sab.ActionText = "Sabotage"
	sab.ObjectText = Locale.taskName("en", station)
	sab.MaxActivationDistance = 7
	sab.RequiresLineOfSight = false
	if kind then
		sab.HoldDuration = 0
		sab.Triggered:Connect(function(player)
			startMiniGame(station, player)
		end)
	else
		sab.HoldDuration = station:GetAttribute("HoldTime") or Config.DefaultSabotageTime
		sab.Triggered:Connect(function(player)
			SabotageService.sabotage(station, player)
		end)
	end
	sab.Parent = station

	local rep = Instance.new("ProximityPrompt")
	rep.Name = "RepairPrompt"
	rep.ActionText = "Repair"
	rep.ObjectText = Locale.taskName("en", station)
	rep.HoldDuration = Config.RepairTime
	rep.MaxActivationDistance = 9
	rep.RequiresLineOfSight = false
	rep.Parent = station
	rep.Triggered:Connect(function(player)
		if player:GetAttribute("Role") == "Chef" then
			SabotageService.repair(station, player.DisplayName, player)
		end
	end)
	-- Какую подсказку показывать (крысе или повару) решает RatHUD на стороне игрока.
end

function SabotageService.init(context)
	ctx = context
	miniGameEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("MiniGame")
	miniGameEvent.OnServerEvent:Connect(onMiniGameEvent)
	for _, station in ipairs(CollectionService:GetTagged("Sabotage")) do
		setupStation(station)
	end
	CollectionService:GetInstanceAddedSignal("Sabotage"):Connect(setupStation)
end

return SabotageService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">ChefService</string><ProtectedString name="Source"><![CDATA[-- ChefService (ModuleScript) — ServerScriptService
-- Сачок и мышеловки повара, клетки для крыс, колпак и фонарик.
-- Клетка = деталь-пол с тегом "Cage". Пойманные крысы телепортируются туда.
-- Свободная крыса может открыть клетку (держать E рядом).

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

local ChefService = {}
local ctx
local cageOccupants = {} -- [клетка] = { [игрок] = true }
local lastSwing = {}
local lastTrap = {}
local traps = {} -- поставленные мышеловки (по порядку)

local WHITE = Color3.fromRGB(245, 245, 245)

local function getRoot(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function isFreeRat(player)
	return player:GetAttribute("Role") == "Rat" and not player:GetAttribute("Caught")
end

local function simplePart(name, size, cframe, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

-- ===== Поймать / освободить =====

function ChefService.catchRat(rat, catcher)
	if not ctx.isPlaying() or not isFreeRat(rat) then
		return false
	end
	local root = getRoot(rat.Character)
	if not root then
		return false
	end

	if rat:GetAttribute("Armored") then
		ctx.notifyAll("info", "armor_block", rat.DisplayName)
		ctx.fxAll("repair", root.Position)
		return false
	end
	local cage, best = nil, math.huge
	for _, c in ipairs(Config.taggedInMap("Cage")) do
		local d = (c.Position - root.Position).Magnitude
		if d < best then
			cage, best = c, d
		end
	end
	if not cage then
		warn("[Chef] На карте нет клетки (деталь с тегом Cage)!")
		return false
	end

	ctx.fxAll("caught", root.Position)
	rat:SetAttribute("Caught", true)
	rat:SetAttribute("Stunned", false)
	cageOccupants[cage] = cageOccupants[cage] or {}
	cageOccupants[cage][rat] = true
	ctx.onCaught(rat)
	ctx.refreshSpeed(rat)

	local hum = rat.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.JumpPower = 0
	end
	local offset = CFrame.new(math.random(-15, 15) / 10, cage.Size.Y / 2 + 1.3, math.random(-15, 15) / 10)
	rat.Character:PivotTo(cage.CFrame * offset)

	if catcher then
		catcher:SetAttribute("Score", (catcher:GetAttribute("Score") or 0) + 1)
		ctx.reward(catcher, "Catch")
	end
	ctx.notifyAll("bad", "caught", rat.DisplayName)
	ctx.checkAllCaught()
	return true
end

function ChefService.release(rat)
	rat:SetAttribute("Caught", false)
	local character = rat.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.JumpPower = Config.RatJumpPower
	end
	ctx.refreshSpeed(rat)
	local spawnPart = ctx.getSpawn("RatSpawn")
	if character and spawnPart then
		character:PivotTo(CFrame.new(spawnPart.Position + Vector3.new(0, 2, 0)))
	end
end

local function freeCage(cage, rescuer)
	local occupants = cageOccupants[cage]
	if not occupants then
		return
	end
	local freed = 0
	for rat in pairs(occupants) do
		if rat.Parent and rat:GetAttribute("Caught") then
			ChefService.release(rat)
			freed = freed + 1
		end
	end
	cageOccupants[cage] = {}
	if freed > 0 then
		rescuer:SetAttribute("Score", (rescuer:GetAttribute("Score") or 0) + freed)
		ctx.reward(rescuer, "Rescue")
		ctx.fxAll("rescue", cage.Position)
		ctx.notifyAll("good", "rescued", rescuer.DisplayName, freed)
	end
end

local function setupCage(cage)
	if not cage:IsA("BasePart") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "FreePrompt"
	prompt.ActionText = "Open cage"
	prompt.ObjectText = "Cage"
	prompt.HoldDuration = Config.FreeCageTime
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = cage
	prompt.Triggered:Connect(function(player)
		if ctx.isPlaying() and isFreeRat(player) then
			freeCage(cage, player)
		end
	end)
end

-- ===== Мышеловки =====

function ChefService.stunRat(rat)
	if not isFreeRat(rat) or rat:GetAttribute("Stunned") then
		return
	end
	rat:SetAttribute("Stunned", true)
	ctx.refreshSpeed(rat)
	local hum = rat.Character and rat.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.JumpPower = 0
	end
	ctx.notifyAll("bad", "trapped", rat.DisplayName)
	task.delay(Config.TrapStunTime, function()
		if not rat.Parent then
			return
		end
		rat:SetAttribute("Stunned", false)
		local h = rat.Character and rat.Character:FindFirstChildOfClass("Humanoid")
		if h and not rat:GetAttribute("Caught") then
			h.JumpPower = Config.RatJumpPower
		end
		ctx.refreshSpeed(rat)
	end)
end

local function removeTrap(model)
	for i, t in ipairs(traps) do
		if t == model then
			table.remove(traps, i)
			break
		end
	end
	model:Destroy()
end

function ChefService.placeTrap(position)
	if #traps >= Config.MaxTraps then
		removeTrap(traps[1])
	end

	-- находим пол под точкой
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	local ignore = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local npc = workspace:FindFirstChild("ChefNPC")
	if npc then
		table.insert(ignore, npc)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), params)
	local floorY = position.Y - 2.8
	if hit then
		floorY = hit.Position.Y
	end
	local base = CFrame.new(position.X, floorY, position.Z)

	local model = Instance.new("Model")
	model.Name = "Mousetrap"
	local board = simplePart("Board", Vector3.new(1.6, 0.2, 2.4), base * CFrame.new(0, 0.1, 0), Color3.fromRGB(190, 140, 80), Enum.Material.Wood)
	local bar = simplePart("Bar", Vector3.new(1.5, 0.12, 0.12), base * CFrame.new(0, 0.28, -0.6), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	local spring = simplePart("Spring", Vector3.new(0.6, 0.15, 0.15), base * CFrame.new(0, 0.28, 0.2), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	local bait = simplePart("Bait", Vector3.new(0.45, 0.3, 0.45), base * CFrame.new(0, 0.35, 0.6), Color3.fromRGB(255, 205, 60))
	local sensor = simplePart("Sensor", Vector3.new(2, 1.6, 2.8), base * CFrame.new(0, 0.8, 0), WHITE)
	sensor.Transparency = 1
	for _, p in ipairs({ board, bar, spring, bait, sensor }) do
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Parent = model
	end
	model.PrimaryPart = board
	model.Parent = workspace
	table.insert(traps, model)

	sensor.Touched:Connect(function(hit2)
		if model:GetAttribute("Sprung") or not ctx.isPlaying() then
			return
		end
		local rat = Players:GetPlayerFromCharacter(hit2.Parent)
		if rat and isFreeRat(rat) and not rat:GetAttribute("Stunned") then
			model:SetAttribute("Sprung", true)
			bar.CFrame = base * CFrame.new(0, 0.28, 0.9)
			ChefService.stunRat(rat)
			ctx.fxAll("trap", base.Position)
			ctx.alertNoise(base.Position)
			task.delay(2, function()
				if model.Parent then
					removeTrap(model)
				end
			end)
		end
	end)
	return model
end

-- ===== Внешний вид повара =====

function ChefService.dressChef(character)
	local head = character:WaitForChild("Head", 5)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not head or not hum then
		return
	end

	-- Поварской колпак (собираем из шара и цилиндра)
	local hat = Instance.new("Accessory")
	hat.Name = "ChefHat"
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Shape = Enum.PartType.Ball
	handle.Size = Vector3.new(1.9, 1.9, 1.9)
	handle.Color = WHITE
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = hat
	local att = Instance.new("Attachment")
	att.Name = "HatAttachment"
	att.Position = Vector3.new(0, -0.8, 0)
	att.Parent = handle
	local band = Instance.new("Part")
	band.Name = "Band"
	band.Shape = Enum.PartType.Cylinder
	band.Size = Vector3.new(0.7, 1.5, 1.5)
	band.Color = WHITE
	band.CanCollide = false
	band.Massless = true
	band.CFrame = CFrame.new(0, -0.75, 0) * CFrame.Angles(0, 0, math.rad(90))
	band.Parent = hat
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = band
	weld.Parent = band
	hum:AddAccessory(hat)

	-- Фонарик на лбу: в темноте повар видит, а крысы видят повара
	local light = Instance.new("SpotLight")
	light.Name = "ChefLamp"
	light.Face = Enum.NormalId.Front
	light.Angle = 70
	light.Range = 40
	light.Brightness = 3
	light.Color = Color3.fromRGB(255, 240, 210)
	light.Parent = head
end

-- ===== Инструменты =====

function ChefService.makeNetTool(lang)
	lang = lang or "en"
	local tool = Instance.new("Tool")
	tool.Name = Locale.t(lang, "tool_net")
	tool.ToolTip = Locale.t(lang, "tool_net_tip")
	tool:SetAttribute("ToolKind", "Net")
	tool.CanBeDropped = false
	-- держим сачок за конец, сетка смотрит вверх
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -1.5), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1), Vector3.new(1, 0, 0))

	local handle = simplePart("Handle", Vector3.new(0.3, 0.3, 4), CFrame.new(), Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	handle.CanCollide = false
	handle.Parent = tool

	local ring = simplePart("Ring", Vector3.new(0.2, 2.3, 2.3), CFrame.new(0, 0, 2.9), Color3.fromRGB(90, 90, 95), Enum.Material.Metal)
	ring.Shape = Enum.PartType.Cylinder
	local net = simplePart("Net", Vector3.new(0.12, 2.1, 2.1), CFrame.new(0, 0, 2.9), WHITE, Enum.Material.Fabric)
	net.Shape = Enum.PartType.Cylinder
	net.Transparency = 0.4
	for _, p in ipairs({ ring, net }) do
		p.CanCollide = false
		p.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
	end
	return tool
end

function ChefService.giveTool(player)
	local tool = ChefService.makeNetTool(Locale.detect(player))
	tool.Activated:Connect(function()
		local now = os.clock()
		if (lastSwing[player] or 0) + Config.CatchCooldown > now then
			return
		end
		lastSwing[player] = now

		-- стандартная анимация взмаха
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		game:GetService("Debris"):AddItem(anim, 1)

		local root = getRoot(player.Character)
		if not root then
			return
		end
		ctx.fxAll("swing", root.Position)
		local range = Config.CatchRange
		if game:GetService("ReplicatedStorage"):GetAttribute("Event") == "GiantChef" then
			range = range * Config.GiantCatchMult -- гигантский сачок
		end
		local best, bestDist = nil, range
		for _, other in ipairs(Players:GetPlayers()) do
			local r = nil
			if other ~= player and isFreeRat(other) then
				r = getRoot(other.Character)
			end
			if r then
				local delta = r.Position - root.Position
				local dist = delta.Magnitude
				local inFront = dist < 3 or root.CFrame.LookVector:Dot(delta.Unit) > 0.2
				if dist < bestDist and inFront then
					best, bestDist = other, dist
				end
			end
		end
		if best then
			ChefService.catchRat(best, player)
		end
	end)
	tool.Parent = player:WaitForChild("Backpack")
end

function ChefService.giveTrapTool(player)
	local lang = Locale.detect(player)
	local tool = Instance.new("Tool")
	tool.Name = Locale.t(lang, "tool_trap")
	tool.ToolTip = Locale.t(lang, "tool_trap_tip")
	tool:SetAttribute("ToolKind", "Trap")
	tool.CanBeDropped = false
	local handle = simplePart("Handle", Vector3.new(1, 0.2, 1.4), CFrame.new(), Color3.fromRGB(190, 140, 80), Enum.Material.Wood)
	handle.CanCollide = false
	handle.Parent = tool

	tool.Activated:Connect(function()
		local now = os.clock()
		local left = (lastTrap[player] or -1000) + Config.TrapCooldown - now
		if left > 0 then
			ctx.notifyPlayer(player, "info", "trap_cooldown", math.ceil(left))
			return
		end
		local root = getRoot(player.Character)
		if not root or not ctx.isPlaying() then
			return
		end
		lastTrap[player] = now
		ChefService.placeTrap(root.Position + root.CFrame.LookVector * 4)
		ctx.notifyPlayer(player, "info", "trap_placed")
	end)
	tool.Parent = player:WaitForChild("Backpack")
end

-- ===== Служебное =====

function ChefService.reset()
	cageOccupants = {}
	lastTrap = {}
	while #traps > 0 do
		removeTrap(traps[1])
	end
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("Caught", false)
		p:SetAttribute("Stunned", false)
	end
end

function ChefService.forget(player)
	lastSwing[player] = nil
	lastTrap[player] = nil
	for _, occupants in pairs(cageOccupants) do
		occupants[player] = nil
	end
end

function ChefService.trapCount()
	return #traps
end

function ChefService.init(context)
	ctx = context
	for _, cage in ipairs(CollectionService:GetTagged("Cage")) do
		setupCage(cage)
	end
	CollectionService:GetInstanceAddedSignal("Cage"):Connect(setupCage)
end

return ChefService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">ChefAI</string><ProtectedString name="Source"><![CDATA[-- ChefAI (ModuleScript) — ServerScriptService
-- Повар-робот: играет за повара, если людей мало.
-- Видит крыс перед собой (за столами и стенами можно спрятаться!),
-- слышит поломки, писк и мышеловки, гонится, ловит, чинит, ставит мышеловки,
-- злится во время тревоги и патрулирует точки с тегом "PatrolPoint".

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

local ChefAI = {}
local ctx, Sabotage, Chef
local npc = nil
local running = false
local generation = 0
local spawnCFrame = CFrame.new(0, 5, 0)
local skipUntil = {} -- предметы, до которых не получилось дойти
local alertPos = nil
local alertTime = 0

local AGENT = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4 }
local ANIM_WALK = "rbxassetid://507777826" -- стандартная R15 ходьба
local ANIM_IDLE = "rbxassetid://507766388" -- стандартная R15 стойка
local OFFSETS = {
	Vector3.new(0, 0, 0),
	Vector3.new(6, 0, 0),
	Vector3.new(-6, 0, 0),
	Vector3.new(0, 0, 6),
	Vector3.new(0, 0, -6),
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true -- сквозь невидимые/некасаемые детали видно

local function getRoot(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function buildNPC()
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(234, 184, 146)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = Color3.fromRGB(245, 245, 245)
	desc.LeftLegColor = Color3.fromRGB(50, 50, 60)
	desc.RightLegColor = Color3.fromRGB(50, 50, 60)

	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = "ChefNPC"
	model:PivotTo(spawnCFrame)
	model.Parent = workspace
	if ReplicatedStorage:GetAttribute("Event") == "GiantChef" then
		pcall(function()
			model:ScaleTo(Config.GiantScale) -- 🧟 гигантский повар
		end)
	end

	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.WalkSpeed = Config.AIChefWalkSpeed
	hum.DisplayName = "🤖 Chef Bot"
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	Chef.dressChef(model)
	getRoot(model):SetNetworkOwner(nil)

	-- робот держит сачок
	local net = Chef.makeNetTool()
	net.Parent = model
	hum:EquipTool(net)

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local walkAnim = Instance.new("Animation")
	walkAnim.AnimationId = ANIM_WALK
	local idleAnim = Instance.new("Animation")
	idleAnim.AnimationId = ANIM_IDLE
	local walk = animator:LoadAnimation(walkAnim)
	local idle = animator:LoadAnimation(idleAnim)
	idle:Play()
	hum.Running:Connect(function(speed)
		if speed > 0.5 then
			if not walk.IsPlaying then
				walk:Play(0.2)
				idle:Stop(0.2)
			end
		elseif not idle.IsPlaying then
			idle:Play(0.2)
			walk:Stop(0.2)
		end
	end)
	return model
end

local function canSee(root, ratChar)
	local ratRoot = getRoot(ratChar)
	if not ratRoot then
		return false
	end
	local eye = root.Position + Vector3.new(0, 1.5, 0)
	local delta = ratRoot.Position - eye
	local dist = delta.Magnitude
	if dist > Config.AISightRange then
		return false
	end
	-- далеко видит только то, что впереди; вблизи "слышит" со всех сторон
	if dist > 12 then
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude > 0.01 and root.CFrame.LookVector:Dot(flat.Unit) < 0.1 then
			return false
		end
	end
	rayParams.FilterDescendantsInstances = { npc, ratChar }
	return workspace:Raycast(eye, delta, rayParams) == nil
end

local function findTarget()
	local root = getRoot(npc)
	if not root then
		return nil
	end
	local best, bestDist = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Role") == "Rat" and not p:GetAttribute("Caught") and not p:GetAttribute("Invisible") and p.Character then
			local r = getRoot(p.Character)
			if r and canSee(root, p.Character) then
				local d = (r.Position - root.Position).Magnitude
				if d < bestDist then
					best, bestDist = p, d
				end
			end
		end
	end
	return best
end

local function computePath(from, to)
	local path = PathfindingService:CreatePath(AGENT)
	local ok = pcall(function()
		path:ComputeAsync(from, to)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path
	end
	return nil
end

local function updateSpeed(hum)
	local speed = Config.AIChefWalkSpeed
	if (ReplicatedStorage:GetAttribute("Chaos") or 0) >= Config.AlarmChaos then
		speed = speed + Config.ChefRageBonus
	end
	if ReplicatedStorage:GetAttribute("Event") == "Turbo" then
		speed = speed * Config.TurboMult
	end
	hum.WalkSpeed = speed
end

-- Идти к точке по пути. abort() => true прерывает (например, увидел крысу)
local function walkTo(target, alive, abort)
	local root = getRoot(npc)
	local hum = npc and npc:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end

	local path = nil
	for _, off in ipairs(OFFSETS) do
		path = computePath(root.Position, Vector3.new(target.X, 1, target.Z) + off)
		if path then
			break
		end
	end
	if not path then
		hum:MoveTo(target)
		task.wait(1)
		return
	end

	for _, wp in ipairs(path:GetWaypoints()) do
		if not alive() then
			return
		end
		if wp.Action == Enum.PathWaypointAction.Jump then
			hum.Jump = true
		end
		hum:MoveTo(wp.Position)
		local started = os.clock()
		local lastPos = root.Position
		local stuckTime = 0
		while os.clock() - started < 2 do
			local flat = (root.Position - wp.Position) * Vector3.new(1, 0, 1)
			if flat.Magnitude < 2.5 then
				break
			end
			if not alive() or (abort and abort()) then
				return
			end
			task.wait(0.1)
			-- застрял? подпрыгнуть
			if (root.Position - lastPos).Magnitude < 0.05 then
				stuckTime = stuckTime + 0.1
				if stuckTime > 0.8 then
					hum.Jump = true
					stuckTime = 0
				end
			else
				stuckTime = 0
			end
			lastPos = root.Position
		end
	end
end

local function nearestStation(list, pos)
	local best, bestDist = nil, math.huge
	for _, st in ipairs(list) do
		if (skipUntil[st] or 0) < os.clock() then
			local d = (st.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = st, d
			end
		end
	end
	return best
end

local function brain(myGen)
	local function alive()
		return running and generation == myGen and npc ~= nil and npc.Parent ~= nil
	end
	local lastSeen = nil

	while running and generation == myGen do
		-- робот упал с карты / умер: создаём заново
		local hum = npc and npc:FindFirstChildOfClass("Humanoid")
		if not npc or not npc.Parent or not hum or hum.Health <= 0 then
			if npc then
				npc:Destroy()
				npc = nil
			end
			task.wait(2)
			if not running or generation ~= myGen then
				break
			end
			local model = buildNPC()
			if generation ~= myGen then
				model:Destroy()
				break
			end
			npc = model
			hum = npc:FindFirstChildOfClass("Humanoid")
		end
		local root = getRoot(npc)
		updateSpeed(hum)

		local target = findTarget()
		local tRoot = nil
		if target then
			tRoot = getRoot(target.Character)
		end
		if tRoot then
			lastSeen = tRoot.Position
			local reach = Config.CatchRange - 1
			if ReplicatedStorage:GetAttribute("Event") == "GiantChef" then
				reach = reach * Config.GiantCatchMult
			end
			if (tRoot.Position - root.Position).Magnitude <= reach then
				ctx.fxAll("swing", root.Position)
				Chef.catchRat(target, nil)
				lastSeen = nil
				task.wait(1)
			else
				hum:MoveTo(tRoot.Position)
				task.wait(0.15)
			end
		elseif lastSeen then
			-- проверить место, где последний раз видел крысу
			local pos = lastSeen
			lastSeen = nil
			walkTo(pos, alive, findTarget)
		elseif alertPos and os.clock() - alertTime < 20 then
			-- услышал шум
			local pos = alertPos
			alertPos = nil
			walkTo(pos, alive, findTarget)
		else
			local st = nearestStation(Sabotage.getBroken(), root.Position)
			if st then
				walkTo(st.Position, alive, findTarget)
				if alive() and st:GetAttribute("Broken") and (st.Position - root.Position).Magnitude < 10 then
					hum:MoveTo(root.Position)
					local interrupted = false
					local t0 = os.clock()
					while os.clock() - t0 < Config.AIRepairTime do
						task.wait(0.2)
						if not alive() or findTarget() then
							interrupted = true
							break
						end
					end
					if not interrupted then
						Sabotage.repair(st, function(lang)
							return Locale.t(lang, "bot_name")
						end, nil)
						-- иногда оставляет мышеловку рядом с починенным
						if math.random() < 0.5 and Chef.trapCount() < Config.MaxTraps then
							Chef.placeTrap(root.Position + root.CFrame.LookVector * 3)
						end
					end
				elseif alive() and st:GetAttribute("Broken") then
					skipUntil[st] = os.clock() + 15 -- не дошёл, попробуем позже
				end
			else
				local points = Config.taggedInMap("PatrolPoint")
				if #points > 0 then
					walkTo(points[math.random(#points)].Position, alive, findTarget)
				else
					task.wait(1)
				end
			end
		end
	end
end

-- Шум (поломка, писк, мышеловка): робот идёт проверить, если услышал
function ChefAI.alert(position, range)
	if not running or not npc then
		return
	end
	local root = getRoot(npc)
	if root and (position - root.Position).Magnitude <= (range or Config.AIHearingRange) then
		alertPos = position
		alertTime = os.clock()
	end
end

function ChefAI.start(cframe)
	ChefAI.stop()
	spawnCFrame = cframe
	running = true
	generation = generation + 1
	skipUntil = {}
	alertPos = nil
	local myGen = generation
	task.spawn(function()
		local model = buildNPC()
		if generation ~= myGen then
			model:Destroy()
			return
		end
		npc = model
		brain(myGen)
	end)
end

function ChefAI.stop()
	running = false
	generation = generation + 1
	if npc then
		npc:Destroy()
		npc = nil
	end
end

function ChefAI.init(context, sabotageService, chefService)
	ctx = context
	Sabotage = sabotageService
	Chef = chefService
end

return ChefAI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">TestMapBuilder</string><ProtectedString name="Source"><![CDATA[-- TestMapBuilder (ModuleScript) — ServerScriptService
-- Строит уютный ночной ресторан, если в Workspace нет папки "Map".
-- Потом можно построить свою карту в папке Workspace/Map — и этот скрипт перестанет срабатывать.
--
-- План (вид сверху):
--   Кабинет | Кухня        | Зал (столики, камин)
--   --------|              |
--   Склад   |--------------+------
--   (клетка,| Бар          | Туалет
--    гнездо)|              |
-- В некоторых стенах есть крысиные лазейки внизу: крыса пролезет, повар — нет!

local Lighting = game:GetService("Lighting")
local Locale = require(game:GetService("ReplicatedStorage"):WaitForChild("Locale"))
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))

local TestMapBuilder = {}

local H = 14 -- высота стен
local GAP_W = 2.8 -- ширина крысиной лазейки
local GAP_H = 2.6 -- высота лазейки
local map

local C = {
	wood = Color3.fromRGB(120, 78, 50),
	darkWood = Color3.fromRGB(80, 50, 35),
	wall = Color3.fromRGB(214, 176, 134),
	wainscot = Color3.fromRGB(105, 62, 42),
	tile = Color3.fromRGB(215, 215, 205),
	steel = Color3.fromRGB(170, 172, 178),
	white = Color3.fromRGB(240, 240, 235),
	black = Color3.fromRGB(25, 22, 25),
	cheese = Color3.fromRGB(255, 205, 60),
	dark = Color3.fromRGB(40, 32, 30),
	crate = Color3.fromRGB(165, 120, 75),
	green = Color3.fromRGB(70, 140, 70),
	terracotta = Color3.fromRGB(180, 95, 60),
	red = Color3.fromRGB(170, 40, 45),
}

local VERT = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр стоит вертикально
local OFFSET = Vector3.new(0, 0, 0) -- сдвиг всей постройки (вторая карта стоит в другом месте)

-- ===== Помощники =====

local function block(name, size, pos, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	if typeof(pos) == "CFrame" then
		p.CFrame = CFrame.new(OFFSET) * pos
	else
		p.CFrame = CFrame.new(pos + OFFSET)
	end
	p.Color = color or C.wall
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or map
	return p
end

local function ball(name, d, pos, color, material, parent)
	local p = block(name, Vector3.new(d, d, d), pos, color, material, parent)
	p.Shape = Enum.PartType.Ball
	return p
end

-- вертикальный цилиндр: h — высота, d — диаметр, pos — центр
local function cyl(name, h, d, pos, color, material, parent)
	local p = block(name, Vector3.new(h, d, d), CFrame.new(pos) * VERT, color, material, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ghost(p) -- невидимая, не мешает ходить и не закрывает обзор
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function barrier(p) -- невидимая стена: не пускает, но не видна и не мешает камере
	p.Transparency = 1
	p.CanCollide = true
	p.CanTouch = false
	return p
end

-- Карта — это Model с режимом Persistent: даже если в Workspace включён StreamingEnabled,
-- она целиком загружается у каждого игрока (иначе на телефоне крыса может «потеряться»)
local function newMap(name)
	local m = Instance.new("Model")
	m.Name = name
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	return m
end

local function decor(p) -- мелочь: не мешает ходить
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function marker(tag, pos)
	local p = ghost(block(tag, Vector3.new(2, 1, 2), pos, C.white))
	p:AddTag(tag)
	return p
end

-- textEn — тот же текст по-английски (игра покажет нужный язык каждому игроку)
local function label(text, pos, width, maxDistance, textEn)
	local p = ghost(block("Label", Vector3.new(1, 1, 1), pos, C.white))
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(width or 220, 50)
	bb.MaxDistance = maxDistance or 70
	bb.LightInfluence = 0
	bb.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.fromRGB(255, 230, 180)
	t.TextStrokeTransparency = 0.4
	if textEn then
		t:SetAttribute("ru", text)
		t:SetAttribute("en", textEn)
		t:AddTag("Localized")
	end
	t.Parent = bb
	return p
end

-- Плоская табличка/картина. intoRoom — куда смотрит лицевая сторона.
local function sign(pos, intoRoom, w, h, text, bg, textColor, textEn)
	local cf = CFrame.lookAt(pos, pos + intoRoom)
	decor(block("Frame", Vector3.new(w, h, 0.2), cf, C.darkWood, Enum.Material.Wood))
	local canvas = decor(block("Canvas", Vector3.new(w - 0.4, h - 0.4, 0.22), cf * CFrame.new(0, 0, -0.02), bg))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0.3
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = canvas
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = textColor or Color3.new(1, 1, 1)
	if textEn then
		t:SetAttribute("ru", text)
		t:SetAttribute("en", textEn)
		t:AddTag("Localized")
	end
	t.Parent = gui
	return canvas
end

local function wallPiece(x1, z1, x2, z2, y0, y1)
	local h = y1 - y0
	local vertical = x1 == x2
	local size
	if vertical then
		size = Vector3.new(1, h, math.abs(z2 - z1))
	else
		size = Vector3.new(math.abs(x2 - x1), h, 1)
	end
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	block("Wall", size, Vector3.new(cx, (y0 + y1) / 2, cz), C.wall, Enum.Material.Plaster)
	-- деревянная панель внизу стены
	if y0 < 3.5 then
		local th = math.min(y1, 3.5) - y0
		local tsize
		if vertical then
			tsize = Vector3.new(1.15, th, math.abs(z2 - z1))
		else
			tsize = Vector3.new(math.abs(x2 - x1), th, 1.15)
		end
		block("Wainscot", tsize, Vector3.new(cx, y0 + th / 2, cz), C.wainscot, Enum.Material.Wood)
	end
end

-- Стена по прямой. gaps — список координат вдоль стены, где будут крысиные лазейки.
local function wall(x1, z1, x2, z2, gaps)
	local vertical = x1 == x2
	local a, b, fixed
	if vertical then
		a, b, fixed = math.min(z1, z2), math.max(z1, z2), x1
	else
		a, b, fixed = math.min(x1, x2), math.max(x1, x2), z1
	end
	local function piece(s, e, y0, y1)
		if e - s < 0.05 then
			return
		end
		if vertical then
			wallPiece(fixed, s, fixed, e, y0, y1)
		else
			wallPiece(s, fixed, e, fixed, y0, y1)
		end
	end
	local cuts = {}
	for _, g in ipairs(gaps or {}) do
		table.insert(cuts, g)
	end
	table.sort(cuts)
	local cursor = a
	for _, g in ipairs(cuts) do
		piece(cursor, g - GAP_W / 2, 0, H)
		piece(g - GAP_W / 2, g + GAP_W / 2, GAP_H, H)
		local signPos
		if vertical then
			signPos = Vector3.new(fixed, GAP_H + 0.9, g)
		else
			signPos = Vector3.new(g, GAP_H + 0.9, fixed)
		end
		label("🐀", signPos, 40, 30)
		cursor = g + GAP_W / 2
	end
	piece(cursor, b, 0, H)
end

local function floor(x1, z1, x2, z2, color, material)
	return block("Floor", Vector3.new(x2 - x1, 0.4, z2 - z1), Vector3.new((x1 + x2) / 2, 0, (z1 + z2) / 2), color, material)
end

local function tableWithLegs(cx, cz, w, d, h, color)
	local top = block("TableTop", Vector3.new(w, 0.4, d), Vector3.new(cx, h - 0.2, cz), color or C.wood, Enum.Material.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			block(
				"TableLeg",
				Vector3.new(0.4, h - 0.4, 0.4),
				Vector3.new(cx + sx * (w / 2 - 0.4), (h - 0.4) / 2, cz + sz * (d / 2 - 0.4)),
				C.darkWood
			)
		end
	end
	return top
end

local function chair(cx, cz, backDir)
	block("ChairSeat", Vector3.new(2, 0.3, 2), Vector3.new(cx, 2, cz), C.wood, Enum.Material.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			block("ChairLeg", Vector3.new(0.25, 1.85, 0.25), Vector3.new(cx + sx * 0.8, 0.925, cz + sz * 0.8), C.darkWood)
		end
	end
	block("ChairBack", Vector3.new(2, 2.2, 0.3), Vector3.new(cx, 3.25, cz + backDir * 0.85), C.wood, Enum.Material.Wood)
end

local function shelf(cx, cz, w, d, h, levels)
	for i = 0, levels do
		local y = 0.3 + i * (h - 0.3) / levels
		block("ShelfBoard", Vector3.new(w, 0.3, d), Vector3.new(cx, y, cz), C.darkWood, Enum.Material.Wood)
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			block("ShelfPost", Vector3.new(0.3, h, 0.3), Vector3.new(cx + sx * (w / 2 - 0.15), h / 2, cz + sz * (d / 2 - 0.15)), C.darkWood)
		end
	end
end

local function crate(pos, s)
	s = s or 2.5
	return block("Crate", Vector3.new(s, s, s), pos, C.crate, Enum.Material.Wood)
end

local function barrel(x, z)
	cyl("Barrel", 3, 2.4, Vector3.new(x, 1.5, z), Color3.fromRGB(130, 85, 50), Enum.Material.Wood)
	cyl("BarrelRing", 0.25, 2.5, Vector3.new(x, 0.6, z), Color3.fromRGB(70, 70, 75), Enum.Material.Metal)
	cyl("BarrelRing", 0.25, 2.5, Vector3.new(x, 2.4, z), Color3.fromRGB(70, 70, 75), Enum.Material.Metal)
end

local function plant(x, z, s)
	s = s or 1
	cyl("Pot", 1.4 * s, 1.5 * s, Vector3.new(x, 0.7 * s, z), C.terracotta)
	for i = 0, 2 do
		local a = i * 2.1
		decor(ball("Leaves", 1.5 * s, Vector3.new(x + math.cos(a) * 0.45 * s, (2 + i * 0.35) * s, z + math.sin(a) * 0.45 * s), C.green, Enum.Material.Grass))
	end
end

local function lamp(x, z)
	local p = block("Lamp", Vector3.new(2.5, 0.5, 2.5), Vector3.new(x, H - 1.5, z), Color3.fromRGB(255, 210, 140), Enum.Material.Neon)
	decor(block("LampCord", Vector3.new(0.1, 1.2, 0.1), Vector3.new(x, H - 0.65, z), C.black))
	local l = Instance.new("PointLight")
	l.Range = 30
	l.Brightness = 1.3
	l.Color = Color3.fromRGB(255, 190, 120)
	l.Shadows = true
	l.Parent = p
	-- пылинки в свете лампы
	local dust = Instance.new("ParticleEmitter")
	dust.Rate = 2
	dust.Lifetime = NumberRange.new(6, 10)
	dust.Speed = NumberRange.new(0.1, 0.4)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.Size = NumberSequence.new(0.08)
	dust.LightEmission = 1
	dust.Transparency = NumberSequence.new(0.4)
	dust.Color = ColorSequence.new(Color3.fromRGB(255, 230, 190))
	dust.Parent = p
	p:AddTag("RoomLight")
	return p
end

local function alarmLight(x, z)
	local p = decor(block("AlarmLamp", Vector3.new(0.8, 0.8, 0.8), Vector3.new(x, H - 0.6, z), Color3.fromRGB(90, 20, 20)))
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 40, 40)
	l.Range = 26
	l.Brightness = 2
	l.Enabled = false
	l.Parent = p
	p:AddTag("AlarmLight")
end

-- Окно с лунным светом. intoRoom — направление внутрь комнаты.
local function window(pos, intoRoom)
	local along
	if math.abs(intoRoom.X) > 0 then
		along = Vector3.new(0, 0, 1)
	else
		along = Vector3.new(1, 0, 0)
	end
	local cf = CFrame.lookAt(pos, pos + intoRoom)
	local pane = decor(block("Window", Vector3.new(6, 5, 1.3), cf, Color3.fromRGB(140, 170, 230), Enum.Material.Neon))
	pane.Transparency = 0.35
	decor(block("WindowBar", Vector3.new(0.3, 5, 1.4), cf, C.darkWood, Enum.Material.Wood))
	decor(block("WindowBar", Vector3.new(6, 0.3, 1.4), cf, C.darkWood, Enum.Material.Wood))
	decor(block("WindowSill", Vector3.new(6.6, 0.3, 1.8), cf * CFrame.new(0, -2.6, 0), C.darkWood, Enum.Material.Wood))
	local moon = Instance.new("SpotLight")
	moon.Face = Enum.NormalId.Front
	moon.Color = Color3.fromRGB(150, 180, 255)
	moon.Brightness = 1.6
	moon.Range = 28
	moon.Angle = 70
	moon.Shadows = true
	moon.Parent = pane
	return along
end

local function candle(x, y, z)
	decor(cyl("CandleHolder", 0.15, 0.6, Vector3.new(x, y + 0.075, z), Color3.fromRGB(200, 170, 80), Enum.Material.Metal))
	decor(cyl("Candle", 0.6, 0.25, Vector3.new(x, y + 0.45, z), C.white))
	local flame = decor(ball("Flame", 0.2, Vector3.new(x, y + 0.85, z), Color3.fromRGB(255, 170, 60), Enum.Material.Neon))
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 160, 70)
	l.Range = 10
	l.Brightness = 1.2
	l.Parent = flame
	l:AddTag("Flicker")
end

local function station(name, size, pos, color, attrs, material)
	local p = block(name, size, pos, color, material)
	for k, v in pairs(attrs) do
		p:SetAttribute(k, v)
	end
	p:AddTag("Sabotage")
	return p
end

local function brokenVisual(parentStation, size, pos, color, material, visibleTransparency)
	local v = ghost(block("BrokenVisual", size, pos, color, material or Enum.Material.Neon, parentStation))
	v:SetAttribute("VisibleTransparency", visibleTransparency or 0)
	return v
end

local function smoke(parent, color, opacity, rise)
	local s = Instance.new("Smoke")
	s.Color = color
	s.Opacity = opacity
	s.RiseVelocity = rise
	s.Enabled = false
	s.Parent = parent
	return s
end

local function ratHole(pair, pos, intoRoom)
	local p = block("RatHole", Vector3.new(2.2, 1.8, 1), CFrame.lookAt(pos, pos + intoRoom), C.black)
	p.CanCollide = false
	p.CanQuery = false
	p:SetAttribute("Pair", pair)
	p:AddTag("RatHole")
	return p
end

local function cheese(x, z)
	local p = block("Cheese", Vector3.new(0.9, 0.6, 0.9), CFrame.new(x, 0.55, z), C.cheese)
	p.CanCollide = false
	p.CanQuery = false
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 210, 90)
	glow.Range = 5
	glow.Brightness = 0.7
	glow.Parent = p
	p:AddTag("Crumb")
	return p
end

local function cage(x, z)
	local size = 8
	local hgt = 5
	local f = block("CageFloor", Vector3.new(size, 0.4, size), Vector3.new(x, 0.4, z), C.steel, Enum.Material.DiamondPlate)
	f:AddTag("Cage")
	for i = 0, size do
		local o = -size / 2 + i
		for _, pos in ipairs({
			Vector3.new(x + o, hgt / 2 + 0.6, z - size / 2),
			Vector3.new(x + o, hgt / 2 + 0.6, z + size / 2),
			Vector3.new(x - size / 2, hgt / 2 + 0.6, z + o),
			Vector3.new(x + size / 2, hgt / 2 + 0.6, z + o),
		}) do
			block("CageBar", Vector3.new(0.25, hgt, 0.25), pos, C.steel, Enum.Material.Metal)
		end
	end
	block("CageRoof", Vector3.new(size + 0.5, 0.3, size + 0.5), Vector3.new(x, hgt + 0.75, z), C.steel, Enum.Material.DiamondPlate)
	label("🪤 Клетка", Vector3.new(x, hgt + 2.5, z), nil, nil, "🪤 Cage")
end

local function toilet(x, z)
	local bowl = block("Toilet", Vector3.new(2.2, 1.8, 2.8), Vector3.new(x, 0.9, z), C.white)
	block("ToiletTank", Vector3.new(2.4, 2.4, 0.8), Vector3.new(x, 2.6, z + 1.5), C.white)
	return bowl
end

local function ensureEffect(className, name)
	local e = Lighting:FindFirstChild(name)
	if not e then
		e = Instance.new(className)
		e.Name = name
		e.Parent = Lighting
	end
	return e
end

-- ===== Строим =====

-- ===== ВТОРАЯ КАРТА: ПИЦЦЕРИЯ =====
--   Кухня (печь, тестомес) | Склад (клетка, гнездо, щиток)
--   ---------------------------------------------------
--   Зал (столики, касса,    | Аркада (игровые автоматы,
--        автомат с газировкой) |   автомат с игрушками)
local function buildPizzeria()
	map = newMap("MapPizzeria")
	map:SetAttribute("MapName", "Пиццерия")
	map:SetAttribute("MapNameEn", "Pizzeria")
	OFFSET = Vector3.new(0, 0, -260)

	floor(-45, -35, 15, 5, Color3.fromRGB(196, 58, 48), Enum.Material.CeramicTiles) -- Зал
	floor(15, -35, 45, 5, Color3.fromRGB(45, 30, 80), Enum.Material.Carpet) -- Аркада
	floor(-45, 5, 5, 35, Color3.fromRGB(222, 216, 200), Enum.Material.CeramicTiles) -- Кухня
	floor(5, 5, 45, 35, Color3.fromRGB(110, 105, 100), Enum.Material.Concrete) -- Склад

	wall(-45, -35, 45, -35)
	wall(-45, 35, 45, 35)
	wall(-45, -35, -45, 35)
	wall(45, -35, 45, 35)
	wall(-45, 5, -29, 5)
	wall(-21, 5, 21, 5, { 0 }) -- лазейка Зал ↔ Кухня
	wall(29, 5, 45, 5)
	wall(15, -35, 15, -19, { -30 }) -- лазейка Зал ↔ Аркада
	wall(15, -11, 15, 5)
	wall(5, 5, 5, 16)
	wall(5, 24, 5, 35, { 30 }) -- лазейка Кухня ↔ Склад
	block("Ceiling", Vector3.new(92, 1, 72), Vector3.new(0, H + 0.5, 0), C.dark)

	for _, pos in ipairs({ { -30, -20 }, { -5, -20 }, { 30, -15 }, { -20, 20 }, { 25, 20 } }) do
		lamp(pos[1], pos[2])
	end
	for _, pos in ipairs({ { -43, -33 }, { 43, -33 }, { -43, 33 }, { 43, 33 } }) do
		alarmLight(pos[1], pos[2])
	end
	window(Vector3.new(-30, 7.5, -35), Vector3.new(0, 0, 1))
	window(Vector3.new(-2, 7.5, -35), Vector3.new(0, 0, 1))
	sign(Vector3.new(-15, 10.5, -34.35), Vector3.new(0, 0, 1), 12, 3, "🍕 ПИЦЦА 🍕", C.red, Color3.fromRGB(255, 230, 120), "🍕 PIZZA 🍕")
	sign(Vector3.new(30, 10.5, -34.35), Vector3.new(0, 0, 1), 12, 3, "🕹️ АРКАДА", Color3.fromRGB(40, 20, 70), Color3.fromRGB(90, 230, 255), "🕹️ ARCADE")

	-- ---------- ЗАЛ ----------
	label("Зал", Vector3.new(-15, 10, -15), nil, nil, "Dining hall")
	for _, cx in ipairs({ -36, -24, -12, 0 }) do
		for _, cz in ipairs({ -28, -17 }) do
			tableWithLegs(cx, cz, 6, 4, 3.2, C.wood)
			decor(block("Tablecloth", Vector3.new(6.4, 0.06, 4.4), Vector3.new(cx, 3.23, cz), Color3.fromRGB(235, 235, 230), Enum.Material.Fabric))
			decor(cyl("Pizza", 0.15, 2.4, Vector3.new(cx, 3.33, cz), Color3.fromRGB(240, 180, 80)))
			decor(cyl("Sauce", 0.16, 2.0, Vector3.new(cx, 3.35, cz), Color3.fromRGB(200, 50, 40)))
			chair(cx, cz - 3, -1)
			chair(cx, cz + 3, 1)
		end
	end
	block("PizzaCounter", Vector3.new(12, 3.5, 3), Vector3.new(-38, 1.75, 1.5), C.darkWood, Enum.Material.Wood)
	local register = station("Register", Vector3.new(2, 1.6, 1.6), Vector3.new(-35, 4.3, 1.5), Color3.fromRGB(60, 60, 70), {
		TaskName = "Взломать кассу",
		TaskNameEn = "Hack the cash register",
		Points = 12,
		MiniGame = "Code",
	}, Enum.Material.Metal)
	brokenVisual(register, Vector3.new(1.6, 1, 0.1), Vector3.new(-35, 4.6, 0.65), Color3.fromRGB(255, 40, 40))
	local soda = station("SodaMachine", Vector3.new(3, 8, 3), Vector3.new(-43, 4, -8), Color3.fromRGB(220, 40, 40), {
		TaskName = "Взорвать автомат с газировкой",
		TaskNameEn = "Explode the soda machine",
		Points = 12,
		HoldTime = 3,
	})
	decor(block("SodaPanel", Vector3.new(0.2, 3, 2.2), Vector3.new(-41.45, 5, -8), Color3.fromRGB(255, 240, 200), Enum.Material.Neon))
	smoke(soda, Color3.fromRGB(150, 90, 50), 0.35, 4)
	brokenVisual(soda, Vector3.new(7, 0.1, 6), Vector3.new(-38.5, 0.25, -8), Color3.fromRGB(120, 60, 30), Enum.Material.Glass, 0.3)
	plant(10, -32)
	plant(-42, -32)

	-- ---------- АРКАДА ----------
	label("Аркада", Vector3.new(30, 10, -15), nil, nil, "Arcade")
	for i = 0, 3 do
		local z = -30 + i * 7
		local color = Color3.fromHSV(i / 4, 0.7, 0.55)
		local cab
		if i == 1 then
			cab = station("ArcadeMachine", Vector3.new(3, 7, 3.5), Vector3.new(43, 3.5, z), color, {
				TaskName = "Сломать игровой автомат",
				TaskNameEn = "Break the arcade machine",
				Points = 12,
				MiniGame = "Wires",
			})
			local sp = Instance.new("Sparkles")
			sp.SparkleColor = Color3.fromRGB(120, 230, 255)
			sp.Enabled = false
			sp.Parent = cab
			brokenVisual(cab, Vector3.new(0.2, 2, 2.6), Vector3.new(41.35, 4.8, z), Color3.fromRGB(255, 40, 40))
		else
			cab = block("ArcadeCab", Vector3.new(3, 7, 3.5), Vector3.new(43, 3.5, z), color)
		end
		decor(block("ArcadeScreen", Vector3.new(0.2, 2, 2.6), Vector3.new(41.4, 4.8, z), Color3.fromHSV(i / 4, 0.5, 1), Enum.Material.Neon))
		decor(block("ArcadeStick", Vector3.new(0.6, 0.6, 0.6), Vector3.new(41.2, 3.4, z), C.black))
	end
	block("ClawBase", Vector3.new(5, 2, 5), Vector3.new(25, 1, -25), Color3.fromRGB(255, 120, 200))
	local glass = decor(block("ClawGlass", Vector3.new(5, 4.5, 5), Vector3.new(25, 4.25, -25), Color3.fromRGB(200, 230, 255), Enum.Material.Glass))
	glass.Transparency = 0.6
	for k = 0, 5 do
		decor(ball("Prize", 0.9, Vector3.new(23.6 + (k % 3) * 1.4, 2.5, -26 + math.floor(k / 3) * 1.8), Color3.fromHSV(k / 6, 0.6, 1)))
	end
	for k = 0, 4 do
		decor(block("NeonStripe", Vector3.new(26, 0.05, 0.4), Vector3.new(30, 0.24, -32 + k * 7), Color3.fromHSV(k / 5, 0.8, 1), Enum.Material.Neon))
	end

	-- ---------- КУХНЯ ----------
	label("Кухня", Vector3.new(-20, 10, 20), nil, nil, "Kitchen")
	local oven = station("PizzaOven", Vector3.new(9, 7, 5), Vector3.new(-37, 3.5, 31.5), Color3.fromRGB(160, 80, 50), {
		TaskName = "Сжечь пиццу в печи",
		TaskNameEn = "Burn the pizza in the oven",
		Points = 12,
		MiniGame = "Timing",
	}, Enum.Material.Brick)
	decor(block("OvenMouth", Vector3.new(4, 2.5, 0.2), Vector3.new(-37, 3, 28.9), C.black))
	local ovenGlow = decor(block("OvenGlow", Vector3.new(3.4, 0.6, 0.2), Vector3.new(-37, 2.1, 28.85), Color3.fromRGB(255, 120, 30), Enum.Material.Neon))
	local og = Instance.new("PointLight")
	og.Color = Color3.fromRGB(255, 130, 50)
	og.Range = 14
	og.Brightness = 1.5
	og.Parent = ovenGlow
	og:AddTag("Flicker")
	local ovenFire = Instance.new("Fire")
	ovenFire.Size = 7
	ovenFire.Heat = 12
	ovenFire.Enabled = false
	ovenFire.Parent = oven
	smoke(oven, Color3.fromRGB(60, 60, 60), 0.5, 5)
	local mixer = station("DoughMixer", Vector3.new(3, 4.5, 3), Vector3.new(-22, 2.25, 31.5), C.steel, {
		TaskName = "Перегрузить тестомес",
		TaskNameEn = "Overload the dough mixer",
		Points = 10,
		MiniGame = "Mash",
	}, Enum.Material.Metal)
	decor(cyl("MixerBowl", 1.2, 2.4, Vector3.new(-22, 5.1, 31.5), Color3.fromRGB(200, 200, 205), Enum.Material.Metal))
	brokenVisual(mixer, Vector3.new(6, 0.1, 5), Vector3.new(-22, 0.25, 27.5), Color3.fromRGB(245, 235, 210), Enum.Material.SmoothPlastic)
	block("Counter", Vector3.new(14, 3.5, 3), Vector3.new(-8, 1.75, 33.5), C.steel, Enum.Material.Metal)
	for i = 0, 3 do
		decor(cyl("Jar", 0.9, 0.6, Vector3.new(-12 + i * 2, 3.95, 33.5), Color3.fromHSV(i / 4, 0.4, 0.9), Enum.Material.Glass))
	end
	tableWithLegs(-20, 17, 10, 4, 3.5, C.steel)
	for k = 0, 2 do
		decor(cyl("PizzaBase", 0.15, 2.2, Vector3.new(-23.5 + k * 3.5, 3.58, 17), Color3.fromRGB(245, 220, 170)))
	end
	decor(ball("Tomato", 0.6, Vector3.new(-17, 3.8, 18.2), Color3.fromRGB(220, 40, 40)))
	marker("ChefSpawn", Vector3.new(-15, 1, 11))

	-- ---------- СКЛАД ----------
	label("Склад", Vector3.new(25, 10, 20), nil, nil, "Storage")
	cage(36, 27)
