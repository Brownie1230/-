	-- фургон доставки пиццы
	block("VanBody", Vector3.new(14, 7, 6.5), Vector3.new(84, 4.3, -28), C.white)
	block("VanStripe", Vector3.new(14.1, 1, 6.6), Vector3.new(84, 3.2, -28), C.red)
	block("VanCabin", Vector3.new(3.5, 4.5, 6.4), Vector3.new(75.3, 3.05, -28), C.white)
	decor(block("VanWindow", Vector3.new(0.2, 2, 5.6), Vector3.new(73.5, 4.2, -28), Color3.fromRGB(40, 60, 80), Enum.Material.Glass))
	sign(Vector3.new(86, 5.6, -24.7), Vector3.new(0, 0, 1), 8, 2.2, "🍕 PIZZA 🍕", C.red, Color3.fromRGB(255, 240, 200))
	for _, wx in ipairs({ 77, 89 }) do
		for _, wz in ipairs({ -31.4, -24.6 }) do
			if not (wx == 77 and wz == -24.6) then
				local wheel = block("Wheel", Vector3.new(0.9, 2.6, 2.6), CFrame.new(wx, 1.3, wz) * CFrame.Angles(0, math.rad(90), 0), C.black)
				wheel.Shape = Enum.PartType.Cylinder
			end
		end
	end
	local tire = station("VanTire", Vector3.new(0.9, 2.6, 2.6), CFrame.new(77, 1.3, -24.6) * CFrame.Angles(0, math.rad(90), 0), C.black, {
		TaskName = "Проколоть шину фургона",
		TaskNameEn = "Pop the van's tire",
		Points = 8,
		MiniGame = "Mash",
	})
	tire.Shape = Enum.PartType.Cylinder
	smoke(tire, Color3.fromRGB(200, 200, 200), 0.3, 3)
	crate(Vector3.new(74.5, 1.25, -21.5))
	crate(Vector3.new(76.5, 3.75, -23))
	-- коробки с пиццей
	local boxes = station("PizzaBoxes", Vector3.new(3, 2.4, 3), Vector3.new(70, 1.2, 5), Color3.fromRGB(215, 180, 130), {
		TaskName = "Рассыпать коробки с пиццей",
		TaskNameEn = "Knock over the pizza boxes",
		Points = 8,
		HoldTime = 2,
	}, Enum.Material.Cardboard)
	brokenVisual(boxes, Vector3.new(6, 0.3, 5), Vector3.new(70, 0.35, 0.5), Color3.fromRGB(215, 180, 130), Enum.Material.Cardboard)
	shelf(97.5, -2, 3, 10, 8, 3)
	barrel(95, -40)
	barrel(91.5, -41)
	decor(block("GarageDoor", Vector3.new(0.4, 9, 12), Vector3.new(99.3, 4.5, -15), Color3.fromRGB(150, 150, 160), Enum.Material.DiamondPlate))
	cheese(66, -10)
	cheese(92, 8)

	-- ---------- МОРОЗИЛКА ----------
	label("Морозилка", Vector3.new(80, 10, 30), nil, nil, "Freezer")
	lamp(80, 30)
	local cold = Instance.new("PointLight")
	cold.Color = Color3.fromRGB(150, 200, 255)
	cold.Range = 30
	cold.Brightness = 1.5
	cold.Parent = ghost(block("ColdLight", Vector3.new(1, 1, 1), Vector3.new(80, 10, 30), C.white))
	alarmLight(98, 43)
	shelf(84, 43, 16, 3, 8, 3)
	for i = 0, 5 do
		decor(block("IceBlock", Vector3.new(1.6, 1.6, 1.6), Vector3.new(78 + i * 2.4, 3.75, 43), Color3.fromRGB(190, 230, 255), Enum.Material.Glass)).Transparency = 0.3
	end
	for i = 0, 3 do
		decor(cyl("IceCream", 1.2, 1.4, Vector3.new(79 + i * 3, 6.3, 43), Color3.fromHSV(i * 0.2, 0.35, 1)))
	end
	local freezer = station("FreezerPanel", Vector3.new(1, 3, 2.5), Vector3.new(99, 4.5, 30), Color3.fromRGB(120, 160, 200), {
		TaskName = "Разморозить морозилку",
		TaskNameEn = "Defrost the freezer",
		Points = 8,
		MiniGame = "Timing",
	}, Enum.Material.Metal)
	smoke(freezer, Color3.fromRGB(220, 240, 255), 0.35, 2)
	brokenVisual(freezer, Vector3.new(8, 0.1, 6), Vector3.new(93, 0.25, 30), Color3.fromRGB(80, 140, 220), Enum.Material.Glass, 0.35)
	crate(Vector3.new(97.5, 1.25, 30))
	cheese(70, 30)

	-- ---------- КРЫСИНЫЕ НОРКИ (телепорты парами) ----------
	ratHole("1", Vector3.new(-59.5, 1.1, -20), Vector3.new(1, 0, 0)) -- Кабинет
	ratHole("1", Vector3.new(59.5, 1.1, 25), Vector3.new(-1, 0, 0)) -- Туалет
	ratHole("2", Vector3.new(-33, 1.1, 44.5), Vector3.new(0, 0, -1)) -- Склад
	ratHole("2", Vector3.new(45, 1.1, -44.5), Vector3.new(0, 0, 1)) -- Зал
	ratHole("3", Vector3.new(-29.5, 1.1, -38), Vector3.new(1, 0, 0)) -- Кухня
	ratHole("3", Vector3.new(10, 1.1, 44.5), Vector3.new(0, 0, -1)) -- Бар
	ratHole("4", Vector3.new(-59.5, 1.1, -40), Vector3.new(1, 0, 0)) -- Кабинет
	ratHole("4", Vector3.new(99.5, 1.1, -38), Vector3.new(-1, 0, 0)) -- Гараж

	-- ---------- Где может появиться ЗОЛОТОЙ СЫР (чем сложнее добраться, тем лучше) ----------
	for _, pos in ipairs({
		{ -14, 4.3, -42.5 }, -- на кухонной стойке
		{ -45, 8.9, 43 }, -- на верхней полке склада
		{ -8, 8.9, 44 }, -- на полке в баре
		{ 22, 0.9, -35 }, -- под столиком в зале
		{ -50, 3.7, -41.5 }, -- на столе в кабинете
		{ 40, 0.9, 43 }, -- в туалетной кабинке
		{ 84, 8.6, -28 }, -- на крыше фургона
		{ 84, 8.9, 43 }, -- на верхней полке морозилки
		{ -38, 6.6, 35 }, -- на крыше клетки
		{ 97.5, 8.9, -2 }, -- на полке в гараже
	}) do
		marker("GoldenSpot", Vector3.new(pos[1], pos[2], pos[3]))
	end

	-- ---------- Точки патруля повара-робота ----------
	for _, pos in ipairs({ { -45, -25 }, { -45, 20 }, { -10, -15 }, { -5, 28 }, { 40, 28 }, { 35, -12 }, { 25, -40 }, { 80, -10 }, { 70, -35 }, { 80, 30 } }) do
		marker("PatrolPoint", Vector3.new(pos[1], 3, pos[2]))
	end

	local restaurant = map

	-- ---------- ЛОББИ (отдельная папка) ----------
	map = newMap("Lobby")
	-- светлый деревянный пол + клетчатый коврик у точки появления
	block("LobbyFloor", Vector3.new(60, 1, 50), Vector3.new(0, 0, 115), Color3.fromRGB(185, 140, 95), Enum.Material.WoodPlanks)
	for i = 0, 5 do
		for j = 0, 3 do
			local white = (i + j) % 2 == 0
			decor(block("Rug", Vector3.new(3, 0.1, 3), Vector3.new(-7.5 + i * 3, 0.55, 107.5 + j * 3), white and C.white or Color3.fromRGB(220, 60, 60), Enum.Material.Fabric))
		end
	end
	-- 🌱 трава под всем миром: вместо чёрной бездны — зелёный сад
	local ground = workspace:FindFirstChild("Baseplate")
	if not (ground and ground:IsA("BasePart") and ground.Size.X >= 500) then
		ground = block("Ground", Vector3.new(1400, 2, 1400), Vector3.new(0, -1, -100), C.green, Enum.Material.Grass, workspace)
	end
	ground.Color = Color3.fromRGB(95, 175, 85)
	ground.Material = Enum.Material.Grass
	for _, child in ipairs(ground:GetChildren()) do
		if child:IsA("Texture") or child:IsA("Decal") then
			child:Destroy() -- убираем серую сетку шаблона
		end
	end

	-- 🌳 живая изгородь по краям + НЕВИДИМАЯ стена до неба: из лобби не уйти и не упасть
	local HEDGE = Color3.fromRGB(60, 145, 65)
	for _, side in ipairs({ -1, 1 }) do
		block("Hedge", Vector3.new(2, 4, 54), Vector3.new(31 * side, 2.5, 115), HEDGE, Enum.Material.Grass)
		block("Hedge", Vector3.new(64, 4, 2), Vector3.new(0, 2.5, 115 + 26 * side), HEDGE, Enum.Material.Grass)
		barrier(block("LobbyBarrier", Vector3.new(2, 150, 54), Vector3.new(31 * side, 75, 115)))
		barrier(block("LobbyBarrier", Vector3.new(64, 150, 2), Vector3.new(0, 75, 115 + 26 * side)))
	end
	-- цветы на изгороди
	local FLOWERS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 120, 255) }
	local n = 0
	for z = 90, 140, 4 do
		for _, side in ipairs({ -1, 1 }) do
			n = n + 1
			decor(ball("Flower", 0.9, Vector3.new(31 * side, 4.7, z), FLOWERS[n % #FLOWERS + 1], Enum.Material.SmoothPlastic))
		end
	end
	for x = -28, 28, 4 do
		for _, side in ipairs({ -1, 1 }) do
			n = n + 1
			decor(ball("Flower", 0.9, Vector3.new(x, 4.7, 115 + 26 * side), FLOWERS[n % #FLOWERS + 1], Enum.Material.SmoothPlastic))
		end
	end

	-- 🏮 столбы с фонарями по углам
	local corners = { { -31, 89 }, { 31, 89 }, { -31, 141 }, { 31, 141 } }
	for _, c in ipairs(corners) do
		block("CornerPost", Vector3.new(1.5, 11, 1.5), Vector3.new(c[1], 5.5, c[2]), C.darkWood, Enum.Material.Wood)
		local lamp = block("CornerLamp", Vector3.new(2, 2, 2), Vector3.new(c[1], 11.8, c[2]), Color3.fromRGB(255, 225, 150), Enum.Material.Neon)
		local pl = Instance.new("PointLight")
		pl.Range = 26
		pl.Brightness = 0.7
		pl.Color = Color3.fromRGB(255, 220, 160)
		pl.Parent = lamp
	end
	-- 🎉 гирлянды из разноцветных лампочек между углами (провисают дугой)
	local BULBS = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 210, 60), Color3.fromRGB(80, 230, 110), Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 120, 220) }
	local b = 0
	for i = 1, 4 do
		local a = corners[({ 1, 2, 4, 3 })[i]]
		local c = corners[({ 2, 4, 3, 1 })[i]]
		local from, to = Vector3.new(a[1], 11, a[2]), Vector3.new(c[1], 11, c[2])
		local count = math.floor((to - from).Magnitude / 2.5)
		for k = 1, count - 1 do
			local f = k / count
			local pos = from + (to - from) * f - Vector3.new(0, math.sin(f * math.pi) * 2.5, 0)
			b = b + 1
			local bulb = decor(ball("FairyLight", 0.6, pos, BULBS[b % #BULBS + 1], Enum.Material.Neon))
			if b % 6 == 0 then
				local pl = Instance.new("PointLight")
				pl.Range = 10
				pl.Brightness = 0.5
				pl.Color = bulb.Color
				pl.Parent = bulb
			end
		end
	end
	-- фонари внутри лобби (ярче, чем раньше)
	for _, pos in ipairs({ { -22, 98 }, { 22, 98 }, { -22, 132 }, { 22, 132 } }) do
		block("LampPost", Vector3.new(0.5, 8, 0.5), Vector3.new(pos[1], 4.5, pos[2]), C.black, Enum.Material.Metal)
		local bulb = ball("LampBulb", 1.2, Vector3.new(pos[1], 9, pos[2]), Color3.fromRGB(255, 220, 150), Enum.Material.Neon)
		local pl = Instance.new("PointLight")
		pl.Range = 24
		pl.Brightness = 0.8
		pl.Color = Color3.fromRGB(255, 210, 160)
		pl.Parent = bulb
	end
	-- 🌳 деревья
	for _, pos in ipairs({ { -26, 93 }, { -26, 137 } }) do
		cyl("TreeTrunk", 6, 1.4, Vector3.new(pos[1], 3.5, pos[2]), C.darkWood, Enum.Material.Wood)
		decor(ball("TreeLeaves", 6, Vector3.new(pos[1], 8, pos[2]), Color3.fromRGB(70, 165, 70), Enum.Material.Grass))
		decor(ball("TreeLeaves", 4, Vector3.new(pos[1] + 1.5, 10.5, pos[2] + 0.5), Color3.fromRGB(90, 185, 80), Enum.Material.Grass))
	end
	-- ☂️ столики кафе с зонтиками
	local UMBRELLA = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 200, 60) }
	for i, pos in ipairs({ { -15, 95 }, { -16, 129 }, { -15, 118 } }) do
		local x, z = pos[1], pos[2]
		cyl("CafeTable", 0.3, 4, Vector3.new(x, 2.6, z), C.white, Enum.Material.SmoothPlastic)
		cyl("CafeTableLeg", 2.2, 0.4, Vector3.new(x, 1.5, z), C.black, Enum.Material.Metal)
		decor(cyl("UmbrellaPole", 5, 0.25, Vector3.new(x, 5.2, z), C.white, Enum.Material.Metal))
		decor(cyl("Umbrella", 0.4, 7, Vector3.new(x, 7.6, z), UMBRELLA[i], Enum.Material.Fabric))
		decor(cyl("Umbrella", 0.5, 4, Vector3.new(x, 8, z), C.white, Enum.Material.Fabric))
		decor(ball("UmbrellaTop", 0.7, Vector3.new(x, 8.4, z), UMBRELLA[i], Enum.Material.SmoothPlastic))
		for _, dx in ipairs({ -3, 3 }) do
			block("CafeChair", Vector3.new(1.6, 0.3, 1.6), Vector3.new(x + dx, 1.6, z), UMBRELLA[i], Enum.Material.SmoothPlastic)
			block("CafeChairLeg", Vector3.new(0.3, 1.2, 0.3), Vector3.new(x + dx, 0.9, z), C.black, Enum.Material.Metal)
			block("CafeChairBack", Vector3.new(0.3, 1.6, 1.6), Vector3.new(x + dx + (dx > 0 and 0.7 or -0.7), 2.5, z), UMBRELLA[i], Enum.Material.SmoothPlastic)
		end
	end
	-- 🎈 воздушные шарики
	local BALLOONS = { Color3.fromRGB(255, 80, 90), Color3.fromRGB(255, 210, 50), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 130, 220), Color3.fromRGB(120, 230, 120) }
	for ci, c in ipairs({ { -17.5, 105 }, { 17.5, 105 }, { -17, 137 }, { 16, 138 } }) do
		for k = 1, 3 do
			local off = Vector3.new((k - 2) * 0.9, 7 + (k % 2) * 0.8, ((k + ci) % 2) * 0.6)
			local pos = Vector3.new(c[1], 0, c[2]) + off
			decor(ball("Balloon", 1.6, pos, BALLOONS[(ci + k) % #BALLOONS + 1], Enum.Material.SmoothPlastic))
			decor(block("BalloonString", Vector3.new(0.05, pos.Y - 2.6, 0.05), Vector3.new(pos.X, (pos.Y + 2.6) / 2 - 0.4, pos.Z), C.white))
		end
	end

	-- гигантский сыр
	local bigCheese = block("BigCheese", Vector3.new(8, 5, 8), CFrame.new(0, 3, 128) * CFrame.Angles(0, math.rad(30), 0), C.cheese)
	local wedge = Instance.new("SpecialMesh")
	wedge.MeshType = Enum.MeshType.Wedge
	wedge.Parent = bigCheese
	for _, pos in ipairs({ { -1.5, 2.5, 127 }, { 1.2, 1.8, 129 }, { 0, 3.8, 128.5 } }) do
		decor(ball("CheeseHole", 1.2, Vector3.new(pos[1], pos[2], pos[3]), Color3.fromRGB(220, 170, 40)))
	end
	for _, x in ipairs({ -14, 14 }) do
		block("Bench", Vector3.new(6, 0.5, 2), Vector3.new(x, 2, 105), C.wood, Enum.Material.Wood)
		block("BenchLeg", Vector3.new(0.4, 1.5, 1.8), Vector3.new(x - 2.5, 1, 105), C.darkWood)
		block("BenchLeg", Vector3.new(0.4, 1.5, 1.8), Vector3.new(x + 2.5, 1, 105), C.darkWood)
	end
	label("🐀 КРЫСИНЫЙ ПЕРЕПОЛОХ 👨‍🍳", Vector3.new(0, 12, 100), 520, 120, "🐀 RAT RUCKUS 👨‍🍳")
	label("🛒 Магазин и голосование — внизу экрана", Vector3.new(0, 8.5, 100), 360, 80, "🛒 Shop and map vote — bottom of the screen")
	-- доска «Как играть»
	for _, x in ipairs({ -13, 13 }) do
		block("BoardPost", Vector3.new(0.8, 13, 0.8), Vector3.new(x, 6.5, 138.8), C.darkWood, Enum.Material.Wood)
	end
	sign(Vector3.new(0, 7.5, 138.3), Vector3.new(0, 0, -1), 26, 11, Locale.t("ru", "howto_board"), Color3.fromRGB(40, 25, 50), Color3.fromRGB(255, 240, 210), Locale.t("en", "howto_board"))
	for _, x in ipairs({ -6, 0, 6 }) do
		marker("LobbySpawn", Vector3.new(x, 2, 112))
	end

	-- 🏆 Таблица лидеров (глобальная, обновляет ExtrasService)
	local boardCf = CFrame.lookAt(Vector3.new(-29.3, 7.5, 117), Vector3.new(-28.3, 7.5, 117))
	block("LeaderFrame", Vector3.new(17, 12.5, 0.4), boardCf * CFrame.new(0, 0, 0.25), C.darkWood, Enum.Material.Wood)
	local board = block("Leaderboard", Vector3.new(16, 11.5, 0.3), boardCf, Color3.fromRGB(30, 20, 40))
	board:AddTag("Leaderboard")
	local lbGui = Instance.new("SurfaceGui")
	lbGui.Face = Enum.NormalId.Front
	lbGui.LightInfluence = 0
	lbGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	lbGui.PixelsPerStud = 40
	lbGui.Parent = board
	local lbList = Instance.new("UIListLayout")
	lbList.SortOrder = Enum.SortOrder.LayoutOrder
	lbList.Parent = lbGui
	local lbTitle = Instance.new("TextLabel")
	lbTitle.Name = "Title"
	lbTitle.LayoutOrder = 0
	lbTitle.Size = UDim2.new(1, 0, 0.14, 0)
	lbTitle.BackgroundTransparency = 1
	lbTitle.TextScaled = true
	lbTitle.Font = Enum.Font.FredokaOne
	lbTitle.TextColor3 = Color3.fromRGB(255, 215, 80)
	lbTitle.Text = Locale.t("ru", "leaderboard_title")
	lbTitle:SetAttribute("ru", Locale.t("ru", "leaderboard_title"))
	lbTitle:SetAttribute("en", Locale.t("en", "leaderboard_title"))
	lbTitle:AddTag("Localized")
	lbTitle.Parent = lbGui
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0.086, 0)
		row.BackgroundTransparency = 1
		row.TextScaled = true
		row.Font = Enum.Font.FredokaOne
		row.TextColor3 = Color3.new(1, 1, 1)
		row.Text = ""
		row.Parent = lbGui
	end

	-- 🧗 Паркур: лестница из платформ, наверху золотой сыр
	local steps = { { 25, 2.5, 95 }, { 25, 5, 101 }, { 20, 7.5, 106 }, { 25, 10, 111 }, { 20, 12.5, 116 }, { 25, 15, 121 }, { 20, 17.5, 126 }, { 25, 20, 131 }, { 19, 22.5, 135 }, { 13, 25, 135 }, { 7, 27.5, 135 } }
	for i, st in ipairs(steps) do
		local size = (i == #steps) and Vector3.new(6, 1, 6) or Vector3.new(4, 1, 4)
		block("ObbyStep", size, Vector3.new(st[1], st[2], st[3]), Color3.fromHSV(i / #steps, 0.65, 1), Enum.Material.SmoothPlastic)
		decor(block("ObbyGlow", Vector3.new(size.X + 0.2, 0.15, size.Z + 0.2), Vector3.new(st[1], st[2] - 0.45, st[3]), Color3.fromHSV(i / #steps, 0.8, 1), Enum.Material.Neon))
	end
	local trophy = block("ObbyCheese", Vector3.new(2.4, 1.6, 2.4), Vector3.new(7, 29, 135), Color3.fromRGB(255, 200, 40), Enum.Material.Neon)
	trophy.CanCollide = false
	trophy:AddTag("ObbyReward")
	local tl = Instance.new("PointLight")
	tl.Color = Color3.fromRGB(255, 210, 80)
	tl.Range = 16
	tl.Brightness = 2
	tl.Parent = trophy
	local tsp = Instance.new("Sparkles")
	tsp.SparkleColor = Color3.fromRGB(255, 230, 120)
	tsp.Parent = trophy
	label(Locale.t("ru", "obby_sign"), Vector3.new(25, 6, 92), 260, 80, Locale.t("en", "obby_sign"))

	-- Стандартный SpawnLocation из шаблона стоит внутри ресторана — переносим в лобби
	for _, s in ipairs(workspace:GetDescendants()) do
		if s:IsA("SpawnLocation") then
			s.CFrame = CFrame.new(0, 1, 120)
		end
	end

	-- Ночное освещение и атмосфера (настройки в Config.Lighting.Night)
	local N = Config.Lighting.Night
	Lighting.ClockTime = N.ClockTime
	Lighting.Brightness = N.Brightness
	Lighting.Ambient = N.Ambient
	Lighting.OutdoorAmbient = N.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = N.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = 0.3
	local atm = ensureEffect("Atmosphere", "RatAtmosphere")
	atm.Density = N.Density
	atm.Offset = 0.1
	atm.Color = N.AtmColor
	atm.Decay = N.Decay
	atm.Glare = 0
	atm.Haze = N.Haze
	local bloom = ensureEffect("BloomEffect", "RatBloom")
	bloom.Intensity = N.BloomIntensity
	bloom.Size = 30
	bloom.Threshold = N.BloomThreshold
	local cc = ensureEffect("ColorCorrectionEffect", "RatColor")
	cc.Brightness = 0.02
	cc.Contrast = 0.12
	cc.Saturation = 0.15
	cc.TintColor = Color3.fromRGB(255, 240, 225)

	local lobby = map
	local pizzeria = buildPizzeria()
	restaurant.Parent = workspace
	lobby.Parent = workspace
	pizzeria.Parent = workspace
	map = restaurant
	print("[TestMapBuilder] Ресторан и пиццерия построены! Свою карту положи в Workspace как папку Map.")
end

return TestMapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- MonetizationService (ModuleScript) — ServerScriptService
-- Донат за Robux: Game Passes (VIP, ×2 сыр, все классы, второй шанс, бесконечный бег,
-- ×2 опыт, мега-танцы, пропуск повара) и Developer Products (пачки сыра и т.д.).
-- Как настроить:
--   1) create.roblox.com → твоя игра → Monetization → Passes → Create a Pass (по одному на каждый пропуск)
--   2) Monetization → Developer Products → Create (пачки сыра)
--   3) Скопируй ID каждого товара в Config (GamePasses и Products)

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))

local MonetizationService = {}
local ctx, DataService
local owned = {} -- [игрок] = { VIP = true, DoubleCheese = true }

local function passKeyById(id)
	for key, passId in pairs(Config.GamePasses) do
		if passId == id and passId > 0 then
			return key
		end
	end
	return nil
end

local function productById(id)
	for _, p in ipairs(Config.Products) do
		if p.Id == id and p.Id > 0 then
			return p
		end
	end
	-- товары «любой предмет за Robux»
	for tier, t in pairs(Config.ItemTiers) do
		if t.Id == id and t.Id > 0 then
			return { Kind = "item", Tier = tier, Coins = t.Coins, Price = t.Price }
		end
	end
	return nil
end

function MonetizationService.hasPass(player, key)
	return owned[player] ~= nil and owned[player][key] == true
end

-- Множитель сыра: VIP +1, ×2 Сыр +1 (вместе ×3)
function MonetizationService.coinMultiplier(player)
	local m = 1
	if MonetizationService.hasPass(player, "VIP") then
		m = m + 1
	end
	if MonetizationService.hasPass(player, "DoubleCheese") then
		m = m + 1
	end
	return m
end

-- спасибо-сообщение за каждый пропуск
local THANKS = {
	VIP = "thanks_vip",
	DoubleCheese = "thanks_double",
	AllClasses = "thanks_classes",
	SecondChance = "thanks_luck",
	InfiniteStamina = "thanks_stamina",
	DoubleXP = "thanks_xp",
	MegaDances = "thanks_dances",
	ChefPass = "thanks_chefpass",
}

local function applyPerks(player)
	-- атрибут с именем пропуска = true, если он куплен (его видят HUD и другие скрипты)
	for key in pairs(Config.GamePasses) do
		player:SetAttribute(key, MonetizationService.hasPass(player, key))
	end
	local isVip = MonetizationService.hasPass(player, "VIP")
	player:SetAttribute("CoinMult", MonetizationService.coinMultiplier(player))
	if isVip then
		DataService.grantHat(player, "vipcrown")
		DataService.grantTrail(player, "galaxy")
		DataService.grantPet(player, "goldhamster")
	end
	if MonetizationService.hasPass(player, "AllClasses") then
		DataService.grantAllClasses(player)
	end
end

function MonetizationService.load(player)
	owned[player] = {}
	for key, id in pairs(Config.GamePasses) do
		if id > 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and has then
				owned[player][key] = true
			end
		end
	end
	applyPerks(player)
end

-- Покупка пропуска прямо в игре
local function onPassPurchased(player, passId, purchased)
	if not purchased then
		return
	end
	local key = passKeyById(passId)
	if not key or not owned[player] then
		return
	end
	owned[player][key] = true
	applyPerks(player)
	ctx.notifyPlayer(player, "good", THANKS[key] or "thanks_double")
	ctx.fxPlayer(player, "purchase")
end

-- Покупка товара (Developer Product). Roblox вызывает это, пока мы не ответим PurchaseGranted.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById(receipt.ProductId)
	if not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local kind = product.Kind or "cheese"
	local escapeNow = false
	local gotItem, gotCat = nil, nil
	local ok, already = DataService.processPurchase(player, receipt.PurchaseId, function(data)
		if kind == "cheese" then
			data.Coins = data.Coins + product.Coins
		elseif kind == "chef" then
			data.ChefNext = true
		elseif kind == "item" then
			gotItem, gotCat = DataService.grantPendingItem(data, product.Tier)
			if not gotItem then
				data.Coins = data.Coins + product.Coins -- предмет уже был: выдаём сыр
			end
		elseif kind == "escape" then
			if ctx.canEscape(player) then
				escapeNow = true
			else
				data.Coins = data.Coins + (product.Coins or 100) -- уже свободен: компенсация сыром
			end
		end
	end)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not already then
		if kind == "cheese" then
			ctx.notifyPlayer(player, "good", "thanks_cheese", product.Coins)
			ctx.fxPlayer(player, "coins", product.Coins, "💎")
		elseif kind == "chef" then
			ctx.notifyPlayer(player, "good", "bechef_done")
		elseif kind == "item" then
			if gotItem then
				local item = gotItem
				ctx.notifyPlayer(player, "good", "bought", item.Icon, function(lang)
					return Locale.itemName(lang, item)
				end)
				if gotCat == "pet" then
					ctx.refreshPet(player)
				elseif gotCat == "class" then
					ctx.refreshClass(player)
				else
					ctx.refreshHat(player)
				end
			else
				ctx.notifyPlayer(player, "good", "item_fallback", product.Coins)
			end
		elseif kind == "escape" then
			if escapeNow then
				ctx.escape(player)
			else
				ctx.notifyPlayer(player, "good", "escape_comp", product.Coins or 100)
			end
		end
		ctx.fxPlayer(player, "purchase")
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.forget(player)
	owned[player] = nil
end

function MonetizationService.init(context, dataService)
	ctx = context
	DataService = dataService
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SetPendingItem").OnServerEvent:Connect(function(player, category, itemId)
		DataService.setPending(player, category, itemId)
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[-- PetService (ModuleScript) — ServerScriptService
-- Питомцы 🐹: летают/бегают за игроком и дают бонус к сыру.
-- Покупаются за сыр во вкладке «🐹 Питомцы» магазина.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local PetService = {}
local DataService
local pets = {} -- [игрок] = { model, info, pos, phase }
local folder

local WHITE = Color3.fromRGB(250, 250, 250)
local BLACK = Color3.fromRGB(20, 20, 20)

local function addPart(model, name, size, offset, color, shape, material, ellipsoid)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.CFrame = offset
	p.Parent = model
	return p
end

-- Модель питомца строится вокруг точки (0,0,0); перед смотрит по -Z
local function buildModel(info)
	local model = Instance.new("Model")
	model.Name = "Pet_" .. info.Id
	local c = info.Color or WHITE
	local body
	local function eyes(y, z, spread, size)
		for _, s in ipairs({ -1, 1 }) do
			addPart(model, "Eye", Vector3.new(size, size, size), CFrame.new(spread * s, y, z), BLACK, Enum.PartType.Ball)
			addPart(model, "Shine", Vector3.new(size * 0.35, size * 0.35, size * 0.35), CFrame.new(spread * s + size * 0.15, y + size * 0.2, z - size * 0.35), WHITE, Enum.PartType.Ball, Enum.Material.Neon)
		end
	end
	if info.Id == "roach" then
		body = addPart(model, "Body", Vector3.new(1.0, 0.45, 1.5), CFrame.new(0, 0, 0), c, nil, nil, true)
		addPart(model, "Head", Vector3.new(0.6, 0.4, 0.5), CFrame.new(0, 0.02, -0.85), c:Lerp(BLACK, 0.3), nil, nil, true)
		for _, s in ipairs({ -1, 1 }) do
			addPart(model, "Antenna", Vector3.new(0.05, 0.05, 1.0), CFrame.new(0.15 * s, 0.25, -1.4) * CFrame.Angles(0.5, 0.3 * s, 0), BLACK)
		end
		eyes(0.12, -1.05, 0.18, 0.14)
	elseif info.Id == "pigeon" or info.Id == "dragon" then
		body = addPart(model, "Body", Vector3.new(1.0, 0.9, 1.4), CFrame.new(0, 0, 0), c, nil, nil, true)
		addPart(model, "Head", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, 0.45, -0.7), c, Enum.PartType.Ball)
		eyes(0.55, -0.98, 0.18, 0.15)
		local beakColor = info.Id == "pigeon" and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(240, 230, 200)
		addPart(model, "Beak", Vector3.new(0.2, 0.15, 0.35), CFrame.new(0, 0.38, -1.12), beakColor)
		for _, s in ipairs({ -1, 1 }) do
			addPart(model, "Wing", Vector3.new(1.1, 0.1, 0.8), CFrame.new(0.75 * s, 0.25, 0) * CFrame.Angles(0, 0, -0.35 * s), c:Lerp(WHITE, 0.25))
			if info.Id == "dragon" then
				addPart(model, "Horn", Vector3.new(0.12, 0.35, 0.12), CFrame.new(0.2 * s, 0.9, -0.6) * CFrame.Angles(-0.3, 0, 0.2 * s), Color3.fromRGB(255, 240, 200))
			end
		end
		if info.Id == "dragon" then
			addPart(model, "Tail", Vector3.new(0.2, 0.2, 1.0), CFrame.new(0, -0.05, 1.0) * CFrame.Angles(0.3, 0, 0), c)
		end
	elseif info.Id == "slime" then
		body = addPart(model, "Body", Vector3.new(1.4, 1.2, 1.4), CFrame.new(0, 0, 0), c, nil, Enum.Material.Glass, true)
		body.Transparency = 0.2
		eyes(0.2, -0.62, 0.25, 0.2)
		for _, pos in ipairs({ { 0.4, 0.4, 0.3 }, { -0.35, -0.1, 0.5 } }) do
			addPart(model, "Hole", Vector3.new(0.25, 0.25, 0.25), CFrame.new(pos[1], pos[2], pos[3]), c:Lerp(BLACK, 0.25), Enum.PartType.Ball)
		end
	else -- хомяк и золотой хомяк
		local material = info.Id == "goldhamster" and Enum.Material.Metal or nil
		body = addPart(model, "Body", Vector3.new(1.3, 1.15, 1.3), CFrame.new(0, 0, 0), c, Enum.PartType.Ball, material)
		addPart(model, "Belly", Vector3.new(0.9, 0.75, 0.3), CFrame.new(0, -0.15, -0.55), WHITE, nil, nil, true)
		for _, s in ipairs({ -1, 1 }) do
			addPart(model, "Ear", Vector3.new(0.35, 0.35, 0.35), CFrame.new(0.42 * s, 0.55, -0.05), c:Lerp(Color3.fromRGB(255, 160, 180), 0.4), Enum.PartType.Ball)
			addPart(model, "Cheek", Vector3.new(0.3, 0.25, 0.25), CFrame.new(0.42 * s, -0.05, -0.5), Color3.fromRGB(255, 170, 180), Enum.PartType.Ball)
		end
		eyes(0.15, -0.6, 0.22, 0.17)
		addPart(model, "Nose", Vector3.new(0.12, 0.1, 0.1), CFrame.new(0, 0.0, -0.66), Color3.fromRGB(255, 120, 150), Enum.PartType.Ball)
	end
	if info.Id == "goldhamster" or info.Id == "dragon" then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = info.Color
		sp.Parent = body
	end
	model.PrimaryPart = body
	return model
end

function PetService.bonus(player)
	return DataService.getPet(player).Bonus or 0
end

local function remove(player)
	local entry = pets[player]
	if entry then
		entry.model:Destroy()
		pets[player] = nil
	end
end

-- Пересоздать питомца (после покупки/смены или появления персонажа)
function PetService.refresh(player)
	local info = DataService.getPet(player)
	local entry = pets[player]
	if entry and entry.info.Id == info.Id then
		return
	end
	remove(player)
	if info.Id == "none" then
		return
	end
	local model = buildModel(info)
	model.Parent = folder
	pets[player] = { model = model, info = info, pos = nil, phase = math.random() * 6 }
end

local function step(dt)
	for player, entry in pairs(pets) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not hum or not player.Parent then
			entry.model:PivotTo(CFrame.new(0, -500, 0))
		else
			entry.phase = entry.phase + dt
			local ground = root.Position.Y - root.Size.Y / 2 - hum.HipHeight
			local height
			if entry.info.Flying then
				height = 3.2 + math.sin(entry.phase * 3) * 0.35
			else
				height = 0.6 + math.abs(math.sin(entry.phase * 6)) * 0.25
			end
			local side = root.CFrame * CFrame.new(2.6, 0, 2.2)
			local target = Vector3.new(side.Position.X, ground + height, side.Position.Z)
			local pos = entry.pos or target
			pos = pos:Lerp(target, math.clamp(dt * 8, 0, 1))
			entry.pos = pos
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.01 then
				flat = Vector3.new(0, 0, -1)
			end
			entry.model:PivotTo(CFrame.lookAt(pos, pos + flat))
		end
	end
end

function PetService.forget(player)
	remove(player)
end

function PetService.init(dataService)
	DataService = dataService
	folder = Instance.new("Folder")
	folder.Name = "Pets"
	folder.Parent = workspace
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc >= 1 / 20 then -- 20 раз в секунду достаточно
			step(acc)
			acc = 0
		end
	end)
	Players.PlayerRemoving:Connect(remove)
end

return PetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">ExtrasService</string><ProtectedString name="Source"><![CDATA[-- ExtrasService (ModuleScript) — ServerScriptService
-- То, что делает игру «залипательной»:
--   🎟️ коды (для TikTok/YouTube), 📜 ежедневные задания, 🏆 глобальная таблица побед,
--   👥 бонус за игру с друзьями, 🧗 награда за паркур в лобби, 💃 эмоции крыс.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local ExtrasService = {}
local ctx, DataService
local winsStore = nil
local nameCache = {}
local friendCache = {} -- [игрок] = { [userId] = true/false }
local lastCode = {}
local lastEmote = {}
local obbyNotified = {}

local function today()
	return math.floor(os.time() / 86400)
end

-- ===== 📜 Ежедневные задания =====
local function makeRng(seed)
	local s = seed % 2147483646 + 1
	return function(n)
		s = (s * 16807) % 2147483647
		return (s % n) + 1
	end
end

function ExtrasService.ensureQuests(player)
	local data = DataService.getData(player)
	if not data then
		return
	end
	local day = today()
	if data.Quests.Day == day and #data.Quests.List > 0 then
		return
	end
	local pick = makeRng(day * 7919 + player.UserId)
	local pool = {}
	for i, q in ipairs(Config.QuestPool) do
		pool[i] = q
	end
	local list = {}
	for _ = 1, math.min(Config.QuestsPerDay, #pool) do
		local q = table.remove(pool, pick(#pool))
		table.insert(list, { Id = q.Id, Kind = q.Kind, Goal = q.Goal, Reward = q.Reward, Progress = 0, Done = false })
	end
	data.Quests = { Day = day, List = list }
	DataService.publish(player)
end

function ExtrasService.progress(player, kind, n)
	local data = DataService.getData(player)
	if not data or not kind then
		return
	end
	ExtrasService.ensureQuests(player)
	local changed = false
	for _, q in ipairs(data.Quests.List) do
		if q.Kind == kind and not q.Done then
			q.Progress = math.min(q.Goal, q.Progress + (n or 1))
			changed = true
			if q.Progress >= q.Goal then
				q.Done = true
				data.Coins = data.Coins + q.Reward
				ctx.notifyPlayer(player, "good", "quest_done", q.Reward)
				ctx.fxPlayer(player, "coins", q.Reward, "📜")
			end
		end
	end
	if changed then
		DataService.publish(player)
	end
end

-- ===== 🎟️ Коды =====
local function onCode(player, code)
	if type(code) ~= "string" or #code > 40 then
		return
	end
	if (lastCode[player] or -10) + 1 > os.clock() then
		return -- не чаще раза в секунду
	end
	lastCode[player] = os.clock()
	local data = DataService.getData(player)
	if not data then
		return
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		ctx.notifyPlayer(player, "bad", "code_bad")
		return
	end
	if data.UsedCodes[code] then
		ctx.notifyPlayer(player, "info", "code_used")
		return
	end
	data.UsedCodes[code] = true
	data.Coins = data.Coins + reward
	DataService.publish(player)
	ctx.notifyPlayer(player, "good", "code_ok", reward)
	ctx.fxPlayer(player, "coins", reward, "🎟️")
	ctx.fxPlayer(player, "purchase")
	task.spawn(DataService.save, player)
end

-- ===== 💃 Эмоции крыс =====
local function onEmote(player, id)
	local emote = type(id) == "string" and Config.getEmote(id)
	if not emote or player:GetAttribute("Role") ~= "Rat" or player:GetAttribute("Caught") then
		return
	end
	if emote.Pass and not player:GetAttribute(emote.Pass) then
		ctx.notifyPlayer(player, "info", "dance_locked") -- 🪩 танец из пропуска
		return
	end
	if (lastEmote[player] or -100) + Config.EmoteCooldown > os.clock() then
		return
	end
	lastEmote[player] = os.clock()
	local n = (player:GetAttribute("EmoteN") or 0) + 1
	player:SetAttribute("Emote", id)
	player:SetAttribute("EmoteN", n)
	ExtrasService.progress(player, "Emote", 1)
	task.delay(emote.Duration, function()
		if player.Parent and player:GetAttribute("EmoteN") == n then
			player:SetAttribute("Emote", nil)
		end
	end)
end

-- ===== 🧗 Паркур в лобби =====
local function setupObby(part)
	part.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		local data = player and DataService.getData(player)
		if not data then
			return
		end
		if data.LastObby >= today() then
			if (obbyNotified[player] or 0) < os.clock() then
				obbyNotified[player] = os.clock() + 10
				ctx.notifyPlayer(player, "info", "obby_again")
			end
			return
		end
		data.LastObby = today()
		data.Coins = data.Coins + Config.ObbyReward
		DataService.publish(player)
		ctx.notifyPlayer(player, "good", "obby_done", Config.ObbyReward)
		ctx.fxPlayer(player, "coins", Config.ObbyReward, "🧗")
		ctx.fxPlayer(player, "levelup", 0)
	end)
end

-- ===== 👥 Друзья =====
local function areFriends(a, b)
	friendCache[a] = friendCache[a] or {}
	local known = friendCache[a][b.UserId]
	if known == nil then
		local ok, result = pcall(function()
			return a:IsFriendsWith(b.UserId)
		end)
		known = ok and result == true
		friendCache[a][b.UserId] = known
	end
	return known
end

function ExtrasService.checkFriends()
	local list = Players:GetPlayers()
	for _, p in ipairs(list) do
		local has = false
		for _, other in ipairs(list) do
			if other ~= p and (areFriends(p, other) or areFriends(other, p)) then
				has = true
			end
		end
		if has ~= (p:GetAttribute("FriendBonus") == true) then
			p:SetAttribute("FriendBonus", has)
			if has then
				ctx.notifyPlayer(p, "good", "friend_joined")
			end
		end
	end
end

-- ===== 🏆 Глобальная таблица побед =====
local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "?"
end

function ExtrasService.updateLeaderboard()
	local rows = {}
	if winsStore then
		for _, p in ipairs(Players:GetPlayers()) do
			local d = DataService.getData(p)
			if d then
				pcall(function()
					winsStore:SetAsync(tostring(p.UserId), d.Wins)
				end)
			end
		end
		local ok, pages = pcall(function()
			return winsStore:GetSortedAsync(false, Config.LeaderboardSize)
		end)
		if ok and pages then
			local okPage, page = pcall(function()
				return pages:GetCurrentPage()
			end)
			if okPage and type(page) == "table" then
				for _, entry in ipairs(page) do
					table.insert(rows, { nameOf(tonumber(entry.key) or 0), tonumber(entry.value) or 0 })
				end
			end
		end
	end
	if #rows == 0 then
		-- сохранение недоступно (Studio): показываем игроков этого сервера
		for _, p in ipairs(Players:GetPlayers()) do
			local d = DataService.getData(p)
			if d then
				table.insert(rows, { p.DisplayName, d.Wins })
			end
		end
		table.sort(rows, function(a, b)
			return a[2] > b[2]
		end)
	end
	local medals = { "🥇", "🥈", "🥉" }
	for _, board in ipairs(CollectionService:GetTagged("Leaderboard")) do
		for i = 1, Config.LeaderboardSize do
			local label = board:FindFirstChild("Row" .. i, true)
			if label then
				local r = rows[i]
				if r then
					label.Text = ("%s %s — %d 🏆"):format(medals[i] or (i .. "."), r[1], r[2])
				else
					label.Text = ""
				end
			end
		end
	end
end

-- ===== Вход и выход игроков =====
function ExtrasService.onJoin(player)
	ExtrasService.ensureQuests(player)
	ExtrasService.checkFriends()
end

function ExtrasService.onLeave(player)
	friendCache[player] = nil
	lastCode[player] = nil
	lastEmote[player] = nil
	obbyNotified[player] = nil
	task.delay(0.5, ExtrasService.checkFriends)
end

function ExtrasService.init(context, dataService)
	ctx = context
	DataService = dataService
	local ok = pcall(function()
		winsStore = DataStoreService:GetOrderedDataStore("RatRuckus_Wins_v1")
	end)
	if not ok then
		winsStore = nil
	end
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes:WaitForChild("RedeemCode").OnServerEvent:Connect(onCode)
	remotes:WaitForChild("Emote").OnServerEvent:Connect(onEmote)
	for _, part in ipairs(CollectionService:GetTagged("ObbyReward")) do
		setupObby(part)
	end
	CollectionService:GetInstanceAddedSignal("ObbyReward"):Connect(setupObby)
	task.spawn(function()
		task.wait(3)
		while true do
			ExtrasService.updateLeaderboard()
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return ExtrasService
