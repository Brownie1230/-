-- ===== Кнопки для телефона =====
local sprintHeld = false
local touchBar = make("Frame", gui, {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -170, 1, -30),
	Size = UDim2.fromOffset(180, 80),
	BackgroundTransparency = 1,
	Visible = false,
})
local sprintButton = button(touchBar, { Position = UDim2.fromOffset(90, 0), Size = UDim2.fromOffset(80, 80), Text = "🏃" }, Color3.fromRGB(100, 160, 255))
corner(sprintButton, 40)
local squeakButton = button(touchBar, { Position = UDim2.fromOffset(0, 10), Size = UDim2.fromOffset(70, 70), Text = "🐭" }, Color3.fromRGB(255, 180, 200))
local abilityButton = button(touchBar, { Position = UDim2.fromOffset(0, -84), Size = UDim2.fromOffset(80, 80), Text = "⚡" }, Color3.fromRGB(150, 220, 255))
local emoteButton = button(touchBar, { Position = UDim2.fromOffset(90, -84), Size = UDim2.fromOffset(70, 70), Text = "💃" }, Color3.fromRGB(255, 200, 120))
local function emoteUnlocked(em)
	return not em.Pass or player:GetAttribute(em.Pass) == true
end
-- танец из пропуска без пропуска → сразу предлагаем купить
local function tryEmote(em)
	if emoteUnlocked(em) then
		emoteEvent:FireServer(em.Id)
		return
	end
	local passId = Config.GamePasses[em.Pass] or 0
	if passId > 0 then
		MarketplaceService:PromptGamePassPurchase(player, passId)
	else
		addFeedLocal(L("dance_locked"))
	end
end
local emoteIndex = 0
emoteButton.Activated:Connect(function()
	for _ = 1, #Config.Emotes do
		emoteIndex = emoteIndex % #Config.Emotes + 1
		if emoteUnlocked(Config.Emotes[emoteIndex]) then
			break
		end
	end
	tryEmote(Config.Emotes[emoteIndex])
end)
corner(abilityButton, 40)
abilityButton.Activated:Connect(function()
	abilityEvent:FireServer()
end)
sprintButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		sprintHeld = true
	end
end)
sprintButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		sprintHeld = false
	end
end)
squeakButton.Activated:Connect(function()
	squeakEvent:FireServer()
end)

-- ===== Клавиатура =====
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		sprintHeld = true
	elseif processed then
		return
	elseif input.KeyCode == Enum.KeyCode.Tab then
		showTasks = not showTasks
	elseif input.KeyCode == Enum.KeyCode.Q then
		squeakEvent:FireServer()
	elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonX then
		abilityEvent:FireServer()
	else
		for _, em in ipairs(Config.Emotes) do
			if input.KeyCode == Enum.KeyCode[em.Key] then
				tryEmote(em)
			end
		end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		sprintHeld = false
	end
end)

-- ===== Сообщения =====
local feedCount = 0
local bannerId = 0

local function showBanner(msg, color)
	bannerId = bannerId + 1
	local myId = bannerId
	banner.Text = msg
	banner.TextColor3 = color or YELLOW
	banner.Visible = true
	popIn(banner)
	task.delay(4, function()
		if bannerId == myId then
			banner.Visible = false
		end
	end)
end

local function addFeed(msg, kind)
	feedCount = feedCount + 1
	local item = text(feed, {
		LayoutOrder = feedCount,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 18,
		TextWrapped = true,
		TextColor3 = KIND_COLORS[kind] or WHITE,
		Text = msg,
	})
	item.BackgroundTransparency = 0.25
	item.BackgroundColor3 = PANEL
	corner(item, 8)
	make("UIPadding", item, {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})

	local items = {}
	for _, c in ipairs(feed:GetChildren()) do
		if c:IsA("TextLabel") then
			table.insert(items, c)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #items > 4 do
		table.remove(items, 1):Destroy()
	end

	task.delay(6, function()
		if item.Parent then
			local tween = TweenService:Create(item, TweenInfo.new(0.6), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			item:Destroy()
		end
	end)
end

addFeedLocal = function(msg)
	addFeed(msg, "info")
end

notifyEvent.OnClientEvent:Connect(function(msg, kind)
	if kind == "banner" then
		showBanner(msg)
	end
	addFeed(msg, kind)
end)

-- Всплывающие "+5 🧀"
local function coinPopup(amount, reason)
	local pop = text(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 312, 1, -60),
		Size = UDim2.fromOffset(240, 34),
		TextColor3 = YELLOW,
		TextStrokeTransparency = 0.2,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = ("+%d 🧀 %s"):format(amount, reason or ""),
		ZIndex = 7,
	})
	popIn(pop)
	local tween = TweenService:Create(pop, TweenInfo.new(1.6), {
		Position = UDim2.new(0, 312, 1, -140),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	tween:Play()
	tween.Completed:Connect(function()
		pop:Destroy()
	end)
end

local function showResults(data)
	results.Visible = true
	popIn(results)
	if data.won then
		resTitle.Text = L("victory")
		resTitle.TextColor3 = GREEN
	else
		resTitle.Text = L("defeat")
		resTitle.TextColor3 = RED
	end
	if data.winner == "Rats" then
		resWinner.Text = L("rats_won")
	else
		resWinner.Text = L("chef_won")
	end
	resReason.Text = data.reason or ""
	if data.mvp and data.mvp ~= "" then
		resMvp.Text = L("mvp", data.mvp, data.mvpScore or 0)
	else
		resMvp.Text = ""
	end
	resCoins.Text = L("round_coins", data.coins or 0)
end

fxEvent.OnClientEvent:Connect(function(kind, a, b)
	if kind == "coins" then
		coinPopup(a, b)
	elseif kind == "results" and type(a) == "table" then
		showResults(a)
	end
end)

-- ===== Подсказки и задания =====
local function role()
	return player:GetAttribute("Role") or "Lobby"
end

local function sortedStations()
	local list = Config.taggedInMap("Sabotage")
	table.sort(list, function(a, b)
		return (a:GetAttribute("TaskName") or a.Name) < (b:GetAttribute("TaskName") or b.Name)
	end)
	return list
end

local MINI_ICONS = { Wires = "🔌", Mash = "🦷", Code = "🔢", Timing = "⏱" }

local function refreshPrompts()
	local r = role()
	local lg = lang()
	local caught = player:GetAttribute("Caught") == true
	local busy = player:GetAttribute("LocalFreeze") == true
	local cls = Config.getClass(player:GetAttribute("Class") or "normal") or Config.Classes[1]
	for _, st in ipairs(CollectionService:GetTagged("Sabotage")) do
		local here = Config.inActiveMap(st)
		local broken = st:GetAttribute("Broken") == true
		local sab = st:FindFirstChild("SabotagePrompt")
		local rep = st:FindFirstChild("RepairPrompt")
		local name = Locale.taskName(lg, st)
		if sab then
			sab.Enabled = here and r == "Rat" and not caught and not broken and not busy
			if not st:GetAttribute("MiniGame") then
				-- «Сильная» крыса держит E меньше
				sab.HoldDuration = (st:GetAttribute("HoldTime") or Config.DefaultSabotageTime) / (cls.SabotageMult or 1)
			end
			sab.ActionText = L("prompt_sabotage")
			sab.ObjectText = name
		end
		if rep then
			rep.Enabled = here and r == "Chef" and broken
			rep.ActionText = L("prompt_repair")
			rep.ObjectText = name
		end
		-- подсветка: крысам — что можно сломать, повару — что надо чинить
		local hl = st:FindFirstChild("TaskHighlight")
		if not hl then
			hl = make("Highlight", st, {
				Name = "TaskHighlight",
				FillTransparency = 1,
				DepthMode = Enum.HighlightDepthMode.Occluded,
			})
		end
		hl.Enabled = here and ((r == "Rat" and not broken) or (r == "Chef" and broken))
		if r == "Chef" then
			hl.OutlineColor = Color3.fromRGB(255, 80, 80)
		else
			hl.OutlineColor = YELLOW
		end
	end
	for _, cage in ipairs(CollectionService:GetTagged("Cage")) do
		local fp = cage:FindFirstChild("FreePrompt")
		if fp then
			fp.Enabled = Config.inActiveMap(cage) and r == "Rat" and not caught
			fp.ActionText = L("prompt_free")
			fp.ObjectText = L("cage")
		end
	end
	-- таблички на карте
	for _, label in ipairs(CollectionService:GetTagged("Localized")) do
		local t = label:GetAttribute(lg)
		if t and label:IsA("TextLabel") then
			label.Text = t
		end
	end
end

local function refreshTasks()
	local r = role()
	local lg = lang()
	local lines = {}
	if r == "Rat" then
		table.insert(lines, "<b>" .. L("tasks_rat") .. "</b>")
		for _, st in ipairs(sortedStations()) do
			local name = Locale.taskName(lg, st)
			local icon = MINI_ICONS[st:GetAttribute("MiniGame") or ""] or "✋"
			if st:GetAttribute("Broken") then
				table.insert(lines, '<font color="#7CFC8A">✔ <s>' .. name .. "</s></font>")
			else
				table.insert(lines, icon .. " " .. name)
			end
		end
	elseif r == "Chef" then
		table.insert(lines, "<b>" .. L("tasks_chef") .. "</b>")
		local any = false
		for _, st in ipairs(sortedStations()) do
			if st:GetAttribute("Broken") then
				any = true
				table.insert(lines, '<font color="#FF8A80">• ' .. Locale.taskName(lg, st) .. "</font>")
			end
		end
		if not any then
			table.insert(lines, L("all_ok"))
		end
	end
	table.insert(lines, '<font size="13" color="#AAAAAA">' .. L("tab_hide") .. "</font>")
	tasksLabel.Text = table.concat(lines, "\n")
end

local function fmtTime(t)
	return string.format("%d:%02d", math.floor(t / 60), t % 60)
end

local function showRoleCard()
	local r = role()
	if r == "Rat" then
		roleCardTitle.Text = L("you_rat")
		roleCardTitle.TextColor3 = YELLOW
		roleCardGoal.Text = L("goal_rat") .. "  " .. L("map_is", activeMapName())
	elseif r == "Chef" then
		roleCardTitle.Text = L("you_chef")
		roleCardTitle.TextColor3 = Color3.fromRGB(255, 140, 120)
		roleCardGoal.Text = L("goal_chef") .. "  " .. L("map_is", activeMapName())
	else
		roleCard.Visible = false
		return
	end
	roleCard.Visible = true
	popIn(roleCard)
end

-- ===== Главный цикл интерфейса =====
local stamina = Config.StaminaMax
local exhausted = false
local accum = 0
local lastState = nil
local lastTime = nil

RunService.Heartbeat:Connect(function(dt)
	local r = role()
	local caught = player:GetAttribute("Caught") == true
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local state = ReplicatedStorage:GetAttribute("State") or "Lobby"
	local t = ReplicatedStorage:GetAttribute("TimeLeft") or 0

	-- бег и скорость
	if (r == "Rat" or r == "Chef") and hum then
		local base = player:GetAttribute("BaseSpeed") or 0
		local mult = Config.SprintMultiplier
		if r == "Chef" then
			mult = Config.ChefSprintMultiplier
		end
		local moving = hum.MoveDirection.Magnitude > 0.1
		if stamina <= 0 then
			exhausted = true
		elseif stamina > 30 then
			exhausted = false
		end
		local sprinting = sprintHeld and moving and not exhausted and base > 0
		if sprinting and not player:GetAttribute("InfiniteStamina") then -- 🏃 пропуск: бег без конца
			stamina = math.max(0, stamina - Config.StaminaDrain * dt)
		else
			stamina = math.min(Config.StaminaMax, stamina + Config.StaminaRegen * dt)
		end
		local speed = base
		if sprinting then
			speed = base * mult
		end
		if player:GetAttribute("LocalFreeze") then
			speed = 0
		end
		hum.WalkSpeed = speed
	end

	-- смена состояния игры
	if state ~= lastState then
		if state == "Intro" then
			results.Visible = false
			shop.Visible = false
			showRoleCard()
		elseif state == "Playing" then
			countdown.Text = L("chaos_go")
			countdown.Visible = true
			popIn(countdown)
			task.delay(1.2, function()
				if ReplicatedStorage:GetAttribute("State") == "Playing" then
					countdown.Visible = false
				end
			end)
			roleCard.Visible = false
		elseif state == "Lobby" then
			results.Visible = false
			countdown.Visible = false
			roleCard.Visible = false
		end
		lastState = state
	end
	if state == "Intro" and t ~= lastTime then
		countdown.Text = tostring(t)
		countdown.Visible = true
		popIn(countdown)
	end
	lastTime = t

	-- таймер и хаос
	if state == "Lobby" then
		if t > 0 then
			statusLabel.Text = L("start_in", t)
		else
			statusLabel.Text = L("waiting")
		end
	elseif state == "Intro" then
		statusLabel.Text = activeMapName()
	elseif state == "Playing" then
		statusLabel.Text = "⏱ " .. fmtTime(t)
		if t <= 30 then
			statusLabel.TextColor3 = RED
		else
			statusLabel.TextColor3 = WHITE
		end
	else
		statusLabel.Text = L("round_over")
		resNext.Text = L("next_round", t)
	end
	local chaos = ReplicatedStorage:GetAttribute("Chaos") or 0
	local frac = math.clamp(chaos / Config.ChaosToWin, 0, 1)
	chaosFill.Size = UDim2.fromScale(frac, 1)
	if chaos >= Config.AlarmChaos and state == "Playing" then
		chaosText.Text = L("alarm_bar", math.floor(frac * 100))
		local pulse = (math.sin(os.clock() * 8) + 1) / 2
		topStroke.Color = Color3.fromRGB(255, 60 + 100 * pulse, 60)
		topStroke.Transparency = 0.1
	else
		chaosText.Text = L("chaos_bar", math.floor(frac * 100))
		topStroke.Color = Color3.fromRGB(255, 200, 120)
		topStroke.Transparency = 0.4
	end
	chaosBg.Visible = state ~= "Lobby"
	lobbyBar.Visible = state == "Lobby" and not shop.Visible
	if state ~= "Lobby" then
		shop.Visible = false
	end
	coinsLabel.Text = "🧀 " .. (player:GetAttribute("Coins") or 0)
	levelLabel.Text = "⭐ " .. (player:GetAttribute("Level") or 1)
	xpFill.Size = UDim2.fromScale(math.clamp((player:GetAttribute("XP") or 0) / math.max(1, player:GetAttribute("XPNeed") or 100), 0, 1), 1)
	local ev = ReplicatedStorage:GetAttribute("Event") or ""
	eventPill.Visible = ev ~= "" and (state == "Intro" or state == "Playing")
	if ev ~= "" then
		eventLabel.Text = L("ev_" .. ev)
	end

	-- роль
	if r == "Rat" then
		if caught then
			roleLabel.Text = L("role_caught")
			hintLabel.Text = L("hint_caught")
		elseif player:GetAttribute("Stunned") then
			roleLabel.Text = L("role_stunned")
			hintLabel.Text = L("hint_stunned")
		else
			roleLabel.Text = L("role_rat")
			hintLabel.Text = L("hint_rat")
		end
	elseif r == "Chef" then
		roleLabel.Text = L("role_chef")
		hintLabel.Text = L("hint_chef")
	else
		roleLabel.Text = L("role_lobby")
		hintLabel.Text = L("hint_lobby")
	end
	-- надписи, которые зависят только от языка
	hungerCaption.Text = L("hunger")
	staminaCaption.Text = L("stamina")
	shopButton.Text = L("shop_main")
	codesButton.Text = L("codes_button")
	inviteButton.Text = L("invite_button")
	codesTitle.Text = L("codes_title")
	codesHint.Text = L("codes_hint")
	friendPill.Visible = player:GetAttribute("FriendBonus") == true
	friendLabel.Text = L("friend_bonus")
	questsPanel.Visible = (state == "Lobby" or state == "Ended") and (player:GetAttribute("Quests") or "") ~= "" and not shop.Visible
	if state ~= "Lobby" then
		codesPanel.Visible = false
	end
	emoteButton.Visible = r == "Rat" and not caught
	refreshChefButton()
	hungerBg.Visible = r == "Rat"
	staminaBg.Visible = r == "Rat" or r == "Chef"
	hungerFill.Size = UDim2.fromScale((player:GetAttribute("Hunger") or Config.HungerMax) / Config.HungerMax, 1)
	staminaFill.Size = UDim2.fromScale(stamina / Config.StaminaMax, 1)
	touchBar.Visible = UserInputService.TouchEnabled and (r == "Rat" or r == "Chef")
	squeakButton.Visible = r == "Rat"
	tasksPanel.Visible = showTasks and (r == "Rat" or r == "Chef") and state == "Playing"

	-- способность класса
	local cls = Config.getClass(player:GetAttribute("Class") or "normal") or Config.Classes[1]
	local hasAbility = r == "Rat" and cls.Ability ~= nil and state == "Playing" and not caught
	abilityPill.Visible = hasAbility
	abilityButton.Visible = hasAbility
	if hasAbility then
		local left = abilityReadyAt - os.clock()
		local abilityName = L("ability_" .. cls.Ability)
		if left > 0 then
			abilityLabel.Text = ("⏳ %d • %s"):format(math.ceil(left), abilityName)
			abilityLabel.TextColor3 = Color3.fromRGB(170, 160, 180)
			abilityButton.Text = tostring(math.ceil(left))
		else
			abilityLabel.Text = "F • " .. abilityName
			abilityLabel.TextColor3 = Color3.fromRGB(150, 220, 255)
			abilityButton.Text = cls.Icon
		end
	end

	-- сбежать из клетки за Robux
	escapeButton.Visible = r == "Rat" and caught and state == "Playing" and escapeProduct ~= nil
	if escapeButton.Visible then
		escapeButton.Text = L("escape_btn", escapeProduct.Price)
	end

	-- «Как играть» в первом раунде
	local firstRound = not player:GetAttribute("TutorialDone")
	local showTut = firstRound and state == "Playing" and (r == "Rat" or r == "Chef") and t > Config.RoundTime - 35
	tutorial.Visible = showTut
	if showTut then
		local p = (r == "Rat") and "tut_rat" or "tut_chef"
		tutorialLabel.Text = ("<b>%s</b>\n%s\n%s\n%s\n%s"):format(L("tut_title"), L(p .. "1"), L(p .. "2"), L(p .. "3"), L(p .. "4"))
	end

	accum = accum + dt
	if accum >= 0.5 then
		accum = 0
		refreshPrompts()
		refreshTasks()
		refreshVotes()
		refreshQuests()
		if shop.Visible then
			refreshShop()
		end
		-- стрелка к ближайшему заданию: крысе — что сломать, повару — что починить
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local target, best = nil, math.huge
		if root and state == "Playing" and ((r == "Rat" and not caught) or r == "Chef") then
			for _, st in ipairs(Config.taggedInMap("Sabotage")) do
				local broken = st:GetAttribute("Broken") == true
				if (r == "Rat" and not broken) or (r == "Chef" and broken) then
					local d = (st.Position - root.Position).Magnitude
					if d < best then
						target, best = st, d
					end
				end
			end
		end
		marker.Enabled = target ~= nil and best > 8
		if target then
			marker.Adornee = target
			local icon = (r == "Chef") and "🔧" or "💥"
			markerLabel.Text = ("%s %s\n⬇ %s"):format(icon, Locale.taskName(lang(), target), L("marker_dist", math.floor(best)))
			markerLabel.TextColor3 = (r == "Chef") and Color3.fromRGB(255, 120, 110) or YELLOW
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Effects (LocalScript) — StarterPlayer > StarterPlayerScripts
-- Всё, что делает игру живой: анимация крыс, крутящийся сыр, мерцающие свечи,
-- тревога, сердцебиение рядом с поваром, шаги повара, взрывы конфетти,
-- тряска камеры, писк "Пи-пи!", звуки и музыка.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))
local fxEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FX")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local S = Config.Sounds

-- ===== Звуки =====
local function playAt(soundId, position, volume, speed)
	if not soundId or soundId == "" then
		return
	end
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(position)
	holder.Parent = workspace
	local s = Instance.new("Sound")
	s.SoundId = soundId
	s.Volume = volume or 0.8
	s.PlaybackSpeed = speed or 1
	s.RollOffMaxDistance = 90
	s.Parent = holder
	s:Play()
	Debris:AddItem(holder, 4)
end

local function playUI(soundId, volume, speed)
	if not soundId or soundId == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = soundId
	s.Volume = volume or 0.6
	s.PlaybackSpeed = speed or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

-- ===== Частицы =====
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 110)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)),
})

local function burst(position, colors, count, speed, size)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.5, 0.5, 0.5)
	holder.CFrame = CFrame.new(position)
	holder.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = colors
	e.LightEmission = 0.6
	e.Size = NumberSequence.new(size or 0.35, 0)
	e.Lifetime = NumberRange.new(0.8, 1.5)
	e.Speed = NumberRange.new(speed or 12, (speed or 12) * 1.6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -25, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Rate = 0
	e.Parent = holder
	e:Emit(count or 40)
	Debris:AddItem(holder, 3)
end

-- ===== Тряска камеры =====
local shakeTime = 0
local shakePower = 0
local function shake(power, duration)
	if power > shakePower or shakeTime <= 0 then
		shakePower = power
	end
	shakeTime = math.max(shakeTime, duration)
end

local function distanceToMe(position)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

-- ===== Писк "Пи-пи!" =====
local function squeakBubble(character)
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(110, 44)
	bb.StudsOffset = Vector3.new(0, 2.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	bb.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.new(1, 1, 1)
	label.TextColor3 = Color3.fromRGB(40, 30, 40)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = Locale.forPlayer(player, "squeak")
	label.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = label
	TweenService:Create(bb, TweenInfo.new(1.4), { StudsOffset = Vector3.new(0, 3.6, 0) }):Play()
	Debris:AddItem(bb, 1.5)
	playAt(S.Squeak, head.Position, 0.7, 2.2 + math.random() * 0.8)
end

-- ===== События от сервера =====
fxEvent.OnClientEvent:Connect(function(kind, a, b)
	if kind == "sabotage" then
		burst(a, RAINBOW, 50, 14, 0.4)
		playAt(S.Sabotage, a, 0.9, 1)
		if distanceToMe(a) < 35 then
			shake(0.5, 0.4)
		end
	elseif kind == "caught" then
		burst(a, ColorSequence.new(Color3.fromRGB(255, 255, 255)), 35, 8, 0.6)
		playAt(S.Catch, a, 1, 0.9)
		if distanceToMe(a) < 10 then
			shake(0.8, 0.5)
		end
	elseif kind == "swing" then
		playAt(S.Swing, a, 0.7, 1)
	elseif kind == "trap" then
		burst(a, ColorSequence.new(Color3.fromRGB(255, 200, 80)), 25, 10, 0.3)
		playAt(S.TrapSnap, a, 1, 1)
		if distanceToMe(a) < 12 then
			shake(0.7, 0.4)
		end
	elseif kind == "repair" then
		burst(a, ColorSequence.new(Color3.fromRGB(110, 190, 255)), 20, 6, 0.25)
	elseif kind == "rescue" then
		burst(a, ColorSequence.new(Color3.fromRGB(120, 255, 140)), 40, 10, 0.35)
		playAt(S.Rescue, a, 1, 1.2)
	elseif kind == "squeak" then
		squeakBubble(a)
	elseif kind == "eat" then
		burst(a, ColorSequence.new(Color3.fromRGB(255, 210, 70)), 15, 5, 0.25)
		playUI(S.Coin, 0.4, 1.6)
	elseif kind == "coins" then
		playUI(S.Coin, 0.5, 1.3)
	elseif kind == "hole" then
		burst(a, ColorSequence.new(Color3.fromRGB(80, 70, 60)), 15, 5, 0.3)
	elseif kind == "levelup" then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			burst(root.Position + Vector3.new(0, 3, 0), RAINBOW, 90, 18, 0.45)
		end
		playUI(S.Victory, 0.8, 1.1)
		shake(0.3, 0.4)
	elseif kind == "ability" and typeof(a) == "Instance" then
		local root = a:FindFirstChild("HumanoidRootPart")
		if root then
			local colors = {
				Dash = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 180, 40)),
				Armor = ColorSequence.new(Color3.fromRGB(150, 220, 255), Color3.fromRGB(60, 140, 255)),
				Invisible = ColorSequence.new(Color3.fromRGB(200, 160, 255), Color3.fromRGB(120, 80, 200)),
			}
			burst(root.Position, colors[b] or RAINBOW, 40, 10, 0.4)
			playAt(S.Rescue, root.Position, 0.6, 1.6)
		end
	elseif kind == "purchase" then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			burst(root.Position + Vector3.new(0, 3, 0), ColorSequence.new(Color3.fromRGB(255, 215, 60), Color3.fromRGB(255, 255, 200)), 80, 16, 0.45)
		end
		playUI(S.Victory, 0.7, 1.2)
	elseif kind == "results" and type(a) == "table" then
		if a.won then
			playUI(S.Victory, 0.8, 1)
		end
	end
end)

-- ===== Виньетка (края экрана) для тревоги и сердцебиения =====
local fxGui = Instance.new("ScreenGui")
fxGui.Name = "FXGui"
fxGui.ResetOnSpawn = false
fxGui.IgnoreGuiInset = true
fxGui.DisplayOrder = -1
fxGui.Parent = playerGui

local edges = {}
local function edge(anchor, pos, size, rotation)
	local f = Instance.new("Frame")
	f.AnchorPoint = anchor
	f.Position = pos
	f.Size = size
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	f.BackgroundTransparency = 0
	f.Parent = fxGui
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	g.Parent = f
	table.insert(edges, { frame = f, gradient = g })
end
edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.25), 90)
edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.25), -90)
edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.2, 1), 0)
edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.2, 1), 180)

local function setVignette(strength)
	strength = math.clamp(strength, 0, 1)
	for _, e in ipairs(edges) do
		e.frame.Visible = strength > 0.01
		e.gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1 - strength * 0.75),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
end
setVignette(0)

-- ===== Музыка =====
local music = {}
local function track(id)
	if not id or id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	return s
end
music.Lobby = track(S.MusicLobby)
music.Round = track(S.MusicRound)
music.Alarm = track(S.MusicAlarm)

local heartbeatSound = nil
if S.Heartbeat and S.Heartbeat ~= "" then
	heartbeatSound = Instance.new("Sound")
	heartbeatSound.SoundId = S.Heartbeat
	heartbeatSound.Looped = true
	heartbeatSound.Volume = 0
	heartbeatSound.Parent = SoundService
	heartbeatSound:Play()
end

-- ===== Анимация крыс =====
local rats = {} -- [модель] = данные

local function setupRat(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local data = { motors = {}, phase = 0 }
	local function grab(parent, name)
		local m = parent and parent:FindFirstChild(name)
		if m and m:IsA("Motor6D") then
			data.motors[name] = { motor = m, base = m.C0 }
		end
	end
	grab(root, "BodyMotor")
	grab(root, "HeadMotor")
	grab(root, "Tail1Motor")
	grab(model:FindFirstChild("Tail1"), "Tail2Motor")
	data.feet = {}
	for _, m in ipairs(root:GetChildren()) do
		if m.Name == "FootMotor" and m:IsA("Motor6D") then
			table.insert(data.feet, { motor = m, base = m.C0, phase = m:GetAttribute("Phase") or 0 })
		end
	end
	data.root = root
	data.seed = math.random() * 10
	rats[model] = data
	return data
end

local function animateRat(model, data, dt, t)
	local root = data.root
	local vel = root.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local moving = math.min(speed / 14, 1.6)
	data.phase = data.phase + dt * (4 + speed * 0.9)
	local p = data.phase
	local s = t + data.seed

	local body = data.motors.BodyMotor
	if body then
		local bob = math.abs(math.sin(p)) * 0.12 * moving
		body.motor.C0 = body.base * CFrame.new(0, bob, 0) * CFrame.Angles(math.sin(p) * 0.06 * moving, 0, math.sin(p * 0.5) * 0.04 * moving)
	end
	local head = data.motors.HeadMotor
	if head then
		local sniff = math.sin(s * 9) * 0.03 * (1 - math.min(moving, 1))
		head.motor.C0 = head.base * CFrame.new(0, math.sin(p) * 0.05 * moving + sniff, 0) * CFrame.Angles(math.sin(s * 1.3) * 0.08, math.sin(s * 0.7) * 0.25 * (1 - math.min(moving, 1)), 0)
	end
	local tail1 = data.motors.Tail1Motor
	if tail1 then
		tail1.motor.C0 = tail1.base * CFrame.Angles(0, math.sin(s * 3) * 0.35 + math.sin(p) * 0.25 * moving, 0)
	end
	local tail2 = data.motors.Tail2Motor
	if tail2 then
		tail2.motor.C0 = tail2.base * CFrame.Angles(math.sin(s * 2) * 0.15, math.sin(s * 3 + 1) * 0.5, 0)
	end
	for _, foot in ipairs(data.feet) do
		local fp = p + foot.phase
		foot.motor.C0 = foot.base * CFrame.new(0, math.max(0, math.sin(fp)) * 0.2 * math.min(moving, 1), math.cos(fp) * 0.3 * math.min(moving, 1))
	end

	-- 💃 эмоция: поворачиваем всю крысу вокруг центра
	local owner = Players:GetPlayerFromCharacter(model)
	local emote = owner and owner:GetAttribute("Emote")
	if data.discoLight and emote ~= "disco" then
		data.discoLight.Enabled = false
	end
	if not emote then
		data.emoteN = nil
		return
	end
	local n = owner:GetAttribute("EmoteN")
	if data.emoteN ~= n then
		data.emoteN = n
		data.emoteStart = t
	end
	local u = t - data.emoteStart
	local E
	if emote == "dance" then
		E = CFrame.new(0, math.abs(math.sin(u * 8)) * 0.5, 0) * CFrame.Angles(0, math.sin(u * 4) * 0.7, math.sin(u * 8) * 0.18)
	elseif emote == "flip" then
		local k = math.clamp(u / 1.0, 0, 1)
		E = CFrame.new(0, math.sin(k * math.pi) * 2.8, 0) * CFrame.Angles(-k * 2 * math.pi, 0, 0)
	elseif emote == "wave" then
		local k = math.clamp(u / 0.3, 0, 1)
		E = CFrame.new(0, 0.7 * k, 0.5 * k) * CFrame.Angles(0.95 * k, 0, 0)
	elseif emote == "dead" then
		local k = math.clamp(u / 0.35, 0, 1)
		E = CFrame.new(0, 0.15 * k, 0) * CFrame.Angles(0, 0, math.pi * k)
	elseif emote == "breakdance" then
		-- ложится на спину и крутится волчком, как брейкер
		local k = math.clamp(u / 0.3, 0, 1)
		E = CFrame.new(0, 0.4 * k, 0) * CFrame.Angles(0, u * 14 * k, 0) * CFrame.Angles(0, 0, math.pi * k)
	elseif emote == "disco" then
		-- 🪩 диско: качается влево-вправо, поворачивается на каждый такт, лапка вверх-вниз
		local beat = math.floor(u * 2) % 2 == 0 and 1 or -1
		E = CFrame.new(math.sin(u * 4) * 0.35, math.abs(math.sin(u * 8)) * 0.35, 0) * CFrame.Angles(0, beat * 0.45, math.sin(u * 4) * 0.22)
		-- разноцветный свет вокруг крысы
		local root = model:FindFirstChild("HumanoidRootPart")
		if root then
			if not data.discoLight or data.discoLight.Parent ~= root then
				data.discoLight = Instance.new("PointLight")
				data.discoLight.Range = 14
				data.discoLight.Brightness = 3
				data.discoLight.Parent = root
			end
			data.discoLight.Enabled = true
			data.discoLight.Color = Color3.fromHSV((u * 0.9) % 1, 1, 1)
		end
	elseif emote == "worm" then
		-- 🐛 червяк: ложится и волной ползёт вперёд
		local k = math.clamp(u / 0.3, 0, 1)
		E = CFrame.new(0, -0.15 * k + math.max(0, math.sin(u * 7)) * 0.45, -math.sin(u * 7) * 0.2) * CFrame.Angles(math.sin(u * 7) * 0.35 * k, 0, 0)
	else
		return
	end
	-- у «червяка» голова и хвост догоняют волну
	local wave = {}
	if emote == "worm" then
		wave.HeadMotor = CFrame.Angles(math.sin(u * 7 - 1.2) * 0.45, 0, 0)
		wave.Tail1Motor = CFrame.Angles(math.sin(u * 7 + 1.2) * 0.6, 0, 0)
	end
	for _, name in ipairs({ "BodyMotor", "HeadMotor", "Tail1Motor" }) do
		local m = data.motors[name]
		if m then
			m.motor.C0 = E * m.motor.C0 * (wave[name] or CFrame.new())
		end
	end
	for i, foot in ipairs(data.feet) do
		local extra = CFrame.new()
		if emote == "wave" and i == 1 then
			extra = CFrame.new(0, 0.6 + math.sin(u * 14) * 0.3, -0.3) -- машет лапкой
		elseif emote == "dead" then
			extra = CFrame.new(0, math.sin(u * 20 + i) * 0.08, 0) -- дёргает лапками
		elseif emote == "breakdance" then
			extra = CFrame.new(0, 0.3 + math.sin(u * 18 + i * 1.6) * 0.35, 0) -- дрыгает лапками в воздухе
		elseif emote == "disco" and i <= 2 then
			-- передние лапки по очереди тычут в небо
			local up = (math.floor(u * 2) % 2 == i - 1) and 1 or 0
			extra = CFrame.new(0, up * (0.7 + math.sin(u * 16) * 0.15), -0.35 * up)
		elseif emote == "worm" then
			extra = CFrame.new(0, 0.25, 0) -- лапки прижаты
		end
		foot.motor.C0 = E * foot.motor.C0 * extra
	end
end

-- ===== Прочее =====
local cheeseBase = {}
local flickerBase = {}
local chefSteps = {}

local function findChefs()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Role") == "Chef" and p.Character then
			table.insert(list, p.Character)
		end
	end
	local npc = workspace:FindFirstChild("ChefNPC")
	if npc then
		table.insert(list, npc)
	end
	return list
end

local function ensureRatVision(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and not root:FindFirstChild("RatVision") then
		local l = Instance.new("PointLight")
		l.Name = "RatVision"
		l.Range = 11
		l.Brightness = 0.7
		l.Color = Color3.fromRGB(200, 210, 255)
		l.Parent = root
	end
end

local function fadeMusic(s, target, dt)
	if s then
		s.Volume = s.Volume + (target - s.Volume) * math.min(1, dt * 1.5)
	end
end

-- ===== ☀️ В лобби светлый день, в раунде ночь (меняется только на твоём экране) =====
-- Настройки дня и ночи — в Config.Lighting
local Lighting = game:GetService("Lighting")
local DAY, NIGHT = Config.Lighting.Day, Config.Lighting.Night
local dayMix = nil -- 0 = ночь, 1 = день

-- меняем свойство, только если оно и правда другое (так дешевле)
local function setNum(obj, prop, value)
	if math.abs(obj[prop] - value) > 0.001 then
		obj[prop] = value
	end
end
local function setColor(obj, prop, value)
	local c = obj[prop]
	if math.abs(c.R - value.R) + math.abs(c.G - value.G) + math.abs(c.B - value.B) > 0.003 then
		obj[prop] = value
	end
end

local function updateDaylight(dt, inLobby)
	local target = inLobby and 1 or 0
	if dayMix == nil then
		dayMix = target
	else
		dayMix = dayMix + (target - dayMix) * math.min(1, dt * 1.2) -- плавный рассвет/закат
		if math.abs(target - dayMix) < 0.003 then
			dayMix = target
		end
	end
	local k = dayMix
	local function mix(a, b)
		return a + (b - a) * k
	end
	-- ставим каждый кадр: даже если сервер прислал свет позже, у игрока всё равно будет правильно
	setNum(Lighting, "ClockTime", mix(NIGHT.ClockTime, DAY.ClockTime))
	setNum(Lighting, "Brightness", mix(NIGHT.Brightness, DAY.Brightness))
	setColor(Lighting, "Ambient", NIGHT.Ambient:Lerp(DAY.Ambient, k))
	setColor(Lighting, "OutdoorAmbient", NIGHT.OutdoorAmbient:Lerp(DAY.OutdoorAmbient, k))
	setNum(Lighting, "EnvironmentDiffuseScale", mix(NIGHT.EnvironmentDiffuseScale, DAY.EnvironmentDiffuseScale))
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		setNum(atm, "Density", mix(NIGHT.Density, DAY.Density))
		setNum(atm, "Haze", mix(NIGHT.Haze, DAY.Haze))
		setColor(atm, "Color", NIGHT.AtmColor:Lerp(DAY.AtmColor, k))
		setColor(atm, "Decay", NIGHT.Decay:Lerp(DAY.Decay, k))
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		setNum(bloom, "Intensity", mix(NIGHT.BloomIntensity, DAY.BloomIntensity))
		setNum(bloom, "Threshold", mix(NIGHT.BloomThreshold, DAY.BloomThreshold))
	end
end

-- 🎥 камера всегда смотрит на твоего персонажа (крысу или повара)
local function fixCamera(hum)
	if not hum then
		return
	end
	local ok, cam = pcall(function()
		return workspace.CurrentCamera
	end)
	if ok and cam and cam.CameraSubject ~= hum then
		cam.CameraSubject = hum
	end
end

-- ===== Каждый кадр =====
local camOffset = Vector3.new(0, 0, 0)

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local state = ReplicatedStorage:GetAttribute("State") or "Lobby"
	local chaos = ReplicatedStorage:GetAttribute("Chaos") or 0
	local alarm = state == "Playing" and chaos >= Config.AlarmChaos
	local role = player:GetAttribute("Role")
	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")

	updateDaylight(dt, role ~= "Rat" and role ~= "Chef")
	fixCamera(hum)

	-- крысы
	for _, model in ipairs(CollectionService:GetTagged("Rat")) do
		local data = rats[model] or setupRat(model)
		if data and model.Parent then
			animateRat(model, data, dt, t)
		end
	end
	for model in pairs(rats) do
		if not model.Parent then
			rats[model] = nil
		end
	end

	-- сыр крутится и светится
	for _, c in ipairs(CollectionService:GetTagged("Crumb")) do
		if not cheeseBase[c] then
			cheeseBase[c] = c.CFrame
		end
		c.CFrame = cheeseBase[c] * CFrame.new(0, math.sin(t * 2 + cheeseBase[c].Position.X) * 0.12, 0) * CFrame.Angles(0, t * 1.5, 0)
		local glow = c:FindFirstChildOfClass("PointLight")
		if glow then
			glow.Enabled = c.Transparency < 1
		end
	end

	-- золотой сыр крутится и подпрыгивает
	for _, g in ipairs(CollectionService:GetTagged("GoldenCheese")) do
		if not cheeseBase[g] then
			cheeseBase[g] = g.CFrame
		end
		g.CFrame = cheeseBase[g] * CFrame.new(0, 0.3 + math.sin(t * 3) * 0.3, 0) * CFrame.Angles(0, t * 3, 0)
	end

	-- свечи мерцают
	for _, l in ipairs(CollectionService:GetTagged("Flicker")) do
		if not flickerBase[l] then
			flickerBase[l] = l.Brightness
		end
		l.Brightness = flickerBase[l] * (0.8 + 0.2 * math.sin(t * 13 + flickerBase[l] * 7) * math.sin(t * 7.3))
	end

	-- оттенок события раунда (видно только тебе)
	local ev = ReplicatedStorage:GetAttribute("Event") or ""
	local cc = game:GetService("Lighting"):FindFirstChild("RatColor")
	if cc and cc:IsA("ColorCorrectionEffect") then
		local tint = Color3.fromRGB(255, 240, 225)
		if state == "Playing" and ev == "ChaosNight" then
			tint = Color3.fromRGB(255, 200, 190)
		elseif state == "Playing" and ev == "GoldenHour" then
			tint = Color3.fromRGB(255, 235, 170)
		elseif state == "Playing" and ev == "Turbo" then
			tint = Color3.fromRGB(220, 240, 255)
		end
		cc.TintColor = tint
	end

	-- тревога
	local pulse = (math.sin(t * 6) + 1) / 2
	for _, lamp in ipairs(CollectionService:GetTagged("AlarmLight")) do
		local light = lamp:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = alarm
			light.Brightness = 0.5 + 2.5 * pulse
		end
		if alarm then
			lamp.Material = Enum.Material.Neon
			lamp.Color = Color3.fromRGB(150 + 105 * pulse, 20, 20)
		else
			lamp.Material = Enum.Material.SmoothPlastic
			lamp.Color = Color3.fromRGB(90, 20, 20)
		end
	end

	-- шаги повара (слышно издалека, это страшно!)
	local chefs = findChefs()
	for _, chef in ipairs(chefs) do
		local root = chef:FindFirstChild("HumanoidRootPart")
		if root then
			local steps = chefSteps[chef]
			if not steps and S.Footsteps ~= "" then
				steps = Instance.new("Sound")
				steps.Name = "ChefSteps"
				steps.SoundId = S.Footsteps
				steps.Looped = true
				steps.Volume = 0.9
				steps.PlaybackSpeed = 0.85
				steps.RollOffMaxDistance = 70
				steps.Parent = root
				chefSteps[chef] = steps
			end
			if steps then
				local v = root.AssemblyLinearVelocity
				local movingChef = Vector3.new(v.X, 0, v.Z).Magnitude > 3
				if movingChef and not steps.IsPlaying then
					steps:Play()
				elseif not movingChef and steps.IsPlaying then
					steps:Stop()
				end
			end
		end
	end
	for chef in pairs(chefSteps) do
		if not chef.Parent then
			chefSteps[chef] = nil
		end
	end

	-- сердцебиение: повар рядом с моей крысой
	local heart = 0
	if role == "Rat" and myRoot and not player:GetAttribute("Caught") and state == "Playing" then
		ensureRatVision(character)
		local nearest = math.huge
		for _, chef in ipairs(chefs) do
			local root = chef:FindFirstChild("HumanoidRootPart")
			if root then
				nearest = math.min(nearest, (root.Position - myRoot.Position).Magnitude)
			end
		end
		if nearest < 32 then
			local closeness = 1 - nearest / 32
			local rate = 6 + closeness * 8
			local beat = math.max(0, math.sin(t * rate)) ^ 6
			heart = closeness * (0.35 + 0.65 * beat)
		end
	end
	if heartbeatSound then
		heartbeatSound.Volume = heart * 1.5
		heartbeatSound.PlaybackSpeed = 1 + heart * 0.5
	end
	local vignette = heart
	if alarm then
		vignette = math.max(vignette, 0.25 + 0.25 * pulse)
	end
	setVignette(vignette)

	-- музыка
	local wantLobby, wantRound, wantAlarm = 0, 0, 0
	if state == "Lobby" or state == "Ended" then
		wantLobby = 0.4
	elseif alarm then
		wantAlarm = 0.5
	else
		wantRound = 0.35
	end
	fadeMusic(music.Lobby, wantLobby, dt)
	fadeMusic(music.Round, wantRound, dt)
	fadeMusic(music.Alarm, wantAlarm, dt)

	-- тряска камеры
	if hum then
		if shakeTime > 0 then
			shakeTime = shakeTime - dt
			local p = shakePower * math.max(shakeTime, 0) * 2
			camOffset = Vector3.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
			hum.CameraOffset = camOffset
		elseif camOffset.Magnitude > 0 then
			camOffset = Vector3.new(0, 0, 0)
			hum.CameraOffset = camOffset
		end
	end
end)

-- звук отсчёта
local lastCount = nil
RunService.Heartbeat:Connect(function()
	local state = ReplicatedStorage:GetAttribute("State")
	local t = ReplicatedStorage:GetAttribute("TimeLeft")
	if state == "Intro" and t ~= lastCount then
		playUI(S.Countdown, 0.6, 1)
	end
	if state == "Intro" then
		lastCount = t
	else
		lastCount = nil
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">MiniGames</string><ProtectedString name="Source"><![CDATA[-- MiniGames (LocalScript) — StarterPlayer > StarterPlayerScripts
-- Мини-игры при поломке: 🔌 провода, 🦷 грызть, 🔢 пароль, ⏱ вовремя.
-- Пока крыса играет, она стоит на месте — повар может подкрасться!

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Locale = require(ReplicatedStorage:WaitForChild("Locale"))
local miniGameEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("MiniGame")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local FONT = Enum.Font.FredokaOne
local PANEL = Color3.fromRGB(28, 22, 34)
local WHITE = Color3.new(1, 1, 1)
local W, H = 460, 340

local function L(key, ...)
	return Locale.forPlayer(player, key, ...)
end

-- «Сильная» крыса ломает быстрее
local function power()
	local cls = Config.getClass(player:GetAttribute("Class") or "normal")
	return (cls and cls.SabotageMult) or 1
end

local gui = Instance.new("ScreenGui")
gui.Name = "MiniGames"
gui.ResetOnSpawn = false
gui.DisplayOrder = 5
gui.Parent = playerGui

local current = nil -- { station, kind, frame, started, done, onKey, onStep }

local function make(className, parent, props)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, r)
	make("UICorner", parent, { CornerRadius = UDim.new(0, r or 12) })
end

local function label(parent, props)
	local t = make("TextLabel", parent, props)
	t.BackgroundTransparency = 1
	t.Font = FONT
	t.TextScaled = true
	t.TextColor3 = props.TextColor3 or WHITE
	return t
end

local function btn(parent, props, color)
	local b = make("TextButton", parent, props)
	b.Font = FONT
	b.TextScaled = true
	b.BackgroundColor3 = color
	b.TextColor3 = props.TextColor3 or WHITE
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	corner(b, 10)
	return b
end

local function setFrozen(on)
	player:SetAttribute("LocalFreeze", on)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, not on)
	end
end

local function close(sendCancel)
	if not current then
		return
	end
	if sendCancel and not current.done then
		miniGameEvent:FireServer("cancel", current.station)
	end
	current.frame:Destroy()
	current = nil
	setFrozen(false)
end

local function finish(answer)
	if not current or current.done then
		return
	end
	local game_ = current
	game_.done = true
	game_.status.Text = L("mg_done")
	game_.status.TextColor3 = Color3.fromRGB(120, 255, 140)
	local minTime = Config.MiniGameMinTime[game_.kind] or 1
	local wait = math.max(0.3, minTime - (os.clock() - game_.started) + 0.1)
	task.delay(wait, function()
		if current == game_ then
			miniGameEvent:FireServer("done", game_.station, answer)
			close(false)
		end
	end)
end

local function flashWrong()
	if not current then
		return
	end
	local st = current.status
	st.Text = L("mg_wrong")
	st.TextColor3 = Color3.fromRGB(255, 110, 100)
	task.delay(0.6, function()
		if current and not current.done and current.status == st then
			st.Text = current.hint
			st.TextColor3 = Color3.fromRGB(220, 210, 225)
		end
	end)
end

local function newFrame(title, hint)
	local frame = make("Frame", gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	})
	corner(frame, 16)
	make("UIStroke", frame, { Color = Color3.fromRGB(255, 200, 120), Thickness = 3, Transparency = 0.2 })
	local scale = make("UIScale", frame, { Scale = 0.6 })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	label(frame, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -80, 0, 36), Text = title, TextXAlignment = Enum.TextXAlignment.Left })
	local x = btn(frame, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(40, 40), Text = "✕" }, Color3.fromRGB(220, 70, 70))
	x.Activated:Connect(function()
		close(true)
	end)
	local status = label(frame, {
		Position = UDim2.new(0, 16, 1, -40),
		Size = UDim2.new(1, -32, 0, 30),
		Text = hint,
		TextColor3 = Color3.fromRGB(220, 210, 225),
	})
	return frame, status
end

-- ===== 🔌 Провода =====
local WIRE_COLORS = {
	Color3.fromRGB(235, 60, 60),
	Color3.fromRGB(70, 120, 255),
	Color3.fromRGB(70, 200, 90),
	Color3.fromRGB(255, 210, 50),
}

local function buildWires(frame)
	local btnW, btnH = 90, 40
	local order = { 1, 2, 3, 4 }
	for i = #order, 2, -1 do
		local j = math.random(i)
		order[i], order[j] = order[j], order[i]
	end
	local connected = {}
	local count = 0
	local selected = nil
	local leftButtons = {}

	local function rowY(i)
		return 60 + (i - 1) * 56
	end

	local function drawWire(i, rightRow)
		local x1, y1 = 20 + btnW, rowY(i) + btnH / 2
		local x2, y2 = W - 20 - btnW, rowY(rightRow) + btnH / 2
		local dx, dy = x2 - x1, y2 - y1
		local wire = make("Frame", frame, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 8),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = WIRE_COLORS[i],
			BorderSizePixel = 0,
		})
		corner(wire, 4)
	end

	for i = 1, 4 do
		local b = btn(frame, { Position = UDim2.fromOffset(20, rowY(i)), Size = UDim2.fromOffset(btnW, btnH), Text = "" }, WIRE_COLORS[i])
		local st = make("UIStroke", b, { Color = WHITE, Thickness = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
		leftButtons[i] = st
		b.Activated:Connect(function()
			if connected[i] or not current or current.done then
				return
			end
			selected = i
			for k, s in ipairs(leftButtons) do
				if k == i then
					s.Thickness = 4
				else
					s.Thickness = 0
				end
			end
		end)
	end
	for row = 1, 4 do
		local colorIndex = order[row]
		local b = btn(frame, { Position = UDim2.fromOffset(W - 20 - btnW, rowY(row)), Size = UDim2.fromOffset(btnW, btnH), Text = "" }, WIRE_COLORS[colorIndex])
		b.Activated:Connect(function()
			if not selected or not current or current.done then
				return
			end
			if colorIndex == selected and not connected[selected] then
				connected[selected] = true
				count = count + 1
				drawWire(selected, row)
				leftButtons[selected].Thickness = 0
				selected = nil
				if count >= 4 then
					finish(nil)
				end
			else
				flashWrong()
			end
		end)
	end
end

-- ===== 🦷 Грызть =====
local function buildMash(frame)
	local progress = 0
	local barBg = make("Frame", frame, {
		Position = UDim2.fromOffset(30, 70),
		Size = UDim2.fromOffset(W - 60, 36),
		BackgroundColor3 = Color3.fromRGB(60, 50, 66),
		BorderSizePixel = 0,
	})
	corner(barBg, 10)
	local fill = make("Frame", barBg, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(255, 170, 60), BorderSizePixel = 0 })
	corner(fill, 10)
	local gnaw = btn(frame, {
		Name = "GnawButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.fromOffset(220, 130),
		Text = L("mg_gnaw"),
		TextColor3 = Color3.fromRGB(50, 30, 10),
	}, Color3.fromRGB(255, 220, 120))
	local scale = make("UIScale", gnaw, {})

	local function press()
		if not current or current.done then
			return
		end
		progress = math.min(100, progress + 7 * power())
		scale.Scale = 0.9
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
		if progress >= 100 then
			finish(nil)
		end
	end
	gnaw.Activated:Connect(press)
	current.onKey = press
	current.onStep = function(dt)
		if not current.done then
			progress = math.max(0, progress - 12 * dt)
		end
		fill.Size = UDim2.fromScale(progress / 100, 1)
	end
end

-- ===== 🔢 Пароль =====
local function buildCode(frame, code)
	local entered = ""
	local note = make("Frame", frame, {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.fromOffset(150, 120),
		BackgroundColor3 = Color3.fromRGB(255, 230, 110),
		BorderSizePixel = 0,
		Rotation = -6,
	})
	label(note, { Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 30), Text = L("mg_password"), TextColor3 = Color3.fromRGB(60, 40, 20) })
	label(note, { Name = "CodeText", Position = UDim2.fromOffset(8, 44), Size = UDim2.new(1, -16, 0, 56), Text = code or "????", TextColor3 = Color3.fromRGB(60, 40, 20) })
	local display = label(frame, {
		Position = UDim2.fromOffset(190, 56),
		Size = UDim2.fromOffset(250, 44),
		Text = "_ _ _ _",
	})
	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "⌫", "0", "" }
	local function refresh()
		local shown = {}
		for i = 1, 4 do
			local ch = string.sub(entered, i, i)
			if ch == "" then
				ch = "_"
			end
			table.insert(shown, ch)
		end
		display.Text = table.concat(shown, " ")
	end
	for i, key in ipairs(keys) do
		if key ~= "" then
			local col = (i - 1) % 3
			local row = math.floor((i - 1) / 3)
			local b = btn(frame, {
				Position = UDim2.fromOffset(200 + col * 78, 108 + row * 46),
				Size = UDim2.fromOffset(70, 40),
				Text = key,
			}, Color3.fromRGB(70, 60, 85))
			b.Activated:Connect(function()
				if not current or current.done then
					return
				end
				if key == "⌫" then
					entered = string.sub(entered, 1, -2)
				elseif #entered < 4 then
					entered = entered .. key
				end
				refresh()
				if #entered == 4 then
					if entered == code then
						finish(entered)
					else
						flashWrong()
						entered = ""
						task.delay(0.3, refresh)
					end
				end
			end)
		end
	end
end

-- ===== ⏱ Вовремя =====
local function buildTiming(frame)
	local barW = W - 60
	local hits = 0
	local needed = 3
	if power() > 1 then
		needed = 2
	end
	local pos = 0
	local dir = 1
	local speed = 0.9
	local zoneW = 80
	local zoneX = 0
	local barBg = make("Frame", frame, {
		Position = UDim2.fromOffset(30, 90),
		Size = UDim2.fromOffset(barW, 40),
		BackgroundColor3 = Color3.fromRGB(60, 50, 66),
		BorderSizePixel = 0,
	})
	corner(barBg, 8)
	local zone = make("Frame", barBg, { Size = UDim2.fromOffset(zoneW, 40), BackgroundColor3 = Color3.fromRGB(80, 210, 100), BorderSizePixel = 0 })
	corner(zone, 8)
	local needle = make("Frame", barBg, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 56),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	local counter = label(frame, { Position = UDim2.fromOffset(30, 150), Size = UDim2.new(1, -60, 0, 36), Text = "" })
	local stop = btn(frame, {
		Name = "StopButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 200),
		Size = UDim2.fromOffset(200, 70),
		Text = L("mg_stop"),
		TextColor3 = Color3.fromRGB(50, 30, 10),
	}, Color3.fromRGB(255, 220, 120))

	local function newZone()
		zoneX = math.random(0, barW - zoneW)
		zone.Position = UDim2.fromOffset(zoneX, 0)
		local dots = {}
		for i = 1, needed do
			if i <= hits then
				table.insert(dots, "🟢")
			else
				table.insert(dots, "⚪")
			end
		end
		counter.Text = table.concat(dots, " ")
	end
	newZone()

	local function press()
		if not current or current.done then
			return
		end
		local x = pos * barW
		if x >= zoneX and x <= zoneX + zoneW then
			hits = hits + 1
			speed = speed + 0.25
			if hits >= needed then
				newZone()
				finish(nil)
				return
			end
		else
			hits = math.max(0, hits - 1)
			flashWrong()
		end
		newZone()
	end
	stop.Activated:Connect(press)
	current.onKey = press
	current.onStep = function(dt)
		if current.done then
			return
		end
		pos = pos + dir * speed * dt
		if pos > 1 then
			pos = 1
			dir = -1
		elseif pos < 0 then
			pos = 0
			dir = 1
		end
		needle.Position = UDim2.fromOffset(pos * barW, 20)
	end
end

-- ===== Открыть мини-игру =====
local TITLES = {
	Wires = { "mg_wires", "mg_wires_hint" },
	Mash = { "mg_mash", "mg_mash_hint" },
	Code = { "mg_code", "mg_code_hint" },
	Timing = { "mg_timing", "mg_timing_hint" },
}

local function open(station, kind, data)
	close(true)
	local keys = TITLES[kind]
	if not keys then
		return
	end
	local info = { L(keys[1]), L(keys[2]) }
	local frame, status = newFrame(info[1], info[2])
	current = {
		station = station,
		kind = kind,
		frame = frame,
		status = status,
		hint = info[2],
		started = os.clock(),
		done = false,
	}
	setFrozen(true)
	if kind == "Wires" then
		buildWires(frame)
	elseif kind == "Mash" then
		buildMash(frame)
	elseif kind == "Code" then
		buildCode(frame, data and data.code)
	elseif kind == "Timing" then
		buildTiming(frame)
	end
end

miniGameEvent.OnClientEvent:Connect(function(action, station, kind, data)
	if action == "open" then
		open(station, kind, data)
	elseif action == "close" then
		close(false)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if not current or not current.onKey then
		return
	end
	if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
		current.onKey()
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if not current then
		return
	end
	if current.onStep then
		current.onStep(dt)
	end
	-- закрыть, если крысу поймали, раунд кончился или она ушла
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local station = current.station
	local bad = player:GetAttribute("Role") ~= "Rat"
		or player:GetAttribute("Caught")
		or ReplicatedStorage:GetAttribute("State") ~= "Playing"
		or not root
		or not station
		or not station.Parent
		or (station:GetAttribute("Broken") and not current.done)
		or (root.Position - station.Position).Magnitude > 16
	if bad then
		close(true)
	end
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
